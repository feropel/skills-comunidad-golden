          "settings": {
            "custom_liquid": "{% comment %}\n═══════════════════════════════════════════════════\n  📝 EDITAR AQUI — BARRA LOGISTICA horizontal compacta (mobile + desktop)\n═══════════════════════════════════════════════════\n{% endcomment %}\n{% assign HEADER_TITLE = \"Así llega tu pedido\" %}\n{% assign HEADER_SUB = \"Rápido, seguro y a tu puerta\" %}\n\n{% assign STEP_1_TITLE = \"Pedido\" %}\n{% assign STEP_1_TEXT = \"Mismo día\" %}\n\n{% assign STEP_2_TITLE = \"En camino\" %}\n{% assign STEP_2_TEXT = \"24 a 48 h\" %}\n\n{% assign STEP_3_TITLE = \"Entrega\" %}\n{% assign STEP_3_TEXT = \"3 a 7 días\" %}\n\n{% assign ACCENT_COLOR = \"var(--brand-primary)\" %}\n{% assign DARK_ACCENT = \"var(--brand-dark)\" %}\n{% assign BG_TINT = \"var(--brand-light)\" %}\n\n{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}\n<style>\n.gfs-ship{max-width:560px;margin:18px auto;box-sizing:border-box;padding:18px 14px;background:linear-gradient(135deg,{{ BG_TINT }} 0%,#ffffff 100%);border:1px solid rgba(var(--brand-primary-rgb),.15);border-radius:16px;box-shadow:0 8px 24px rgba(var(--brand-primary-rgb),.07);}\n.gfs-ship__head{text-align:center;margin-bottom:14px;}\n.gfs-ship__title{font-size:15px;font-weight:800;color:#1a1a1a;letter-spacing:.3px;margin:0 0 3px;text-transform:uppercase;}\n.gfs-ship__sub{font-size:12px;color:#777;font-style:italic;margin:0;}\n\n/* === HORIZONTAL en MOBILE (default) === */\n.gfs-ship__steps{display:flex;flex-direction:row;align-items:flex-start;justify-content:space-between;gap:0;position:relative;}\n.gfs-ship__step{flex:0 0 auto;display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;padding:0 4px;max-width:95px;transition:transform .3s cubic-bezier(.16,1,.3,1);}\n.gfs-ship__step:hover,.gfs-ship__step:active{transform:translateY(-3px);}\n.gfs-ship__icon{flex:0 0 44px;width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,{{ ACCENT_COLOR }},{{ DARK_ACCENT }});display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(var(--brand-primary-rgb),.4),inset 0 1px 0 rgba(255,255,255,.25);animation:gfsShipPulse 2.8s ease-in-out infinite;}\n.gfs-ship__step:nth-child(3) .gfs-ship__icon{animation-delay:.5s;}\n.gfs-ship__step:nth-child(5) .gfs-ship__icon{animation-delay:1s;}\n.gfs-ship__icon svg{width:22px;height:22px;}\n.gfs-ship__body{text-align:center;}\n.gfs-ship__h3{font-size:12px;font-weight:800;color:#1a1a1a;margin:0 0 2px;text-transform:uppercase;letter-spacing:.4px;line-height:1.15;}\n.gfs-ship__p{font-size:11.5px;color:#555;margin:0;line-height:1.3;font-weight:600;}\n.gfs-ship__line{flex:1 1 auto;height:3px;min-height:3px;width:auto;margin:20px 2px 0;border-radius:3px;background:linear-gradient(90deg,{{ ACCENT_COLOR }} 0%,rgba(var(--brand-primary-rgb),.25) 100%);position:relative;overflow:hidden;}\n.gfs-ship__line::after{content:\"\";position:absolute;top:0;left:-30%;width:30%;height:100%;background:linear-gradient(90deg,transparent,var(--brand-bright),transparent);animation:gfsShipFlowH 2.5s ease-in-out infinite;}\n\n@keyframes gfsShipPulse{0%,100%{transform:scale(1);box-shadow:0 4px 12px rgba(var(--brand-primary-rgb),.4),inset 0 1px 0 rgba(255,255,255,.25);}50%{transform:scale(1.07);box-shadow:0 8px 20px rgba(var(--brand-primary-rgb),.65),inset 0 1px 0 rgba(255,255,255,.3);}}\n@keyframes gfsShipFlowH{0%{left:-30%;opacity:0;}30%{opacity:1;}70%{opacity:1;}100%{left:100%;opacity:0;}}\n\n/* === DESKTOP: mismo layout pero más grande y espacioso === */\n@media(min-width:750px){\n  .gfs-ship{max-width:820px;padding:28px 24px;}\n  .gfs-ship__head{margin-bottom:22px;}\n  .gfs-ship__title{font-size:22px;}\n  .gfs-ship__sub{font-size:14.5px;}\n  .gfs-ship__step{max-width:180px;gap:12px;padding:0 6px;}\n  .gfs-ship__step:hover{transform:translateY(-6px);}\n  .gfs-ship__icon{flex:0 0 64px;width:64px;height:64px;}\n  .gfs-ship__icon svg{width:32px;height:32px;}\n  .gfs-ship__h3{font-size:15px;}\n  .gfs-ship__p{font-size:14px;}\n  .gfs-ship__line{height:4px;margin:30px 8px 0;}\n}\n</style>\n<div class=\"gfs-ship\">\n  <div class=\"gfs-ship__head\">\n    <p class=\"gfs-ship__title\">{{ HEADER_TITLE }}</p>\n    <p class=\"gfs-ship__sub\">{{ HEADER_SUB }}</p>\n  </div>\n  <div class=\"gfs-ship__steps\">\n    <div class=\"gfs-ship__step\">\n      <div class=\"gfs-ship__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 3h2l2.5 10h10l2-7H7\"/><circle cx=\"10\" cy=\"20\" r=\"1.5\" fill=\"#fff\" stroke=\"none\"/><circle cx=\"18\" cy=\"20\" r=\"1.5\" fill=\"#fff\" stroke=\"none\"/></svg></div>\n      <div class=\"gfs-ship__body\"><h3 class=\"gfs-ship__h3\">{{ STEP_1_TITLE }}</h3><p class=\"gfs-ship__p\">{{ STEP_1_TEXT }}</p></div>\n    </div>\n    <div class=\"gfs-ship__line\"></div>\n    <div class=\"gfs-ship__step\">\n      <div class=\"gfs-ship__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 7h13v7H3zM16 10h4l2 3v4h-6z\"/><circle cx=\"7\" cy=\"18\" r=\"2\" fill=\"#fff\" stroke=\"none\"/><circle cx=\"17\" cy=\"18\" r=\"2\" fill=\"#fff\" stroke=\"none\"/></svg></div>\n      <div class=\"gfs-ship__body\"><h3 class=\"gfs-ship__h3\">{{ STEP_2_TITLE }}</h3><p class=\"gfs-ship__p\">{{ STEP_2_TEXT }}</p></div>\n    </div>\n    <div class=\"gfs-ship__line\"></div>\n    <div class=\"gfs-ship__step\">\n      <div class=\"gfs-ship__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 11l9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1V11z\"/></svg></div>\n      <div class=\"gfs-ship__body\"><h3 class=\"gfs-ship__h3\">{{ STEP_3_TITLE }}</h3><p class=\"gfs-ship__p\">{{ STEP_3_TEXT }}</p></div>\n    </div>\n  </div>\n</div>"
          }
        },
        "description_CqV8EY": {
          "type": "description",
          "name": "11 DESCRIPCION DEL PRODUCTO",
          "settings": {
            "margin_top": 0,
            "margin_bottom": 0
          }
        },
        "custom_liquid_countdown": {
          "type": "custom_liquid",
          "name": "4 OFERTA TERMINA EN",
          "settings": {
            "custom_liquid": "{% comment %}\n========================\nTEXTOS EDITABLES\n========================\n{% endcomment %}\n{% assign LABEL_TEXT = \"⏰ La oferta termina en\" %}\n{% assign DURATION_MINUTES = 10 %}\n\n{% comment %}\n========================\nCOLORES\n========================\n{% endcomment %}\n{% assign ACCENT_COLOR = \"var(--brand-primary)\" %}\n{% assign DARK_ACCENT = \"var(--brand-dark)\" %}\n{% assign BG_COLOR = \"var(--brand-light)\" %}\n\n{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}\n<style>\n.gfs-cd{display:flex;align-items:center;justify-content:center;gap:8px;max-width:520px;margin:10px auto 0;padding:9px 14px;background:{{ BG_COLOR }};border:1px dashed {{ ACCENT_COLOR }};border-radius:10px;box-sizing:border-box;}\n.gfs-cd__label{font-size:14px;font-weight:600;color:#1a1a1a;}\n.gfs-cd__time{display:inline-block;min-width:54px;text-align:center;font-size:18px;font-weight:800;color:#fff;background:linear-gradient(135deg,{{ ACCENT_COLOR }},{{ DARK_ACCENT }});padding:4px 12px;border-radius:6px;letter-spacing:.5px;box-shadow:0 3px 10px rgba(var(--brand-primary-rgb),.4),inset 0 1px 0 rgba(255,255,255,.22);animation:gfsCdPulse 1.6s ease-in-out infinite;font-variant-numeric:tabular-nums;}\n@keyframes gfsCdPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.06)}}\n</style>\n<div class=\"gfs-cd\"><span class=\"gfs-cd__label\">{{ LABEL_TEXT }}</span><span class=\"gfs-cd__time\" id=\"gfs-cd-time\">{{ DURATION_MINUTES }}:00</span></div>\n<script>\n(function(){var D={{ DURATION_MINUTES }}*60*1000;var K='gfs_cd_end';var el=document.getElementById('gfs-cd-time');if(!el)return;var end=parseInt(localStorage.getItem(K)||'0',10);if(!end||end<Date.now()){end=Date.now()+D;localStorage.setItem(K,end);}function t(){var d=end-Date.now();if(d<=0){end=Date.now()+D;localStorage.setItem(K,end);d=D;}var m=Math.floor(d/60000);var s=Math.floor((d%60000)/1000);el.textContent=(m<10?'0':'')+m+':'+(s<10?'0':'')+s;}t();setInterval(t,1000);})();\n</script>"
          },
          "disabled": true
        },
        "custom_liquid_garantia": {
          "type": "custom_liquid",
          "name": "9 COMPRA SEGURA",
          "settings": {
            "custom_liquid": "{% comment %}\n========================\nTEXTOS EDITABLES  (MODE: \"contraentrega\" | \"anticipado\" | \"ambos\")\n========================\n{% endcomment %}\n{% assign MODE = \"ambos\" %}\n{% assign TITLE_PART1 = \"Compra\" %}\n{% assign TITLE_PART2 = \"100% Segura\" %}\n{% assign SEAL_EMOJI = \"🛡️\" %}\n\n{% assign ACCENT_COLOR = \"var(--brand-primary)\" %}\n{% assign DARK_ACCENT = \"var(--brand-dark)\" %}\n{% assign BG_COLOR = \"var(--brand-light)\" %}\n\n{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}\n<style>\n.gfs-guarantee{max-width:480px;margin:14px auto;background:{{ BG_COLOR }};border:1px solid rgba(var(--brand-primary-rgb),.3);border-radius:16px;padding:14px 16px;display:flex;align-items:center;gap:12px;box-sizing:border-box;text-align:left;box-shadow:0 8px 28px rgba(var(--brand-primary-rgb),.10),inset 0 1px 0 rgba(255,255,255,.5);}\n.gfs-guarantee__seal{flex:0 0 44px;width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,{{ ACCENT_COLOR }},{{ DARK_ACCENT }});display:flex;align-items:center;justify-content:center;font-size:22px;box-shadow:0 4px 12px rgba(var(--brand-primary-rgb),.4),inset 0 1px 0 rgba(255,255,255,.3);}\n.gfs-guarantee__title{font-size:14px;font-weight:800;color:#1a1a1a;margin:0 0 2px;text-transform:uppercase;letter-spacing:.3px;}\n.gfs-guarantee__title span{color:{{ DARK_ACCENT }};}\n.gfs-guarantee__text{font-size:13px;color:#444;line-height:1.4;margin:0;}\n.gfs-guarantee__text strong{color:#1a1a1a;}\n</style>\n<div class=\"gfs-guarantee\"><div class=\"gfs-guarantee__seal\">{{ SEAL_EMOJI }}</div><div><p class=\"gfs-guarantee__title\">{{ TITLE_PART1 }} <span>{{ TITLE_PART2 }}</span></p><p class=\"gfs-guarantee__text\">{%- if MODE == \"anticipado\" -%}<strong>Pago 100% seguro</strong> con tarjetas, PSE o transferencia. Producto sellado y original, entregado en perfecto estado.{%- elsif MODE == \"ambos\" -%}Elige cómo pagar: <strong>contra entrega</strong> al recibir o <strong>pago anticipado</strong> seguro online. Producto sellado y original.{%- else -%}<strong>Pagas al recibir</strong> en la puerta de tu casa — sin transferencias ni adelantos. Producto sellado y original.{%- endif -%}</p></div></div>"
          }
        },
        "custom_liquid_sticky": {
          "type": "custom_liquid",
          "name": "12 STICKY (boton fijo de compra)",
          "settings": {
            "custom_liquid": "{% comment %}\n========================\nTEXTOS EDITABLES\n========================\n{% endcomment %}\n{% assign BTN_TEXT = \"QUIERO MI PRODUCTO DEMO 🔥\" %}\n{% assign ACCENT_COLOR = \"var(--cta)\" %}\n{% assign BTN_HEIGHT = \"50px\" %}\n{% assign SHOW_AFTER_SCROLL = 500 %}\n\n{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}\n<style>\n#gfs-sticky-bar{position:fixed;left:0;right:0;bottom:0;z-index:9998;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 14px;background:#fff;border-top:1px solid #f0d6d5;box-shadow:0 -6px 24px rgba(0,0,0,.14);transform:translateY(115%);transition:transform .35s ease;box-sizing:border-box;}\n#gfs-sticky-bar.gfs-visible{transform:translateY(0);}\n#gfs-sticky-bar.gfs-visible #gfs-sticky-btn{animation-play-state:running;}\n.gfs-sticky-price{display:flex;flex-direction:column;line-height:1.1;flex:0 0 auto;}\n.gfs-sticky-price .gfs-now{font-size:19px;font-weight:800;color:#1a1a1a;}\n.gfs-sticky-price .gfs-was{font-size:13px;color:#9a9a9a;text-decoration:line-through;}\n#gfs-sticky-btn{flex:1 1 auto;max-width:380px;height:{{ BTN_HEIGHT }};border:1px solid #ffffff;border-radius:16px;background:{{ ACCENT_COLOR }};color:#fff;font-size:16px;font-weight:800;letter-spacing:.3px;cursor:pointer;box-shadow:0 6px 16px rgba(var(--cta-rgb),.45);animation:gfsStickyPulse 1.8s infinite;animation-play-state:paused;position:relative;overflow:hidden;}\n#gfs-sticky-btn span{position:relative;z-index:2;}\n#gfs-sticky-btn::before{content:\"\";position:absolute;top:0;left:-100%;width:60%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.45),transparent);animation:gfsStickyShine 3.5s infinite;pointer-events:none;z-index:1;}\n@keyframes gfsStickyShine{0%{left:-100%;}40%{left:140%;}100%{left:140%;}}\n#gfs-sticky-btn:active{transform:scale(.98);}\n@keyframes gfsStickyPulse{0%{transform:scale(1)}50%{transform:scale(1.03)}100%{transform:scale(1)}}\n@media(min-width:990px){#gfs-sticky-bar{justify-content:center;gap:24px;}#gfs-sticky-btn{flex:0 0 auto;width:340px;max-width:340px;}.gfs-sticky-price{align-items:flex-end;}} @media(max-width:749px){#gfs-sticky-bar{padding:8px 12px}.gfs-sticky-price .gfs-now{font-size:17px}#gfs-sticky-btn{height:48px;font-size:15px}}\n</style>\n<div id=\"gfs-sticky-bar\" aria-hidden=\"true\">\n  <div class=\"gfs-sticky-price\"><span class=\"gfs-now\">{{ product.selected_or_first_available_variant.price | money }}</span>{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}<span class=\"gfs-was\">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>{% endif %}</div>\n  <button id=\"gfs-sticky-btn\" type=\"button\"><span>{{ BTN_TEXT }}</span></button>\n</div>\n<script>(function(){var bar=document.getElementById('gfs-sticky-bar');var btn=document.getElementById('gfs-sticky-btn');if(!bar||!btn)return;document.body.style.paddingBottom='80px';try{var c=window.RELEASIT_BUTTON_CONFIG;if(c&&c.text){var sp=btn.querySelector('span');if(sp)sp.textContent=c.text;}}catch(e){}function onScroll(){if(window.scrollY>{{ SHOW_AFTER_SCROLL }}){bar.classList.add('gfs-visible');}else{bar.classList.remove('gfs-visible');}}window.addEventListener('scroll',onScroll,{passive:true});onScroll();btn.addEventListener('click',function(){var main=document.getElementById('custom-releasit-btn');if(main){main.click();}});})();</script>"
          }
        },
        "custom_liquid_paleta": {
          "type": "custom_liquid",
          "name": "0 PALETA & MARCA (centro de control)",
          "settings": {
            "custom_liquid": "{% comment %}\n═══════════════════════════════════════════════════════════\n  🎨 PALETA & MARCA — CENTRO DE CONTROL\n  ───────────────────────────────────────────────────────────\n  CAMBIA AQUI los colores y datos del producto.\n  Todos los demas bloques (futuros y los del nuevo sistema)\n  heredan estos valores automaticamente.\n\n  Para un PRODUCTO NUEVO:\n    1. Cambia BRAND_NAME → nombre del producto\n    2. Cambia BRAND_PRIMARY → color principal\n    3. Cambia BRAND_DARK   → version oscura del color\n    4. Cambia BRAND_BRIGHT → version brillante (acentos)\n    5. Cambia BRAND_LIGHT  → tint claro para fondos\n    6. Cambia WHATSAPP_NUMBER → tu numero de WhatsApp\n\n  Eso es TODO. La pagina entera se reinventa.\n═══════════════════════════════════════════════════════════\n{% endcomment %}\n\n{% assign BRAND_NAME       = \"PRODUCTO DEMO\" %}\n{% assign BRAND_PRIMARY    = \"#b82622\" %}\n{% assign BRAND_DARK       = \"#8e1c19\" %}\n{% assign BRAND_BRIGHT     = \"#ff5247\" %}\n{% assign BRAND_LIGHT      = \"#fff5f5\" %}\n{% assign BRAND_TEXT       = \"#ffffff\" %}\n{% assign BRAND_TEXT_HOVER = \"#ffe3e1\" %}\n\n{% assign WHATSAPP_NUMBER  = \"573001234567\" %}\n{% assign WHATSAPP_MESSAGE = \"Hola, quiero información de PRODUCTO DEMO\" %}\n\n{% assign REVIEW_COUNT     = \"150\" %}\n{% assign RATING_VALUE     = \"4.9\" %}\n\n{% comment %}\n  Componentes RGB (triplete para usar en rgba)\n  Calculalos en https://www.rgbtohex.net/hex-to-rgb si cambias los colores.\n{% endcomment %}\n{% assign BRAND_PRIMARY_RGB = \"184,38,34\" %}\n{% assign BRAND_DARK_RGB    = \"142,28,25\" %}\n{% assign BRAND_BRIGHT_RGB  = \"255,82,71\" %}\n\n{% comment %} CTA verde ganador FIJO (REGLA #2 — no cambiar salvo orden expresa) {% endcomment %}\n{% assign CTA_BG       = \"#1D9E06\" %}\n{% assign CTA_BG_DARK  = \"#157A04\" %}\n{% assign CTA_BG_RGB   = \"29,158,6\" %}\n\n{% comment %} Sello de versión de la skill (se actualiza al subir versión) {% endcomment %}\n{% assign GFS_VERSION  = \"G3.14\" %}\n{% assign GFS_DATE     = \"2026-07-01\" %}\n<!-- Generado con GOLDEN SHOPIFY {{ GFS_VERSION }} · {{ BRAND_NAME }} · {{ GFS_DATE }} -->\n\n{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}\n<style id=\"gfs-brand-tokens\">\n:root{\n  --brand-name: \"{{ BRAND_NAME }}\";\n  --brand-primary: {{ BRAND_PRIMARY }};\n  --brand-dark: {{ BRAND_DARK }};\n  --brand-bright: {{ BRAND_BRIGHT }};\n  --brand-light: {{ BRAND_LIGHT }};\n  --brand-text: {{ BRAND_TEXT }};\n  --brand-text-hover: {{ BRAND_TEXT_HOVER }};\n  --brand-primary-rgb: {{ BRAND_PRIMARY_RGB }};\n  --brand-dark-rgb: {{ BRAND_DARK_RGB }};\n  --brand-bright-rgb: {{ BRAND_BRIGHT_RGB }};\n  --cta: {{ CTA_BG }};\n  --cta-dark: {{ CTA_BG_DARK }};\n  --cta-rgb: {{ CTA_BG_RGB }};\n}\n.gfs-reviews,.gfs-faq,.gfs-manifesto,.gfs-steps,.gfs-why,.gfs-lad,.pe-pyramid{content-visibility:auto;contain-intrinsic-size:auto 600px;}\n</style>\n<style id=\"gfs-desktop-apple\">\n/* LAYOUT ESCRITORIO (PC) estilo Apple — capa centralizada y apagable, absorbida de un build real (PRODUCTO DEMO) en G2.1 */\n@media(min-width:990px){\n  .gfs-steps,.gfs-reviews,.gfs-faq,.gfs-why,.gfs-lad,.pe-pyramid{max-width:1140px !important;margin-left:auto !important;margin-right:auto !important;}\n  .gfs-steps__title,.gfs-reviews__title,.gfs-faq__title,.gfs-why__title,.gfs-lad__h{font-size:40px !important;letter-spacing:-.6px !important;}\n  .gfs-steps__sub,.gfs-reviews__count,.gfs-why__sub{font-size:16px !important;}\n  .gfs-lad{display:grid !important;grid-template-columns:repeat(2,1fr) !important;gap:22px !important;align-items:stretch !important;}\n  .gfs-lad__h{grid-column:1/-1 !important;margin-bottom:8px !important;}\n  .gfs-lad__row{margin-bottom:0 !important;height:100% !important;padding:26px 30px !important;}\n  .gfs-lad__t{font-size:22px !important;}\n  .gfs-lad__p{font-size:16px !important;}\n  .gfs-faq{max-width:920px !important;}\n  .gfs-faq__q{font-size:17px !important;padding:18px 24px !important;}\n  .gfs-faq__a p{font-size:15.5px !important;padding:0 24px 16px !important;}\n  .gfs-reviews__list .gfs-review{padding:24px 26px !important;}\n  .gfs-review__text{font-size:15.5px !important;line-height:1.6 !important;}\n  .gfs-guarantee{max-width:640px !important;}\n  .gfs-ship{max-width:920px !important;}\n  .gfs-cd,.mb-banner__box{max-width:640px !important;}\n  .gfs-mid-cta{max-width:560px !important;}\n  #gfs-cta-mid{font-size:18px !important;min-height:60px !important;}\n}\n@media(min-width:1280px){\n  .gfs-steps,.gfs-reviews,.gfs-why,.gfs-lad,.pe-pyramid{max-width:1240px !important;}\n}\n</style>\n<style id=\"gfs-cta-center\">\n/* Centra el texto de TODOS los CTA (Releasit, sticky, doble CTA y botón del cart drawer) — G2.2 */\n#custom-releasit-btn,#gfs-sticky-btn,#gfs-cta-mid{text-align:center !important;}\n#custom-releasit-btn span,#gfs-sticky-btn span,#gfs-cta-mid span{display:block;width:100%;text-align:center !important;line-height:1.2;transform:none !important;}\n._rsi-buy-now-button-cart,._rsi-modal-submit-button{text-align:center !important;justify-content:center !important;}\n</style>\n<style id=\"gfs-a11y\">\n/* Capa GLOBAL de accesibilidad (WCAG 2.2): foco visible en CTA/enlaces + respeto a reduced-motion en toda la pagina — G3.0 */\n#custom-releasit-btn:focus-visible,#gfs-sticky-btn:focus-visible,#gfs-cta-mid:focus-visible,#gfs-mani-cta:focus-visible,.wa-float:focus-visible,.gfs-faq__q:focus-visible,.gfs-lad a:focus-visible,.gfs-manifesto a:focus-visible{outline:3px solid var(--brand-dark,#8e1c19) !important;outline-offset:3px !important;border-radius:12px;}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.001ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important;}}\n</style>\n<script>\n/* === Globals para que TODOS los <script> que vienen despues lean de aqui === */\nwindow.GFS_BRAND = {\n  name:        {{ BRAND_NAME | json }},\n  primary:     {{ BRAND_PRIMARY | json }},\n  dark:        {{ BRAND_DARK | json }},\n  bright:      {{ BRAND_BRIGHT | json }},\n  light:       {{ BRAND_LIGHT | json }},\n  text:        {{ BRAND_TEXT | json }},\n  textHover:   {{ BRAND_TEXT_HOVER | json }},\n  whatsapp:    {{ WHATSAPP_NUMBER | json }},\n  whatsappMsg: {{ WHATSAPP_MESSAGE | json }},\n  reviewCount: {{ REVIEW_COUNT | json }},\n  ratingValue: {{ RATING_VALUE | json }}\n};\n</script>\n<script>\n/* MOTOR COD ROBUSTO gfsFireCOD — G3.2: [data-cod] dispara el boton Releasit correcto, evita el del modal y reintenta */\n(function(){if(window.gfsFireCOD)return;function inModal(el){return !!(el.closest&&el.closest('._rsi-cod-form-modal, ._rsi-modal-container'));}function inner(el){if(!el)return null;return (el.classList&&el.classList.contains('_rsi-buy-now-button'))?el:((el.querySelector&&el.querySelector('._rsi-buy-now-button'))||el);}function pick(){var sels=['._rsi-buy-now-button-product:not(._rsi-buy-now-button-product-floating)','#_rsi-buy-now-button-overwrite','._rsi-buy-now-button-product-floating','#_rsi-buy-now-button-floating','._rsi-buy-now-button'];for(var s=0;s<sels.length;s++){var n=document.querySelectorAll(sels[s]);for(var i=0;i<n.length;i++){if(!inModal(n[i]))return inner(n[i]);}}return null;}function fire(el){var o={bubbles:true,cancelable:true,view:window};try{el.dispatchEvent(new MouseEvent('mousedown',o));}catch(e){}try{el.dispatchEvent(new MouseEvent('mouseup',o));}catch(e){}try{el.click();}catch(e){}}var iv=null;window.gfsFireCOD=function(){if(iv){clearInterval(iv);iv=null;}var b=pick();if(b){fire(b);return true;}var k=0;iv=setInterval(function(){var x=pick();if(x){fire(x);clearInterval(iv);iv=null;}else if(++k>=80){clearInterval(iv);iv=null;}},200);return false;};document.addEventListener('click',function(e){var t=e.target&&e.target.closest?e.target.closest('[data-cod]'):null;if(t){e.preventDefault();window.gfsFireCOD();}},true);})();\n</script>"
          }
