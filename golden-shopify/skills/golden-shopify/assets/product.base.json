            "custom_liquid": "<script>\nwindow.PRICE_CONFIG = {\n  align: \"center\",\n\n  priceSize: \"30px\",\n  priceWeight: \"700\",\n  priceColor: \"#2E2A39\",\n\n  compareSize: \"20px\",\n  compareColor: \"#555\",\n  compareSpacing: \"12px\",\n\n  badgeText: \"Oferta\",\n  badgeBg: \"#F6C706\",\n  badgeColor: \"#FFFFFF\",\n  badgeSize: \"14px\",\n  badgeRadius: \"10px\",\n  badgePaddingY: \"4px\",\n  badgePaddingX: \"8px\",\n\n  savingTextPrefix: \"💸 Estás ahorrando\",\n  savingSize: \"15px\",\n  savingColor: \"#2E2A39\",\n  savingWeight: \"600\",\n  savingMarginTop: \"-10px\",\n\n  fontFamily: \"Montserrat, sans-serif\"\n};\n</script>\n\n<div class=\"custom-price-section\">\n  <div class=\"custom-price-wrapper\">\n    <span class=\"custom-price\">\n      {{ product.selected_or_first_available_variant.price | money }}\n    </span>\n\n    {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}\n      <span class=\"custom-compare-price\">\n        {{ product.selected_or_first_available_variant.compare_at_price | money }}\n      </span>\n      <span class=\"custom-badge\"></span>\n    {% endif %}\n  </div>\n\n  {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}\n    <div class=\"custom-saving\"></div>\n  {% endif %}\n</div>\n\n<style>\n.custom-price-section{\n  text-align:var(--align);\n  font-family:var(--ff);\n}\n.custom-price-wrapper{\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n}\n.custom-price{\n  font-size:var(--ps);\n  font-weight:var(--pw);\n  color:var(--pc);\n}\n.custom-compare-price{\n  font-size:var(--cs);\n  text-decoration:line-through;\n  color:var(--cc);\n  margin-left:var(--csp);\n}\n.custom-badge{\n  background:var(--bbg);\n  color:var(--btc);\n  font-size:var(--bs);\n  padding:var(--bpy) var(--bpx);\n  border-radius:var(--br);\n  margin-left:var(--csp);\n}\n.custom-saving{\n  margin-top:var(--smt);\n  font-size:var(--ss);\n  color:var(--sc);\n  font-weight:var(--sw);\n}\n</style>\n\n<script>\n(function(){\n  const c = window.PRICE_CONFIG;\n  const root = document.querySelector(\".custom-price-section\");\n  if(!root) return;\n\n  root.style.setProperty(\"--align\", c.align);\n  root.style.setProperty(\"--ff\", c.fontFamily);\n\n  root.style.setProperty(\"--ps\", c.priceSize);\n  root.style.setProperty(\"--pw\", c.priceWeight);\n  root.style.setProperty(\"--pc\", c.priceColor);\n\n  root.style.setProperty(\"--cs\", c.compareSize);\n  root.style.setProperty(\"--cc\", c.compareColor);\n  root.style.setProperty(\"--csp\", c.compareSpacing);\n\n  root.style.setProperty(\"--bbg\", c.badgeBg);\n  root.style.setProperty(\"--btc\", c.badgeColor);\n  root.style.setProperty(\"--bs\", c.badgeSize);\n  root.style.setProperty(\"--br\", c.badgeRadius);\n  root.style.setProperty(\"--bpy\", c.badgePaddingY);\n  root.style.setProperty(\"--bpx\", c.badgePaddingX);\n\n  root.style.setProperty(\"--ss\", c.savingSize);\n  root.style.setProperty(\"--sc\", c.savingColor);\n  root.style.setProperty(\"--sw\", c.savingWeight);\n  root.style.setProperty(\"--smt\", c.savingMarginTop);\n\n  const badge = root.querySelector(\".custom-badge\");\n  if(badge) badge.innerText = c.badgeText;\n\n  const saving = root.querySelector(\".custom-saving\");\n  if(saving){\n    saving.innerText = `${c.savingTextPrefix} {{ product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price | money }}`;\n  }\n})();\n</script>"
