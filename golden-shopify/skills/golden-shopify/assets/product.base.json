        "custom_liquid_propuesta": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% comment %}\n========================\nTEXTOS EDITABLES\n========================\n{% endcomment %}\n{% assign BADGE_TEXT = \"LO MÁS VENDIDO ⭐\" %}\n{% assign SUBTITLE_TEXT = \"CONFIANZA TOTAL\" %}\n\n{% comment %}\n========================\nCOLORES\n========================\n{% endcomment %}\n{% assign PRIMARY_COLOR = \"var(--brand-primary)\" %}\n{% assign PRIMARY_GRADIENT = \"linear-gradient(135deg, var(--brand-primary), var(--brand-primary))\" %}\n{% assign TEXT_GRAY = \"var(--brand-primary)\" %}\n{% assign WHITE = \"#ffffff\" %}\n\n{% comment %}\n========================\nTIPOGRAFÍA\n========================\n{% endcomment %}\n{% assign FONT_SIZE_DESKTOP = \"18px\" %}\n{% assign FONT_SIZE_MOBILE = \"15px\" %}\n{% assign SUBTITLE_SIZE_DESKTOP = \"14px\" %}\n{% assign SUBTITLE_SIZE_MOBILE = \"13px\" %}\n{% assign FONT_WEIGHT = \"800\" %}\n{% assign LINE_HEIGHT = \"1.1\" %}\n{% assign FONT_FAMILY = \"inherit\" %}\n\n{% comment %}\n========================\nMÁRGENES Y ESPACIADOS DESKTOP\n========================\n{% endcomment %}\n{% assign PADDING_Y_DESKTOP = \"8px\" %}\n{% assign PADDING_X_DESKTOP = \"22px\" %}\n{% assign BADGE_RADIUS = \"10px\" %}\n{% assign MARGIN_TOP = \"4px\" %}\n{% assign MARGIN_BOTTOM = \"6px\" %}\n\n{% comment %}\n========================\nMÁRGENES Y ESPACIADOS MOBILE\n========================\n{% endcomment %}\n{% assign PADDING_Y_MOBILE = \"7px\" %}\n{% assign PADDING_X_MOBILE = \"14px\" %}\n\n{% comment %}\n========================\nANIMACIÓN\n========================\n{% endcomment %}\n{% assign ANIMATION_SCALE = \"1.02\" %}\n{% assign ANIMATION_SPEED = \"2.2s\" %}\n\n<div class=\"mb-header-wrapper\">\n  <div class=\"mb-badge\">{{ BADGE_TEXT }}</div>\n  <div class=\"mb-subtitle\">{{ SUBTITLE_TEXT }}</div>\n</div>\n\n<style>\n@keyframes mbPulse{\n  0%{transform:scale(1);}\n  50%{transform:scale({{ ANIMATION_SCALE }});}\n  100%{transform:scale(1);}\n}\n\n.mb-header-wrapper{\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  gap:4px;\n  margin-top:{{ MARGIN_TOP }};\n  margin-bottom:{{ MARGIN_BOTTOM }};\n}\n\n.mb-badge{\n  background:{{ PRIMARY_GRADIENT }};\n  color:{{ WHITE }};\n  padding:{{ PADDING_Y_DESKTOP }} {{ PADDING_X_DESKTOP }};\n  font-size:{{ FONT_SIZE_DESKTOP }};\n  font-weight:{{ FONT_WEIGHT }};\n  font-family:{{ FONT_FAMILY }};\n  border-radius:{{ BADGE_RADIUS }};\n  text-transform:uppercase;\n  text-align:center;\n  line-height:{{ LINE_HEIGHT }};\n  letter-spacing:0.4px;\n  animation:mbPulse {{ ANIMATION_SPEED }} infinite ease-in-out;\n}\n\n.mb-subtitle{\n  color:{{ TEXT_GRAY }};\n  font-size:{{ SUBTITLE_SIZE_DESKTOP }};\n  text-align:center;\n  font-weight:500;\n  max-width:320px;\n  line-height:1.25;\n}\n\n/* ========================\n   MOBILE\n======================== */\n@media (max-width:749px){\n  .mb-badge{\n    font-size:{{ FONT_SIZE_MOBILE }};\n    padding:{{ PADDING_Y_MOBILE }} {{ PADDING_X_MOBILE }};\n  }\n  .mb-subtitle{\n    font-size:{{ SUBTITLE_SIZE_MOBILE }};\n    max-width:92%;\n  }\n}\n\n/* killer de animaciones removido (v1.15: las animaciones deben verse en móvil) */\n</style>\n\n"
          },
          "name": "1a HERO · PROPUESTA DE VALOR"
        },
        "custom_liquid_seo_cart": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% comment %}\n═══════════════════════════════════════════════════\n  📝 EDITAR AQUI — CARRITO CINEMATOGRÁFICO + SCHEMA SEO (por producto)\n═══════════════════════════════════════════════════\n{% endcomment %}\n{% assign CART_COLOR = \"var(--brand-primary)\" %}\n{% assign CART_COLOR_HOVER = \"var(--brand-dark)\" %}\n{% assign SCHEMA_RATING = \"4.9\" %}\n{% comment %} SCHEMA_REVIEWS: pon el NÚMERO REAL de reseñas para mostrar estrellas en Google. Déjalo \"\" (vacío) si aún no tienes un conteo real → no se renderiza aggregateRating (REGLA #3: no inventar). {% endcomment %}\n{% assign SCHEMA_REVIEWS = \"\" %}\n\n{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}\n<style>\n/* === CARRITO CINEMATOGRÁFICO === */\n.header__icon[href*=\"/cart\"],.header__icon--cart,header a[href*=\"/cart\"],[class*=\"cart-link\"],[class*=\"site-header__cart\"]{position:relative !important;display:inline-flex !important;align-items:center !important;justify-content:center !important;animation:gfsCartCinematic 8s ease-in-out infinite !important;transition:transform .35s cubic-bezier(.16,1,.3,1),filter .35s ease !important;}\n.header__icon[href*=\"/cart\"] svg,.header__icon--cart svg,header a[href*=\"/cart\"] svg,[class*=\"cart-link\"] svg,[class*=\"site-header__cart\"] svg{color:{{ CART_COLOR }} !important;fill:{{ CART_COLOR }} !important;transition:all .35s ease !important;}\n\n.header__icon[href*=\"/cart\"]:hover,.header__icon--cart:hover,header a[href*=\"/cart\"]:hover,[class*=\"cart-link\"]:hover,[class*=\"site-header__cart\"]:hover{transform:scale(1.25) !important;}\n.header__icon[href*=\"/cart\"]:hover svg,.header__icon--cart:hover svg,header a[href*=\"/cart\"]:hover svg,[class*=\"cart-link\"]:hover svg,[class*=\"site-header__cart\"]:hover svg{color:{{ CART_COLOR_HOVER }} !important;fill:{{ CART_COLOR_HOVER }} !important;}\n@keyframes gfsCartCinematic{0%,84%,100%{transform:scale(1) rotate(0);}86%{transform:scale(1.12) rotate(-15deg);}88%{transform:scale(1.18) rotate(14deg);}90%{transform:scale(1.15) rotate(-12deg);}92%{transform:scale(1.12) rotate(8deg);}94%{transform:scale(1.05) rotate(0);}}\n</style>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Product\",\n  \"name\": {{ product.title | json }},\n  \"image\": [{% for img in product.images limit:4 %}\"https:{{ img | image_url: width: 1200 }}\"{% unless forloop.last %},{% endunless %}{% endfor %}],\n  \"description\": {{ product.description | strip_html | truncate: 300 | json }},\n  \"brand\": { \"@type\": \"Brand\", \"name\": {{ shop.name | json }} },\n  {% if SCHEMA_REVIEWS != \"\" %}\"aggregateRating\": { \"@type\": \"AggregateRating\", \"ratingValue\": \"{{ SCHEMA_RATING }}\", \"reviewCount\": \"{{ SCHEMA_REVIEWS }}\", \"bestRating\": \"5\" },{% endif %}\n  \"offers\": {\n    \"@type\": \"Offer\",\n    \"url\": \"{{ shop.url }}{{ product.url }}\",\n    \"priceCurrency\": \"{{ cart.currency.iso_code }}\",\n    \"price\": \"{{ product.selected_or_first_available_variant.price }}\",\n    \"availability\": \"{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}\",\n    \"itemCondition\": \"https://schema.org/NewCondition\"\n  }\n}\n</script>\n\n"
          },
          "name": "1e SEO GOOGLE + carrito (JSON-LD invisible)"
        },
        "custom_liquid_footer_efx": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% comment %}\n═══════════════════════════════════════════════════\n  📝 EDITAR AQUI — FOOTER DEL TEMA (por producto)\n  Sobrescribe el color del footer solo en esta página\n═══════════════════════════════════════════════════\n{% endcomment %}\n{% assign FOOTER_BG = \"var(--brand-primary)\" %}\n{% assign FOOTER_TEXT = \"#ffffff\" %}\n{% assign FOOTER_LINK_HOVER = \"var(--brand-text-hover)\" %}\n\n{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}\n<style>\n.shopify-section-group-footer-group,\n.shopify-section-group-footer-group [class*=\"color-\"],\n.shopify-section-group-footer-group section,\n.shopify-section-group-footer-group .footer,\n.shopify-section-group-footer-group .footer__content-top,\n.shopify-section-group-footer-group .footer__content-bottom,\nfooter.footer,\nfooter.footer [class*=\"color-\"]{\n  background:{{ FOOTER_BG }} !important;\n  background-color:{{ FOOTER_BG }} !important;\n  background-image:none !important;\n}\n.shopify-section-group-footer-group,\n.shopify-section-group-footer-group p,\n.shopify-section-group-footer-group span,\n.shopify-section-group-footer-group a,\n.shopify-section-group-footer-group h1,\n.shopify-section-group-footer-group h2,\n.shopify-section-group-footer-group h3,\n.shopify-section-group-footer-group h4,\n.shopify-section-group-footer-group li,\n.shopify-section-group-footer-group small,\nfooter.footer,\nfooter.footer p,\nfooter.footer span,\nfooter.footer a,\nfooter.footer h1,\nfooter.footer h2,\nfooter.footer h3,\nfooter.footer h4,\nfooter.footer li,\nfooter.footer small{\n  color:{{ FOOTER_TEXT }} !important;\n}\n.shopify-section-group-footer-group a:hover,\nfooter.footer a:hover{\n  color:{{ FOOTER_LINK_HOVER }} !important;\n  opacity:.92;\n}\n.shopify-section-group-footer-group hr,\nfooter.footer hr,\n.shopify-section-group-footer-group [class*=\"border\"]{\n  border-color:rgba(255,255,255,.18) !important;\n}\n.shopify-section-group-footer-group svg,\nfooter.footer svg{\n  fill:{{ FOOTER_TEXT }} !important;\n}\n</style>\n\n"
