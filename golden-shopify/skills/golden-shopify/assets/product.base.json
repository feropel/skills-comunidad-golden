        "custom_liquid_LQjG4A": {
          "type": "custom_liquid",
          "name": "8 BOTON DE COMPRA",
          "settings": {
            "custom_liquid": "<script>\nwindow.RELEASIT_BUTTON_CONFIG = {\n  text: \"QUIERO MI PRODUCTO DEMO 🔥 \",\n\n  width: \"100%\",\n  height: \"58px\",\n\n  paddingY: \"14px\",\n  paddingX: \"20px\",\n  marginTop: \"12px\",\n  marginBottom: \"12px\",\n\n  bgColor: \"var(--cta)\",\n  bgColorHover: \"#347b77\",\n\n  textColor: \"#FFFFFF\",\n  fontSize: \"16px\",\n  fontWeight: \"700\",\n  letterSpacing: \"0.5px\",\n\n  borderWidth: \"1px\",\n  borderStyle: \"solid\",\n  borderColor: \"#FFFFFF\",\n  borderRadius: \"16px\",\n\n  shadowColor: \"rgba(0,0,0,0.35)\",\n  shadowBlur: \"20px\",\n  shadowOffsetY: \"8px\",\n\n  hoverScale: 1.04,\n\n  animation: \"pulse\",\n  animationSpeed: \"1.8s\",\n\n  textOffsetX: \"0px\"\n};\n</script>\n\n<button id=\"custom-releasit-btn\" type=\"button\">\n  <span></span>\n</button>\n\n<style>\n#_rsi-buy-now-button-floating,._rsi-buy-now-button-product-floating{display:none !important;}\n/* === Anti-flash verde: oculta el botón Releasit hasta que nuestro paint() lo repinte === */\n._rsi-buy-now-button-cart:not([data-gfs-painted=\"1\"]),\n._rsi-build-block-submit-button ._rsi-modal-submit-button:not([data-gfs-painted=\"1\"]){opacity:0 !important;transition:opacity .25s ease !important;}\n._rsi-buy-now-button-cart[data-gfs-painted=\"1\"],\n._rsi-build-block-submit-button ._rsi-modal-submit-button[data-gfs-painted=\"1\"]{opacity:1 !important;}\n#custom-releasit-btn{\n  all:unset;\n  position:relative;\n  overflow:hidden;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  cursor:pointer;\n  user-select:none;\n  transition:all .25s ease;\n  box-sizing:border-box;\n}\n#custom-releasit-btn:hover{\n  transform:scale(var(--hs));\n  background:var(--bh);\n}\n#custom-releasit-btn span{\n  position:relative;\n  z-index:2;\n  transform:translateX(var(--tox));\n}\n#custom-releasit-btn::before{content:\"\";position:absolute;top:0;left:-100%;width:60%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.45),transparent);animation:ggBtnShine 3.5s infinite;pointer-events:none;z-index:1;}\n@keyframes ggBtnShine{0%{left:-100%;}40%{left:140%;}100%{left:140%;}}\n@keyframes pulse{\n  0%{transform:scale(1)}\n  50%{transform:scale(1.05)}\n  100%{transform:scale(1)}\n}\n@keyframes shake{\n  0%{transform:translateX(0)}\n  25%{transform:translateX(-2px)}\n  50%{transform:translateX(2px)}\n  75%{transform:translateX(-2px)}\n  100%{transform:translateX(0)}\n}\n</style>\n\n<script>\n(function(){\n  const c=window.RELEASIT_BUTTON_CONFIG;\n  const b=document.getElementById(\"custom-releasit-btn\");\n  if(!b) return;\n\n  b.querySelector(\"span\").innerText=c.text;\n\n  b.style.width=c.width;\n  b.style.height=c.height;\n  b.style.padding=`${c.paddingY} ${c.paddingX}`;\n  b.style.marginTop=c.marginTop;\n  b.style.marginBottom=c.marginBottom;\n\n  b.style.background=c.bgColor;\n  b.style.color=c.textColor;\n  b.style.fontSize=c.fontSize;\n  b.style.fontWeight=c.fontWeight;\n  b.style.letterSpacing=c.letterSpacing;\n\n  b.style.border=`${c.borderWidth} ${c.borderStyle} ${c.borderColor}`;\n  b.style.borderRadius=c.borderRadius;\n\n  b.style.boxShadow=`0 ${c.shadowOffsetY} ${c.shadowBlur} ${c.shadowColor}`;\n\n  b.style.setProperty(\"--hs\",c.hoverScale);\n  b.style.setProperty(\"--bh\",c.bgColorHover);\n  b.style.setProperty(\"--tox\",c.textOffsetX);\n\n  if(c.animation===\"pulse\") b.style.animation=`pulse ${c.animationSpeed} infinite`;\n  if(c.animation===\"shake\") b.style.animation=`shake ${c.animationSpeed} infinite`;\n\n  b.addEventListener(\"click\",function(){\n    const r=document.querySelector(\"#_rsi-buy-now-button-overwrite, ._rsi-buy-now-button\");\n    if(r) r.click();\n  });\n})();\n</script>\n\n{% comment %}\n═══════════════════════════════════════════════════\n  📝 EDITAR AQUI — COLOR DE LOS BOTONES DE RELEASIT (por producto)\n\n  PRIMARY  = botón COD (Pagar Contra Entrega) → el principal\n  SECONDARY = botón Pago Anticipado (MercadoPago / PSE) → déjalo vacío \"\" para\n              conservar el color original de Releasit; ponle un color para overridearlo.\n═══════════════════════════════════════════════════\n{% endcomment %}\n{% assign RSI_PRIMARY_BG = \"var(--cta)\" %}\n{% assign RSI_SECONDARY_BG = \"\" %}\n{% assign RSI_TEXT = \"#ffffff\" %}\n\n{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}\n<script>\n(function(){\n  var P=\"{{ RSI_PRIMARY_BG }}\",S=\"{{ RSI_SECONDARY_BG }}\",T=\"{{ RSI_TEXT }}\";\n  function paintEl(el,bg){\n    if(!el||!bg) return;\n    el.style.setProperty('background',bg,'important');\n    el.style.setProperty('background-color',bg,'important');\n    if(T) el.style.setProperty('color',T,'important');\n    el.setAttribute('data-gfs-painted','1');\n  }\n  function paint(){\n    if(P){\n      document.querySelectorAll('._rsi-build-block-submit-button ._rsi-modal-submit-button').forEach(function(el){paintEl(el,P);});\n      document.querySelectorAll('._rsi-buy-now-button-cart').forEach(function(el){paintEl(el,P);});\n    }\n    if(S){\n      document.querySelectorAll('._rsi-build-block-custom-button ._rsi-buy-now-custom-additionals-button').forEach(function(el){paintEl(el,S);});\n    }\n    // SYNC: el botón del cart drawer copia el texto del botón principal\n    try{var cfg=window.RELEASIT_BUTTON_CONFIG;if(cfg&&cfg.text){document.querySelectorAll('._rsi-buy-now-button-cart').forEach(function(el){var sp=el.querySelector('span');if(sp&&sp.textContent.trim()!==cfg.text.trim())sp.textContent=cfg.text;else if(!sp&&el.textContent.trim()!==cfg.text.trim())el.textContent=cfg.text;});}}catch(e){}\n  }\n  function init(){\n    paint();\n    var throttle=null;\n    function tPaint(){if(throttle)return;throttle=setTimeout(function(){throttle=null;paint();},120);}\n    var mo=new MutationObserver(function(muts){\n      for(var i=0;i<muts.length;i++) if(muts[i].addedNodes.length){tPaint();return;}\n    });\n    if(document.body) mo.observe(document.body,{childList:true,subtree:true});\n    document.addEventListener('click',function(){paint();setTimeout(paint,40);setTimeout(paint,160);setTimeout(paint,400);},true);\n  }\n  if(document.body){init();}else if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init);}else{init();}\n})();\n</script>"
          }
