    "seccion_como_actua": {
      "type": "custom-liquid",
      "name": "3 COMO ACTUA PRODUCTO DEMO",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "{% comment %}\n========================\nTEXTOS EDITABLES\n========================\n{% endcomment %}\n{% assign TITLE = \"Cómo actúa PRODUCTO DEMO\" %}\n{% assign SUBTITLE = \"Tres fases, un solo objetivo: tu mejor versión\" %}\n{% assign L1_LABEL = \"Activación\" %}\n{% assign L1_NOTES = \"Primeros minutos · el impulso que enciende\" %}\n{% assign L1_ICON = \"⚡\" %}\n{% assign L2_LABEL = \"Rendimiento\" %}\n{% assign L2_NOTES = \"En el momento · energía y vigor sostenidos\" %}\n{% assign L2_ICON = \"🔥\" %}\n{% assign L3_LABEL = \"Resultados\" %}\n{% assign L3_NOTES = \"Con uso constante · vitalidad que se mantiene\" %}\n{% assign L3_ICON = \"🎯\" %}\n{% assign ACCENT_COLOR = \"var(--brand-primary)\" %}\n{% assign DARK_ACCENT = \"var(--brand-dark)\" %}\n\n{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}\n<style>\n.gfs-steps{max-width:560px;margin:8px auto;box-sizing:border-box;padding:0 14px;}\n.gfs-steps__title{text-align:center;font-size:24px;font-weight:800;color:#1a1a1a;letter-spacing:.3px;margin:0 0 4px;}\n.gfs-steps__sub{text-align:center;font-size:14px;color:#6b6b6b;margin:0 0 22px;font-style:italic;}\n.gfs-steps__grid{display:flex;flex-direction:column;gap:12px;}\n.gfs-step{display:flex;align-items:center;gap:14px;background:var(--brand-light);border:1px solid rgba(var(--brand-primary-rgb),.2);border-left:5px solid {{ ACCENT_COLOR }};border-radius:14px;padding:14px 16px;box-shadow:0 8px 24px rgba(var(--brand-primary-rgb),.08);}\n.gfs-step__icon{flex:0 0 46px;width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,{{ ACCENT_COLOR }},{{ DARK_ACCENT }});display:flex;align-items:center;justify-content:center;font-size:22px;box-shadow:0 4px 12px rgba(var(--brand-primary-rgb),.4),inset 0 1px 0 rgba(255,255,255,.25);}\n.gfs-step__label{font-size:13px;font-weight:800;color:{{ ACCENT_COLOR }};text-transform:uppercase;letter-spacing:.6px;margin:0 0 3px;}\n.gfs-step__notes{font-size:15px;font-weight:600;color:#1a1a1a;margin:0;}\n@media(min-width:990px){.gfs-steps{max-width:960px;}.gfs-steps__title{font-size:30px;}.gfs-steps__grid{flex-direction:row;align-items:stretch;gap:20px;}.gfs-step{flex:1;flex-direction:column;text-align:center;gap:14px;border-left:none;border-top:5px solid {{ ACCENT_COLOR }};padding:28px 18px;}.gfs-step__icon{width:54px;height:54px;flex:0 0 54px;font-size:26px;}}\n</style>\n<div class=\"gfs-steps\">\n  <p class=\"gfs-steps__title\">{{ TITLE }}</p>\n  <p class=\"gfs-steps__sub\">{{ SUBTITLE }}</p>\n  <div class=\"gfs-steps__grid\">\n    <div class=\"gfs-step\"><div class=\"gfs-step__icon\">{{ L1_ICON }}</div><div><p class=\"gfs-step__label\">{{ L1_LABEL }}</p><p class=\"gfs-step__notes\">{{ L1_NOTES }}</p></div></div>\n    <div class=\"gfs-step\"><div class=\"gfs-step__icon\">{{ L2_ICON }}</div><div><p class=\"gfs-step__label\">{{ L2_LABEL }}</p><p class=\"gfs-step__notes\">{{ L2_NOTES }}</p></div></div>\n    <div class=\"gfs-step\"><div class=\"gfs-step__icon\">{{ L3_ICON }}</div><div><p class=\"gfs-step__label\">{{ L3_LABEL }}</p><p class=\"gfs-step__notes\">{{ L3_NOTES }}</p></div></div>\n  </div>\n</div>",
        "color_scheme": "background-1"
      }
    },
    "seccion_resenas": {
      "type": "custom-liquid",
      "name": "RESEÑAS DE CLIENTES",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "{% comment %}\n========================\nTEXTOS EDITABLES  (las reseñas se editan en el SCRIPT de abajo)\n========================\n{% endcomment %}\n{% assign TITLE = \"Lo que dicen quienes ya lo usan\" %}\n{% assign COUNT_TEXT = \"Basado en compras verificadas\" %}\n{% assign ACCENT_COLOR = \"var(--brand-primary)\" %}\n{% assign BG_TAG = \"var(--brand-light)\" %}\n\n{% comment %} ═══ ↓ NO TOCAR (salvo el bloque de reseñas) ↓ ═══ {% endcomment %}\n<style>\n.gfs-reviews{max-width:560px;margin:8px auto;box-sizing:border-box;padding:0 14px;}\n.gfs-reviews__head{text-align:center;margin-bottom:18px;}\n.gfs-reviews__title{font-size:24px;font-weight:800;color:#1a1a1a;margin:0 0 4px;}\n.gfs-reviews__stars{font-size:16px;color:#f6c701;letter-spacing:2px;}\n.gfs-reviews__count{font-size:13px;color:#6b6b6b;margin-top:2px;font-style:italic;}\n.gfs-reviews__list{display:flex;flex-direction:column;gap:12px;}\n.gfs-review{background:#fff;border:1px solid rgba(0,0,0,.06);border-radius:16px;padding:16px 18px;box-shadow:0 8px 28px rgba(0,0,0,.06);}\n.gfs-review__top{display:flex;align-items:center;gap:12px;margin-bottom:8px;}\n.gfs-review__avatar{flex:0 0 44px;width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,{{ ACCENT_COLOR }},var(--brand-dark));color:#fff;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700;background-size:cover;background-position:center;box-shadow:0 4px 12px rgba(var(--brand-primary-rgb),.35);}\n.gfs-review__id{flex:1 1 auto;text-align:left;}\n.gfs-review__name{font-size:15px;font-weight:700;color:#1a1a1a;margin:0;display:flex;align-items:center;gap:6px;flex-wrap:wrap;}\n.gfs-review__verified{font-size:11px;font-weight:700;color:{{ ACCENT_COLOR }};background:{{ BG_TAG }};padding:2px 7px;border-radius:20px;}\n.gfs-review__city{font-size:12px;color:#888;margin:2px 0 0;}\n.gfs-review__stars{color:#f6c701;font-size:14px;letter-spacing:1px;}\n.gfs-review__text{font-size:14px;color:#444;line-height:1.55;margin:0;text-align:left;}\n@media(min-width:990px){.gfs-reviews{max-width:1000px;}.gfs-reviews__title{font-size:30px;}.gfs-reviews__list{flex-direction:row;align-items:stretch;}.gfs-reviews__list .gfs-review{flex:1 1 0;}}\n</style>\n<div class=\"gfs-reviews\">\n  <div class=\"gfs-reviews__head\">\n    <p class=\"gfs-reviews__title\">{{ TITLE }}</p>\n    <div class=\"gfs-reviews__stars\">★★★★★</div>\n    <p class=\"gfs-reviews__count\">{{ COUNT_TEXT }}</p>\n  </div>\n  <div id=\"gfs-reviews-list\" class=\"gfs-reviews__list\"></div>\n</div>\n<script>\n/* ═══ EDITAR LAS RESEÑAS AQUI ↓  (image:\"\" muestra inicial. image:\"URL\" muestra foto) ═══ */\n/* ⚠️ EJEMPLO — REEMPLAZAR POR RESEÑAS REALES. Si el cliente no tiene reseñas todavía, se */\n/* entregan estos ejemplos buenos y variados (NUNCA vacío). Cambia nombres/ciudades/texto por */\n/* los reales cuando existan. Mantén 5–6, con una de 4★ para que se vea creíble (REGLA #3). */\nwindow.GFS_REVIEWS = [\n  {name:\"Andrea G.\",   city:\"Bogotá\",       stars:5, image:\"\", text:\"La calidad superó lo que esperaba y llegó rápido. Pagué al recibir, sin enredos. 100% recomendado.\"},\n  {name:\"Carlos M.\",   city:\"Medellín\",     stars:5, image:\"\", text:\"Justo lo que buscaba. Tal cual las fotos, bien empacado y la atención por WhatsApp de una.\"},\n  {name:\"Valentina R.\",city:\"Cali\",         stars:4, image:\"\", text:\"Muy bueno, cumple lo que promete. Se demoró un día más de lo que pensé, pero valió la pena.\"},\n  {name:\"Julián P.\",   city:\"Barranquilla\", stars:5, image:\"\", text:\"Segundo que compro. Funciona igual de bien que el primero, por eso volví a pedir.\"},\n  {name:\"Daniela F.\",  city:\"Bucaramanga\",  stars:5, image:\"\", text:\"Me encantó. Lo recomendé a dos amigas y ya pidieron el suyo. Excelente relación calidad-precio.\"},\n  {name:\"Santiago L.\", city:\"Pereira\",      stars:5, image:\"\", text:\"Pago contra entrega real, lo recibí en mi casa y revisé antes de pagar. Quedé muy satisfecho.\"}\n];\n/* ═══ NO TOCAR ABAJO ═══ */\n(function(){var list=document.getElementById('gfs-reviews-list');if(!list)return;var data=window.GFS_REVIEWS||[];if(!data.length){var wrap=document.querySelector('.gfs-reviews');if(wrap)wrap.style.display='none';return;}/* salvaguarda: si quedara vacío, oculta la sección en vez de mostrar un hueco */data.forEach(function(r){var initials=r.name.trim().charAt(0).toUpperCase();var full=Math.max(0,Math.min(5,r.stars||0));var stars='★★★★★'.slice(0,full)+'☆☆☆☆☆'.slice(0,5-full);var avatarStyle=r.image?('background-image:url('+r.image+')'):'';var avatarText=r.image?'':initials;var el=document.createElement('div');el.className='gfs-review';el.innerHTML='<div class=\"gfs-review__top\"><div class=\"gfs-review__avatar\" style=\"'+avatarStyle+'\">'+avatarText+'</div><div class=\"gfs-review__id\"><p class=\"gfs-review__name\">'+r.name+' <span class=\"gfs-review__verified\">✓ Verificada</span></p><p class=\"gfs-review__city\">'+r.city+'</p><div class=\"gfs-review__stars\">'+stars+'</div></div></div><p class=\"gfs-review__text\">'+r.text+'</p>';list.appendChild(el);});})();\n</script>",
        "color_scheme": "background-1"
      }
    },
    "seccion_manifiesto": {
      "type": "custom-liquid",
      "name": "5 MANIFIESTO",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "{% comment %}\n========================\nTEXTOS EDITABLES\n========================\n{% endcomment %}\n{% assign LINE_1 = \"Hay hombres que se apagan.\" %}\n{% assign LINE_2 = \"Hay hombres que se conforman.\" %}\n{% assign LINE_3 = \"Y hay hombres\" %}\n{% assign LINE_4 = \"que no bajan el ritmo.\" %}\n{% assign CLOSING = \"PRODUCTO DEMO es para los terceros.\" %}\n{% comment %} CTA verde de cierre OPCIONAL (G2.4). Deja \"\" para ocultarlo; pon texto para mostrar un botón que dispara la compra (#custom-releasit-btn). {% endcomment %}\n{% assign CTA_TEXT = \"QUIERO EL MÍO AHORA 🔥\" %}\n{% assign BG_FROM = \"#0d0f12\" %}\n{% assign BG_TO = \"var(--brand-primary)\" %}\n{% assign TEXT_COLOR = \"#ffffff\" %}\n{% assign ACCENT_COLOR = \"var(--brand-text-hover)\" %}\n\n{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}\n<style>\n.gfs-manifesto{position:relative;background:linear-gradient(135deg,{{ BG_FROM }} 0%,{{ BG_TO }} 100%);padding:70px 24px;overflow:hidden;text-align:center;color:{{ TEXT_COLOR }};box-sizing:border-box;}\n.gfs-manifesto__content{position:relative;max-width:680px;margin:0 auto;}\n.gfs-manifesto__line{font-size:22px;line-height:1.4;margin:0 0 6px;font-weight:300;letter-spacing:.3px;color:{{ TEXT_COLOR }};opacity:0;transform:translateY(20px);transition:opacity 1s cubic-bezier(.16,1,.3,1),transform 1s cubic-bezier(.16,1,.3,1);}\n.gfs-manifesto__line.gfs-shown{opacity:1;transform:translateY(0);}\n.gfs-manifesto__line strong{color:{{ ACCENT_COLOR }};font-weight:700;}\n.gfs-manifesto__closing{margin-top:34px;font-size:12px;text-transform:uppercase;letter-spacing:3px;color:{{ ACCENT_COLOR }};opacity:0;transition:opacity 1.2s ease 1.7s;}\n.gfs-manifesto.gfs-show .gfs-manifesto__closing{opacity:.9;}\n/* CTA verde de cierre opcional (G2.4) */\n#gfs-mani-cta{position:relative;display:inline-block;margin-top:30px;padding:16px 40px;border:0;border-radius:50px;background:var(--cta);color:#fff;font-size:16px;font-weight:800;letter-spacing:.4px;text-transform:uppercase;cursor:pointer;overflow:hidden;opacity:0;transform:translateY(16px);transition:opacity .7s ease,transform .7s cubic-bezier(.16,1,.3,1);box-shadow:0 10px 28px rgba(var(--cta-rgb),.45);}\n#gfs-mani-cta.pe-show{opacity:1;transform:translateY(0);animation:gfsManiPulse 2.2s ease-in-out 1s infinite;}\n#gfs-mani-cta::after{content:\"\";position:absolute;top:0;left:-120%;width:60%;height:100%;background:linear-gradient(120deg,transparent,rgba(255,255,255,.55),transparent);transform:skewX(-20deg);animation:gfsManiShine 3.2s ease-in-out 1.4s infinite;}\n@keyframes gfsManiPulse{0%,100%{box-shadow:0 10px 28px rgba(var(--cta-rgb),.45);}50%{box-shadow:0 10px 40px rgba(var(--cta-rgb),.75);}}\n@keyframes gfsManiShine{0%{left:-120%;}55%,100%{left:160%;}}\n@media(prefers-reduced-motion:reduce){#gfs-mani-cta.pe-show{animation:none;}#gfs-mani-cta::after{display:none;}}\n@media(min-width:990px){.gfs-manifesto{padding:110px 24px;}.gfs-manifesto__line{font-size:34px;}#gfs-mani-cta{font-size:18px;padding:18px 48px;}}\n</style>\n<section class=\"gfs-manifesto\">\n  <div class=\"gfs-manifesto__content\">\n    <p class=\"gfs-manifesto__line\" data-delay=\"0\">{{ LINE_1 }}</p>\n    <p class=\"gfs-manifesto__line\" data-delay=\"350\">{{ LINE_2 }}</p>\n    <p class=\"gfs-manifesto__line\" data-delay=\"700\">{{ LINE_3 }}</p>\n    <p class=\"gfs-manifesto__line\" data-delay=\"1050\"><strong>{{ LINE_4 }}</strong></p>\n    <p class=\"gfs-manifesto__closing\">{{ CLOSING }}</p>\n    {% if CTA_TEXT != blank %}<button type=\"button\" id=\"gfs-mani-cta\">{{ CTA_TEXT }}</button>{% endif %}\n  </div>\n</section>\n<script>(function(){var section=document.querySelector('.gfs-manifesto');if(!section)return;var lines=section.querySelectorAll('.gfs-manifesto__line');var cta=section.querySelector('#gfs-mani-cta');var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){section.classList.add('gfs-show');lines.forEach(function(l){var d=parseInt(l.dataset.delay||0,10);setTimeout(function(){l.classList.add('gfs-shown');},d);});if(cta){setTimeout(function(){cta.classList.add('pe-show');},1400);}io.unobserve(section);}});},{threshold:0.25});io.observe(section);if(cta){cta.addEventListener('click',function(){var btn=document.querySelector('#custom-releasit-btn');if(btn){btn.click();btn.scrollIntoView({behavior:'smooth',block:'center'});}});}})();</script>",
        "color_scheme": "background-1"
      }
    },
    "seccion_faq": {
      "type": "custom-liquid",
      "name": "6 PREGUNTAS FRECUENTES",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "{% comment %}\n========================\nTEXTOS EDITABLES\n========================\n{% endcomment %}\n{% assign TITLE = \"Preguntas Frecuentes\" %}\n{% assign Q1 = \"Cómo se usa PRODUCTO DEMO?\" %}\n{% assign A1 = \"Muy fácil, siguiendo las indicaciones del empaque. <strong>Práctico y para usar en casa.</strong>\" %}\n{% assign Q2 = \"Qué tan rápido actúa?\" %}\n{% assign A2 = \"Es de <strong>acción progresiva</strong>: con <strong>uso constante</strong> se notan los mejores resultados.\" %}\n{% assign Q3 = \"Es natural y seguro?\" %}\n{% assign A3 = \"Sí, siguiendo las instrucciones de uso. Si tienes alguna condición particular, consulta a un profesional de la salud.\" %}\n{% assign Q4 = \"Cómo y cuándo pago?\" %}\n{% assign A4 = \"<strong>Pago contra entrega:</strong> pagas en efectivo cuando el transportador te entrega el pedido en la puerta de tu casa. Sin transferencias ni adelantos.\" %}\n{% assign Q5 = \"El envío es discreto?\" %}\n{% assign A5 = \"Sí. Llega en <strong>empaque discreto</strong>, con <strong>envío gratis a todo el país</strong>, normalmente entre <strong>3 y 7 días hábiles</strong>.\" %}\n{% assign ACCENT_COLOR = \"var(--brand-primary,#b82622)\" %}\n\n{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}\n<style>\n.gfs-faq{max-width:560px;margin:8px auto;box-sizing:border-box;padding:0 14px;}\n.gfs-faq__title{text-align:center;font-size:24px;font-weight:800;color:#1a1a1a;margin:0 0 18px;}\n.gfs-faq__item{background:#fff;border:1px solid rgba(var(--brand-primary-rgb),.15);border-radius:14px;margin-bottom:10px;overflow:hidden;box-shadow:0 4px 14px rgba(0,0,0,.04);position:relative;}\n.gfs-faq__item::before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:0;background:linear-gradient(180deg,{{ ACCENT_COLOR }},var(--brand-dark,#8e1c19));border-radius:14px 0 0 14px;transition:width .35s cubic-bezier(.16,1,.3,1);z-index:1;}\n.gfs-faq__item.gfs-open::before{width:4px;}\n.gfs-faq__q{all:unset;box-sizing:border-box;position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;padding:14px 16px;cursor:pointer;font-family:inherit;font-size:14.5px;font-weight:700;color:#1a1a1a;text-align:left;}\n.gfs-faq__q::after{content:\"+\";font-size:22px;font-weight:700;color:{{ ACCENT_COLOR }};flex:0 0 auto;transition:transform .35s cubic-bezier(.16,1,.3,1);}\n.gfs-faq__item.gfs-open .gfs-faq__q[aria-expanded=\"true\"]::after{transform:rotate(45deg);}\n.gfs-faq__q:focus-visible{outline:3px solid {{ ACCENT_COLOR }};outline-offset:-3px;border-radius:14px;}\n.gfs-faq__a{max-height:0;overflow:hidden;transition:max-height .4s cubic-bezier(.16,1,.3,1);}\n.gfs-faq__a p{padding:0 16px 14px;margin:0;font-size:14px;color:#555;line-height:1.6;text-align:left;}\n@media(min-width:990px){.gfs-faq{max-width:720px;}.gfs-faq__title{font-size:30px;}}\n@media(prefers-reduced-motion:reduce){.gfs-faq__item::before,.gfs-faq__q::after,.gfs-faq__a{transition:none !important;}}\n</style>\n<div class=\"gfs-faq\">\n  <p class=\"gfs-faq__title\">{{ TITLE }}</p>\n  <div class=\"gfs-faq__item\"><button class=\"gfs-faq__q\" type=\"button\" id=\"gfs-faq-q1\" aria-expanded=\"false\" aria-controls=\"gfs-faq-a1\"><span>{{ Q1 }}</span></button><div class=\"gfs-faq__a\" id=\"gfs-faq-a1\" role=\"region\" aria-labelledby=\"gfs-faq-q1\"><p>{{ A1 }}</p></div></div>\n  <div class=\"gfs-faq__item\"><button class=\"gfs-faq__q\" type=\"button\" id=\"gfs-faq-q2\" aria-expanded=\"false\" aria-controls=\"gfs-faq-a2\"><span>{{ Q2 }}</span></button><div class=\"gfs-faq__a\" id=\"gfs-faq-a2\" role=\"region\" aria-labelledby=\"gfs-faq-q2\"><p>{{ A2 }}</p></div></div>\n  <div class=\"gfs-faq__item\"><button class=\"gfs-faq__q\" type=\"button\" id=\"gfs-faq-q3\" aria-expanded=\"false\" aria-controls=\"gfs-faq-a3\"><span>{{ Q3 }}</span></button><div class=\"gfs-faq__a\" id=\"gfs-faq-a3\" role=\"region\" aria-labelledby=\"gfs-faq-q3\"><p>{{ A3 }}</p></div></div>\n  <div class=\"gfs-faq__item\"><button class=\"gfs-faq__q\" type=\"button\" id=\"gfs-faq-q4\" aria-expanded=\"false\" aria-controls=\"gfs-faq-a4\"><span>{{ Q4 }}</span></button><div class=\"gfs-faq__a\" id=\"gfs-faq-a4\" role=\"region\" aria-labelledby=\"gfs-faq-q4\"><p>{{ A4 }}</p></div></div>\n  <div class=\"gfs-faq__item\"><button class=\"gfs-faq__q\" type=\"button\" id=\"gfs-faq-q5\" aria-expanded=\"false\" aria-controls=\"gfs-faq-a5\"><span>{{ Q5 }}</span></button><div class=\"gfs-faq__a\" id=\"gfs-faq-a5\" role=\"region\" aria-labelledby=\"gfs-faq-q5\"><p>{{ A5 }}</p></div></div>\n</div>\n<script>(function(){var items=document.querySelectorAll('.gfs-faq__item');items.forEach(function(it){var q=it.querySelector('.gfs-faq__q');var a=it.querySelector('.gfs-faq__a');q.addEventListener('click',function(){var open=it.classList.contains('gfs-open');items.forEach(function(o){o.classList.remove('gfs-open');var oq=o.querySelector('.gfs-faq__q');var oa=o.querySelector('.gfs-faq__a');if(oq)oq.setAttribute('aria-expanded','false');if(oa)oa.style.maxHeight='0';});if(!open){it.classList.add('gfs-open');q.setAttribute('aria-expanded','true');a.style.maxHeight=a.scrollHeight+'px';}});});})();</script>",
        "color_scheme": "background-1"
      }
    },
    "seccion_escalera": {
      "type": "custom-liquid",
      "name": "ESCALERA DE VENTA (demo)",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "{% comment %}\n═══════════════════════════════════════════════════\n  📝 EDITAR AQUI — ESCALERA DE VENTA\n  · KICKER = pregunta-dolor o gancho corto (opcional, déjalo \"\" para ocultarlo)\n  · TITLE  = promesa/beneficio del panel\n  · TEXT   = desarrollo (1–2 frases, beneficio + objeción resuelta)\n  · IMG    = URL de la imagen o GIF demostrativo del panel\n  Para usar menos paneles, deja IMG en \"\" y ese panel no se renderiza.\n  ⚠️ Los textos de abajo son un EJEMPLO genérico (REGLA #3: nunca en blanco) — reemplázalos por\n     el copy real del producto, con las palabras del cliente. Las imágenes caen a la galería del\n     producto si dejas IMG en \"\" (fallback G2.4).\n═══════════════════════════════════════════════════\n{% endcomment %}\n{% assign SECTION_TITLE = \"\" %}{% assign P1_KICKER = \"Te suena familiar?\" %}\n{% assign P1_TITLE  = \"El problema que cargas todos los días\" %}\n{% assign P1_TEXT   = \"Sabes que algo no está funcionando como debería, y cada día que pasa el problema sigue ahí — recordándote que necesitas una solución de verdad, no otro parche.\" %}\n{% assign P1_IMG    = \"\" %}\n\n{% assign P2_KICKER = \"La solución\" %}\n{% assign P2_TITLE  = \"Resultado visible, sin complicaciones\" %}\n{% assign P2_TEXT   = \"Por eso lo hicimos simple: lo usas, ves el resultado y te olvidas del problema. Sin curva de aprendizaje ni pasos raros — funciona desde el primer día.\" %}\n{% assign P2_IMG    = \"\" %}\n\n{% assign P3_KICKER = \"\" %}\n{% assign P3_TITLE  = \"Hecho para tu día a día\" %}\n{% assign P3_TEXT   = \"Encaja en tu rutina sin esfuerzo, así que de verdad lo vas a usar y no va a terminar guardado en un cajón. Esa es la diferencia entre comprar y resolver.\" %}\n{% assign P3_IMG    = \"\" %}\n\n{% assign P4_KICKER = \"\" %}\n{% assign P4_TITLE  = \"\" %}\n{% assign P4_TEXT   = \"\" %}\n{% assign P4_IMG    = \"\" %}\n\n{% assign P5_KICKER = \"\" %}\n{% assign P5_TITLE  = \"\" %}\n{% assign P5_TEXT   = \"\" %}\n{% assign P5_IMG    = \"\" %}\n\n{% assign P6_KICKER = \"\" %}\n{% assign P6_TITLE  = \"\" %}\n{% assign P6_TEXT   = \"\" %}\n{% assign P6_IMG    = \"\" %}\n\n{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}\n<style>\n.gfs-lad{max-width:820px;margin:24px auto;box-sizing:border-box;padding:0 14px;}\n.gfs-lad__h{text-align:center;font-size:22px;font-weight:800;color:#1a1a1a;letter-spacing:.3px;margin:0 0 18px;text-transform:uppercase;}\n.gfs-lad__row{display:flex;flex-direction:column;align-items:stretch;gap:14px;background:linear-gradient(135deg,var(--brand-light) 0%,#fff 100%);border:1px solid rgba(var(--brand-primary-rgb),.14);border-radius:18px;overflow:hidden;box-shadow:0 10px 30px rgba(var(--brand-primary-rgb),.07);margin-bottom:16px;opacity:0;transform:translateY(22px);transition:opacity .6s ease,transform .6s cubic-bezier(.16,1,.3,1);}\n.gfs-lad__row.gfs-in{opacity:1;transform:none;}\n.gfs-lad__media{position:relative;width:100%;aspect-ratio:16/10;background:rgba(var(--brand-primary-rgb),.06);}\n.gfs-lad__media img{width:100%;height:100%;object-fit:cover;display:block;}\n.gfs-lad__body{padding:16px 18px 20px;}\n.gfs-lad__kicker{display:inline-block;font-size:12px;font-weight:800;letter-spacing:.5px;text-transform:uppercase;color:var(--brand-dark);background:rgba(var(--brand-primary-rgb),.12);padding:4px 10px;border-radius:20px;margin:0 0 8px;}\n.gfs-lad__t{font-size:18px;font-weight:800;color:#1a1a1a;line-height:1.25;margin:0 0 6px;}\n.gfs-lad__p{font-size:14px;color:#444;line-height:1.55;margin:0;}\n@media(min-width:750px){\n  .gfs-lad__row{flex-direction:row;align-items:center;gap:0;}\n  .gfs-lad__row:nth-child(even){flex-direction:row-reverse;}\n  .gfs-lad__media{flex:0 0 46%;aspect-ratio:4/3;align-self:stretch;}\n  .gfs-lad__body{flex:1 1 auto;padding:26px 30px;}\n  .gfs-lad__h{font-size:28px;margin-bottom:26px;}\n  .gfs-lad__t{font-size:22px;}\n  .gfs-lad__p{font-size:15.5px;}\n}\n.gfs-lad__row--noimg .gfs-lad__media{display:none;}\n.gfs-lad__row--noimg .gfs-lad__body{flex-basis:100%;text-align:center;}\n</style>\n<div class=\"gfs-lad\">\n  {% if SECTION_TITLE != \"\" %}<p class=\"gfs-lad__h\">{{ SECTION_TITLE }}</p>{% endif %}\n  {% assign K = P1_KICKER | append: '||' | append: P2_KICKER | append: '||' | append: P3_KICKER | append: '||' | append: P4_KICKER | append: '||' | append: P5_KICKER | append: '||' | append: P6_KICKER | split: '||' %}\n  {% assign T = P1_TITLE  | append: '||' | append: P2_TITLE  | append: '||' | append: P3_TITLE  | append: '||' | append: P4_TITLE  | append: '||' | append: P5_TITLE  | append: '||' | append: P6_TITLE  | split: '||' %}\n  {% assign X = P1_TEXT   | append: '||' | append: P2_TEXT   | append: '||' | append: P3_TEXT   | append: '||' | append: P4_TEXT   | append: '||' | append: P5_TEXT   | append: '||' | append: P6_TEXT   | split: '||' %}\n  {% assign M = P1_IMG    | append: '||' | append: P2_IMG    | append: '||' | append: P3_IMG    | append: '||' | append: P4_IMG    | append: '||' | append: P5_IMG    | append: '||' | append: P6_IMG    | split: '||' %}\n  {% for t in T %}\n    {% assign kick = K[forloop.index0] %}{% assign txt = X[forloop.index0] %}{% assign img = M[forloop.index0] %}\n    {% comment %} Fallback (G2.4): si el panel no trae imagen, usa una de la galería del producto para que la escalera NUNCA quede en blanco. {% endcomment %}\n    \n    {% if t != blank or txt != blank %}\n      <div class=\"gfs-lad__row{% if img == blank %} gfs-lad__row--noimg{% endif %}\">\n        <div class=\"gfs-lad__media\">{% if img != blank %}<img src=\"{{ img }}\" alt=\"{{ t | escape }}\" loading=\"lazy\" decoding=\"async\">{% endif %}</div>\n        <div class=\"gfs-lad__body\">\n          {% if kick != blank %}<span class=\"gfs-lad__kicker\">{{ kick }}</span>{% endif %}\n          {% if t != blank %}<h3 class=\"gfs-lad__t\">{{ t }}</h3>{% endif %}\n          {% if txt != blank %}<p class=\"gfs-lad__p\">{{ txt }}</p>{% endif %}\n        </div>\n      </div>\n    {% endif %}\n  {% endfor %}\n</div>\n<script>\n(function(){\n  var rows=document.querySelectorAll('.gfs-lad__row');\n  if(!('IntersectionObserver' in window)){rows.forEach(function(r){r.classList.add('gfs-in');});return;}\n  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('gfs-in');io.unobserve(e.target);}});},{threshold:.15});\n  rows.forEach(function(r){io.observe(r);});\n})();\n</script>\n",
        "color_scheme": "background-1"
      }
    },
    "seccion_ficha_tecnica": {
      "type": "custom-liquid",
      "name": "FICHA TECNICA (apagada: solo gadget/kit, llenar specs)",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "{% comment %}\n═══════════════════════════════════════════════════\n  📝 EDITAR AQUI — FICHA TÉCNICA\n  · S#_ICON  = emoji o ícono corto\n  · S#_LABEL = nombre de la spec (ej. \"Autonomía\")\n  · S#_VALUE = valor real de la spec (ej. \"8 h\")  ← dato duro: confírmalo, no lo inventes\n  Para menos filas, deja S#_LABEL en \"\" y esa fila no se renderiza.\n═══════════════════════════════════════════════════\n{% endcomment %}\n{% assign SECTION_TITLE = \"Ficha técnica\" %}\n\n{% assign S1_ICON = \"🔋\" %}{% assign S1_LABEL = \"Autonomía\" %}{% assign S1_VALUE = \"[confirmar]\" %}\n{% assign S2_ICON = \"⚡\" %}{% assign S2_LABEL = \"Carga\" %}{% assign S2_VALUE = \"[confirmar]\" %}\n{% assign S3_ICON = \"📦\" %}{% assign S3_LABEL = \"Incluye\" %}{% assign S3_VALUE = \"[confirmar]\" %}\n{% assign S4_ICON = \"📐\" %}{% assign S4_LABEL = \"Medidas\" %}{% assign S4_VALUE = \"[confirmar]\" %}\n{% assign S5_ICON = \"🧵\" %}{% assign S5_LABEL = \"Material\" %}{% assign S5_VALUE = \"[confirmar]\" %}\n{% assign S6_ICON = \"🛡️\" %}{% assign S6_LABEL = \"Garantía\" %}{% assign S6_VALUE = \"[confirmar]\" %}\n\n{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}\n<style>\n.gfs-spec{max-width:820px;margin:24px auto;box-sizing:border-box;padding:0 14px;}\n.gfs-spec__h{text-align:center;font-size:20px;font-weight:800;color:#1a1a1a;letter-spacing:.3px;margin:0 0 16px;text-transform:uppercase;}\n.gfs-spec__grid{display:grid;grid-template-columns:1fr;gap:10px;}\n.gfs-spec__row{display:flex;align-items:center;gap:14px;background:linear-gradient(135deg,var(--brand-light) 0%,#fff 100%);border:1px solid rgba(var(--brand-primary-rgb),.16);border-radius:14px;padding:14px 16px;box-shadow:0 6px 18px rgba(var(--brand-primary-rgb),.06);}\n.gfs-spec__icon{flex:0 0 44px;width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,var(--brand-primary),var(--brand-dark));display:flex;align-items:center;justify-content:center;font-size:22px;box-shadow:0 4px 12px rgba(var(--brand-primary-rgb),.4),inset 0 1px 0 rgba(255,255,255,.3);}\n.gfs-spec__label{flex:1 1 auto;font-size:13.5px;font-weight:700;color:#555;text-transform:uppercase;letter-spacing:.3px;}\n.gfs-spec__value{flex:0 0 auto;text-align:right;font-size:15px;font-weight:800;color:#1a1a1a;}\n@media(min-width:750px){\n  .gfs-spec__h{font-size:26px;margin-bottom:24px;}\n  .gfs-spec__grid{grid-template-columns:1fr 1fr;gap:14px;}\n  .gfs-spec__label{font-size:14px;}\n  .gfs-spec__value{font-size:16px;}\n}\n</style>\n<div class=\"gfs-spec\">\n  {% if SECTION_TITLE != \"\" %}<p class=\"gfs-spec__h\">{{ SECTION_TITLE }}</p>{% endif %}\n  <div class=\"gfs-spec__grid\">\n    {% assign IC = S1_ICON  | append: '||' | append: S2_ICON  | append: '||' | append: S3_ICON  | append: '||' | append: S4_ICON  | append: '||' | append: S5_ICON  | append: '||' | append: S6_ICON  | split: '||' %}\n    {% assign LB = S1_LABEL | append: '||' | append: S2_LABEL | append: '||' | append: S3_LABEL | append: '||' | append: S4_LABEL | append: '||' | append: S5_LABEL | append: '||' | append: S6_LABEL | split: '||' %}\n    {% assign VL = S1_VALUE | append: '||' | append: S2_VALUE | append: '||' | append: S3_VALUE | append: '||' | append: S4_VALUE | append: '||' | append: S5_VALUE | append: '||' | append: S6_VALUE | split: '||' %}\n    {% for lab in LB %}\n      {% assign ico = IC[forloop.index0] %}{% assign val = VL[forloop.index0] %}\n      {% if lab != blank %}\n        <div class=\"gfs-spec__row\">\n          <div class=\"gfs-spec__icon\">{{ ico }}</div>\n          <span class=\"gfs-spec__label\">{{ lab }}</span>\n          <span class=\"gfs-spec__value\">{{ val }}</span>\n        </div>\n      {% endif %}\n    {% endfor %}\n  </div>\n</div>\n",
        "color_scheme": "background-1"
      },
