        "custom_liquid_ignition": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% comment %}\n═══════════════════════════════════════════════════\n  📝 EDITAR AQUI — PRODUCTO DEMO IGNITION SEQUENCE (intro cinematografica)\n  Explosion central + rayos + titulo gigante + revelacion de pagina\n  Para REVERTIR: borrar desde este bloque hasta el  que dice FIN IGNITION\n═══════════════════════════════════════════════════\n{% endcomment %}\n{% assign IGN_TITLE = \"✨ PRODUCTO DEMO ✨\" %}\n{% assign IGN_SUBTITLE = \"LO QUE ESTABAS BUSCANDO\" %}\n{% assign IGN_COLOR = \"var(--brand-primary)\" %}\n{% assign IGN_BRIGHT = \"var(--brand-bright)\" %}\n\n<div class=\"gfs-ignition\" aria-hidden=\"true\">\n  <div class=\"gfs-ignition__core\"></div>\n  <div class=\"gfs-ignition__rays\"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>\n  <div class=\"gfs-ignition__content\">\n    <div class=\"gfs-ignition__title\">{{ IGN_TITLE }}</div>\n    <div class=\"gfs-ignition__subtitle\">{{ IGN_SUBTITLE }}</div>\n  </div>\n</div>\n<style>\n/* === IGNITION OVERLAY === */\n.gfs-ignition{position:fixed;inset:0;z-index:99999;pointer-events:none;overflow:hidden;display:flex;align-items:center;justify-content:center;background:radial-gradient(ellipse at center,#1a0808 0%,#000 70%);animation:gfsIgnitionFade 2.4s .1s cubic-bezier(.65,0,.35,1) forwards;}\n.gfs-ignition__core{position:absolute;top:50%;left:50%;width:80px;height:80px;border-radius:50%;background:radial-gradient(circle,#fff 0%,#ffeaa7 18%,{{ IGN_BRIGHT }} 40%,{{ IGN_COLOR }} 65%,transparent 85%);transform:translate(-50%,-50%) scale(0);filter:blur(2px);box-shadow:0 0 100px {{ IGN_BRIGHT }},0 0 200px {{ IGN_COLOR }};animation:gfsCoreExplode 1.9s cubic-bezier(.22,1,.36,1) forwards;}\n.gfs-ignition__rays{position:absolute;top:50%;left:50%;width:0;height:0;}\n.gfs-ignition__rays span{position:absolute;top:0;left:0;width:3px;height:120vh;margin-left:-1.5px;margin-top:-120vh;background:linear-gradient(to bottom,transparent 0%,{{ IGN_BRIGHT }} 40%,#fff 50%,{{ IGN_BRIGHT }} 60%,transparent 100%);transform-origin:50% 100%;opacity:0;box-shadow:0 0 20px {{ IGN_BRIGHT }};animation:gfsRayBurst 1.7s .25s cubic-bezier(.16,1,.3,1) forwards;}\n.gfs-ignition__rays span:nth-child(1){transform:rotate(0deg);}\n.gfs-ignition__rays span:nth-child(2){transform:rotate(45deg);animation-delay:.30s;}\n.gfs-ignition__rays span:nth-child(3){transform:rotate(90deg);animation-delay:.28s;}\n.gfs-ignition__rays span:nth-child(4){transform:rotate(135deg);animation-delay:.33s;}\n.gfs-ignition__rays span:nth-child(5){transform:rotate(180deg);animation-delay:.26s;}\n.gfs-ignition__rays span:nth-child(6){transform:rotate(225deg);animation-delay:.31s;}\n.gfs-ignition__rays span:nth-child(7){transform:rotate(270deg);animation-delay:.27s;}\n.gfs-ignition__rays span:nth-child(8){transform:rotate(315deg);animation-delay:.32s;}\n.gfs-ignition__content{position:relative;z-index:5;text-align:center;}\n.gfs-ignition__title{font-family:'Arial Black','Helvetica Neue',sans-serif;font-size:clamp(38px,8vw,96px);font-weight:900;color:#fff;letter-spacing:6px;line-height:1;text-shadow:0 0 30px {{ IGN_BRIGHT }},0 0 60px {{ IGN_COLOR }},0 0 100px {{ IGN_COLOR }};animation:gfsTitleEntrance 1.4s .4s cubic-bezier(.34,1.56,.64,1) backwards;}\n.gfs-ignition__subtitle{margin-top:14px;font-family:'Montserrat','Arial',sans-serif;font-size:clamp(11px,1.5vw,16px);font-weight:700;color:{{ IGN_BRIGHT }};letter-spacing:6px;text-transform:uppercase;animation:gfsSubtitleEntrance 1.2s .8s cubic-bezier(.16,1,.3,1) backwards;}\n\n@keyframes gfsIgnitionFade{0%,65%{opacity:1;}100%{opacity:0;visibility:hidden;transform:scale(1.08);}}\n@keyframes gfsCoreExplode{0%{opacity:0;transform:translate(-50%,-50%) scale(0);}15%{opacity:1;transform:translate(-50%,-50%) scale(1);}55%{opacity:1;transform:translate(-50%,-50%) scale(6);filter:blur(8px);}100%{opacity:0;transform:translate(-50%,-50%) scale(28);filter:blur(20px);}}\n@keyframes gfsRayBurst{0%{opacity:0;height:0;}25%{opacity:1;}70%{opacity:1;height:120vh;}100%{opacity:0;}}\n@keyframes gfsTitleEntrance{0%{opacity:0;transform:scale(.3) rotate(-4deg);filter:blur(20px);letter-spacing:40px;}55%{opacity:1;transform:scale(1.18) rotate(1deg);filter:blur(0);letter-spacing:4px;}100%{opacity:1;transform:scale(1) rotate(0);letter-spacing:6px;}}\n@keyframes gfsSubtitleEntrance{0%{opacity:0;letter-spacing:36px;}100%{opacity:1;letter-spacing:6px;}}\n\n/* === EFECTOS PERMANENTES SOBRE EL HEADER (despues que la ignicion termina) === */\n.shopify-section-group-header-group{position:relative !important;}\n.shopify-section-group-header-group::before{content:\"\";position:absolute;inset:0;background:radial-gradient(2px 2px at 10% 80%,{{ IGN_BRIGHT }},transparent 70%),radial-gradient(1.5px 1.5px at 25% 90%,{{ IGN_COLOR }},transparent 70%),radial-gradient(2px 2px at 50% 75%,#ff8c50,transparent 70%),radial-gradient(2.5px 2.5px at 70% 85%,{{ IGN_COLOR }},transparent 70%),radial-gradient(1.5px 1.5px at 85% 90%,{{ IGN_BRIGHT }},transparent 70%);animation:gfsHdrEmbers 4s 2.4s ease-out infinite backwards;pointer-events:none;z-index:1;}\n\n@keyframes gfsHdrEmbers{0%{opacity:0;transform:translateY(0);}20%{opacity:.9;}100%{opacity:0;transform:translateY(-80%);}}\n\n/* Logo con \"respiracion\" permanente (glow palpitante) */\n\n\n/* Hover dramatico del logo */\n.header__heading:hover img,.header__heading-link:hover img{transform:scale(1.06);transition:transform .3s ease;}\n</style>\n<style>/* === Bypass: aun con reduced-motion ON en iOS, el ignition se ve === */\n@media (prefers-reduced-motion: reduce){\n  .gfs-ignition{animation:gfsIgnitionFade 3s .1s cubic-bezier(.65,0,.35,1) forwards !important;}\n  .gfs-ignition__core{animation:gfsCoreExplode 2s cubic-bezier(.22,1,.36,1) forwards !important;}\n  .gfs-ignition__rays span{animation:gfsRayBurst 1.7s .25s cubic-bezier(.16,1,.3,1) forwards !important;}\n  .gfs-ignition__title{animation:gfsTitleEntrance 1.6s .4s cubic-bezier(.34,1.56,.64,1) backwards !important;}\n  .gfs-ignition__subtitle{animation:gfsSubtitleEntrance 1.2s .8s cubic-bezier(.16,1,.3,1) backwards !important;}\n}\n/* === Mobile: mas tiempo visible para que de tiempo a leer === */\n@media (max-width:749px){\n  .gfs-ignition{animation-duration:3.4s !important;}\n  .gfs-ignition__title{font-size:42px !important;letter-spacing:3px !important;}\n  .gfs-ignition__subtitle{font-size:11px !important;letter-spacing:4px !important;}\n}\n</style>\n{% comment %} ═══ ↑ FIN IGNITION ↑ ═══ {% endcomment %}"
          },
          "name": "1c INTRO ANIMADA (ignition · cosmético)"
