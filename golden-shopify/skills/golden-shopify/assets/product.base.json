    "seccion_por_que_elegir": {
      "type": "custom-liquid",
      "name": "POR QUE ELEGIR",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "{% comment %}\n═══════════════════════════════════════════════════\n  📝 EDITAR AQUI — POR QUÉ ELEGIR? (4 razones del PRODUCTO)\n  Cada razón = EMOJI + TÍTULO corto + TEXTO de 1 línea. Hazlas específicas al producto.\n═══════════════════════════════════════════════════\n{% endcomment %}\n{% assign SECTION_TITLE = \"Por qué elegir este producto?\" %}\n\n{% assign R1_ICON = \"✨\" %}{% assign R1_TITLE = \"Resultado real\" %}{% assign R1_TEXT = \"Notas la diferencia desde el primer uso, no en semanas de espera.\" %}\n{% assign R2_ICON = \"🌿\" %}{% assign R2_TITLE = \"A tu favor\" %}{% assign R2_TEXT = \"Fácil de usar y pensado para adaptarse a ti, no al revés.\" %}\n{% assign R3_ICON = \"💎\" %}{% assign R3_TITLE = \"Calidad premium\" %}{% assign R3_TEXT = \"Original y sellado, importadores directos.\" %}\n{% assign R4_ICON = \"🛡️\" %}{% assign R4_TITLE = \"Compra segura\" %}{% assign R4_TEXT = \"Pagas al recibir, sin adelantos ni riesgo.\" %}\n\n{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}\n<style>\n.gfs-why{max-width:820px;margin:24px auto;box-sizing:border-box;padding:0 14px;}\n.gfs-why__h{text-align:center;font-size:20px;font-weight:800;color:#1a1a1a;letter-spacing:.3px;margin:0 0 16px;text-transform:uppercase;}\n.gfs-why__grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}\n.gfs-why__card{background:linear-gradient(135deg,var(--brand-light) 0%,#fff 100%);border:1px solid rgba(var(--brand-primary-rgb),.16);border-radius:16px;padding:16px 14px;text-align:center;box-shadow:0 6px 20px rgba(var(--brand-primary-rgb),.06);transition:transform .3s cubic-bezier(.16,1,.3,1);}\n.gfs-why__card:hover{transform:translateY(-4px);}\n.gfs-why__icon{width:48px;height:48px;margin:0 auto 8px;border-radius:50%;background:linear-gradient(135deg,var(--brand-primary),var(--brand-dark));display:flex;align-items:center;justify-content:center;font-size:24px;box-shadow:0 4px 12px rgba(var(--brand-primary-rgb),.4),inset 0 1px 0 rgba(255,255,255,.3);}\n.gfs-why__t{font-size:14px;font-weight:800;color:#1a1a1a;margin:0 0 4px;text-transform:uppercase;letter-spacing:.3px;line-height:1.2;}\n.gfs-why__p{font-size:12.5px;color:#555;line-height:1.4;margin:0;}\n@media(min-width:750px){\n  .gfs-why__h{font-size:26px;margin-bottom:24px;}\n  .gfs-why__grid{grid-template-columns:repeat(4,1fr);gap:16px;}\n  .gfs-why__card{padding:24px 16px;}\n  .gfs-why__icon{width:60px;height:60px;font-size:30px;}\n  .gfs-why__t{font-size:15px;}\n  .gfs-why__p{font-size:13.5px;}\n}\n</style>\n<div class=\"gfs-why\">\n  <p class=\"gfs-why__h\">{{ SECTION_TITLE }}</p>\n  <div class=\"gfs-why__grid\">\n    <div class=\"gfs-why__card\"><div class=\"gfs-why__icon\">{{ R1_ICON }}</div><p class=\"gfs-why__t\">{{ R1_TITLE }}</p><p class=\"gfs-why__p\">{{ R1_TEXT }}</p></div>\n    <div class=\"gfs-why__card\"><div class=\"gfs-why__icon\">{{ R2_ICON }}</div><p class=\"gfs-why__t\">{{ R2_TITLE }}</p><p class=\"gfs-why__p\">{{ R2_TEXT }}</p></div>\n    <div class=\"gfs-why__card\"><div class=\"gfs-why__icon\">{{ R3_ICON }}</div><p class=\"gfs-why__t\">{{ R3_TITLE }}</p><p class=\"gfs-why__p\">{{ R3_TEXT }}</p></div>\n    <div class=\"gfs-why__card\"><div class=\"gfs-why__icon\">{{ R4_ICON }}</div><p class=\"gfs-why__t\">{{ R4_TITLE }}</p><p class=\"gfs-why__p\">{{ R4_TEXT }}</p></div>\n  </div>\n</div>\n",
        "color_scheme": "background-1"
      }
    },
    "seccion_whatsapp": {
      "type": "custom-liquid",
      "name": "WHATSAPP FLOTANTE",
      "settings": {
        "custom_liquid": "{%- comment -%}\n═══════════════════════════════════════════════════\n  📝 EDITAR AQUI — BOTÓN FLOTANTE WHATSAPP\n  WA_NUMBER: número con código de país, SIN + ni espacios (ej. 57300..., 502...).\n  WA_MSG: mensaje con el que abre el chat.\n  WA_SIDE: \"right\" o \"left\".\n═══════════════════════════════════════════════════\n{%- endcomment -%}\n{% assign WA_NUMBER = \"573001234567\" %}\n{% assign WA_MSG    = \"Hola, quiero información del producto\" %}\n{% assign WA_SIDE   = \"right\" %}\n\n{%- comment -%} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {%- endcomment -%}\n<a class=\"wa-float wa-float--{{ WA_SIDE }}\"\n   href=\"https://wa.me/{{ WA_NUMBER }}?text={{ WA_MSG | url_encode }}\"\n   target=\"_blank\" rel=\"noopener\" aria-label=\"Escríbenos por WhatsApp\">\n  <svg viewBox=\"0 0 32 32\" width=\"30\" height=\"30\" fill=\"#fff\" aria-hidden=\"true\">\n    <path d=\"M16 .4C7.4.4.5 7.3.5 15.9c0 2.8.8 5.5 2.2 7.9L.4 31.6l8-2.1c2.3 1.3 4.9 1.9 7.6 1.9 8.6 0 15.5-6.9 15.5-15.5S24.6.4 16 .4zm0 28.3c-2.4 0-4.7-.6-6.7-1.9l-.5-.3-4.8 1.3 1.3-4.6-.3-.5a12.8 12.8 0 01-2-6.9C3 8.9 8.8 3.2 16 3.2S29 8.9 29 16 23.2 28.7 16 28.7zm7.1-9.6c-.4-.2-2.3-1.1-2.6-1.3-.4-.1-.6-.2-.9.2-.3.4-1 1.3-1.2 1.5-.2.2-.4.3-.8.1-.4-.2-1.6-.6-3.1-1.9-1.1-1-1.9-2.3-2.1-2.7-.2-.4 0-.6.2-.8l.6-.7c.2-.2.3-.4.4-.6.1-.2 0-.5 0-.7-.1-.2-.9-2.1-1.2-2.9-.3-.8-.6-.7-.9-.7h-.7c-.2 0-.6.1-1 .5-.3.4-1.3 1.3-1.3 3.1s1.3 3.6 1.5 3.9c.2.2 2.6 4 6.4 5.6.9.4 1.6.6 2.1.8.9.3 1.7.2 2.3.1.7-.1 2.3-.9 2.6-1.8.3-.9.3-1.6.2-1.8-.1-.1-.3-.2-.7-.4z\"/>\n  </svg>\n  <span class=\"wa-float__pulse\"></span>\n</a>\n<style>\n.wa-float{position:fixed;bottom:20px;z-index:9998;display:flex;align-items:center;justify-content:center;\n  width:56px;height:56px;border-radius:50%;background:#25D366;\n  box-shadow:0 6px 20px rgba(37,211,102,.45);text-decoration:none;}\n.wa-float--right{right:18px;}\n.wa-float--left{left:18px;}\n.wa-float__pulse{position:absolute;inset:0;border-radius:50%;background:#25D366;opacity:.6;\n  animation:waPulse 2.2s ease-out infinite;z-index:-1;}\n@keyframes waPulse{0%{transform:scale(1);opacity:.6;}70%{transform:scale(1.8);opacity:0;}100%{opacity:0;}}\n.wa-float:hover{transform:scale(1.06);transition:transform .2s ease;}\n@media(min-width:990px){.wa-float{width:62px;height:62px;bottom:24px;}}\n</style>\n<script>(function(){var w=document.querySelector('.wa-float');if(w&&w.parentNode!==document.body){document.body.appendChild(w);}})();/* ancla al body: el position:fixed no se rompe si un ancestro tiene transform */</script>",
        "color_scheme": "scheme-1"
      }
    },
    "sec_escenas": {
      "type": "custom-liquid",
      "name": "P1 TE SUENA (problema)",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "{% comment %} === COMPONENTE: TE SUENA? (identificación por escenas) === {% endcomment %}\n{% comment %} Fusión de la línea \"GOLDEN FULL\" → reconstruido en gfs- tokenizado y accesible (G3.2). {% endcomment %}\n{% comment %} Enganche emocional: el cliente se reconoce en 3-4 escenas de su problema, luego una conclusión {% endcomment %}\n{% comment %} que valida \"esto es para ti\". Va temprano en el embudo (tras el hero), antes de educar. {% endcomment %}\n\n{% comment %} 📝 EDITAR AQUI {% endcomment %}\n{% assign TITLE = \"Te suena alguna de estas escenas?\" %}\n{% assign E1_ICON = \"🙈\" %}{% assign E1 = \"Escondes la zona para que nadie note el problema.\" %}\n{% assign E2_ICON = \"😳\" %}{% assign E2 = \"Te da pena en momentos donde deberías estar tranquilo.\" %}\n{% assign E3_ICON = \"🔁\" %}{% assign E3 = \"Probaste algo, mejoró un poco… y volvió a aparecer.\" %}\n{% assign E4_ICON = \"💸\" %}{% assign E4 = \"Te asustan los procedimientos, las cicatrices o el costo.\" %}\n{% assign CONCL = \"Si te pasa aunque sea una, esto te interesa.\" %}\n\n{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}\n<style>\n.gfs-sc{max-width:600px;margin:8px auto;padding:0 14px;box-sizing:border-box;}\n.gfs-sc__title{text-align:center;font-size:24px;font-weight:800;color:#1a1a1a;margin:0 0 20px;}\n.gfs-sc__list{display:flex;flex-direction:column;gap:11px;}\n.gfs-sc__item{display:flex;align-items:flex-start;gap:12px;background:#fff;border:1px solid rgba(var(--brand-primary-rgb),.28);border-radius:14px;padding:15px 16px;box-shadow:0 6px 18px rgba(var(--brand-primary-rgb),.06);opacity:0;transform:translateY(18px);transition:opacity .6s cubic-bezier(.16,1,.3,1),transform .6s cubic-bezier(.16,1,.3,1);}\n.gfs-sc.gfs-in .gfs-sc__item{opacity:1;transform:none;}\n.gfs-sc.gfs-in .gfs-sc__item:nth-child(1){transition-delay:.05s;}\n.gfs-sc.gfs-in .gfs-sc__item:nth-child(2){transition-delay:.18s;}\n.gfs-sc.gfs-in .gfs-sc__item:nth-child(3){transition-delay:.31s;}\n.gfs-sc.gfs-in .gfs-sc__item:nth-child(4){transition-delay:.44s;}\n.gfs-sc__ic{flex:0 0 26px;width:26px;height:26px;border-radius:50%;background:var(--brand-light,#fff5f5);display:flex;align-items:center;justify-content:center;font-size:14px;}\n.gfs-sc__tx{font-size:14.5px;color:#333;font-weight:600;line-height:1.45;margin:2px 0 0;text-align:left;}\n.gfs-sc__concl{margin-top:18px;text-align:center;background:linear-gradient(135deg,var(--brand-light,#fff5f5),#fff);border:1.5px solid rgba(var(--brand-primary-rgb),.55);border-radius:16px;padding:16px 18px;font-weight:800;font-size:16.5px;color:var(--brand-dark,#8e1c19);box-shadow:0 10px 26px rgba(var(--brand-primary-rgb),.12);opacity:0;transform:translateY(16px);transition:opacity .7s .6s cubic-bezier(.16,1,.3,1),transform .7s .6s cubic-bezier(.16,1,.3,1);}\n.gfs-sc.gfs-in .gfs-sc__concl{opacity:1;transform:none;}\n@media(min-width:990px){.gfs-sc{max-width:920px;}.gfs-sc__title{font-size:30px;}.gfs-sc__list{display:grid;grid-template-columns:1fr 1fr;gap:12px;}.gfs-sc__tx{font-size:15.5px;}.gfs-sc__concl{font-size:20px;max-width:620px;margin-left:auto;margin-right:auto;}}\n@media(prefers-reduced-motion:reduce){.gfs-sc__item,.gfs-sc__concl{transition:none !important;opacity:1 !important;transform:none !important;}}\n</style>\n<div class=\"gfs-sc\">\n  <p class=\"gfs-sc__title\">{{ TITLE }}</p>\n  <div class=\"gfs-sc__list\">\n    <div class=\"gfs-sc__item\"><div class=\"gfs-sc__ic\" aria-hidden=\"true\">{{ E1_ICON }}</div><p class=\"gfs-sc__tx\">{{ E1 }}</p></div>\n    <div class=\"gfs-sc__item\"><div class=\"gfs-sc__ic\" aria-hidden=\"true\">{{ E2_ICON }}</div><p class=\"gfs-sc__tx\">{{ E2 }}</p></div>\n    <div class=\"gfs-sc__item\"><div class=\"gfs-sc__ic\" aria-hidden=\"true\">{{ E3_ICON }}</div><p class=\"gfs-sc__tx\">{{ E3 }}</p></div>\n    <div class=\"gfs-sc__item\"><div class=\"gfs-sc__ic\" aria-hidden=\"true\">{{ E4_ICON }}</div><p class=\"gfs-sc__tx\">{{ E4 }}</p></div>\n  </div>\n  <div class=\"gfs-sc__concl\">{{ CONCL }}</div>\n</div>\n<script>(function(){var s=document.querySelector('.gfs-sc');if(!s)return;if(!('IntersectionObserver' in window)){s.classList.add('gfs-in');return;}var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){s.classList.add('gfs-in');io.unobserve(s);}});},{threshold:.2});io.observe(s);})();</script>\n",
        "color_scheme": "background-1"
      }
    },
    "sec_ya": {
      "type": "custom-liquid",
      "name": "P2 YA LO INTENTASTE (agitar)",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "{% comment %} === COMPONENTE: YA LO INTENTASTE (demoledor de objeciones) === {% endcomment %}\n{% comment %} Fusión \"GOLDEN FULL\" → gfs- tokenizado y accesible (G3.2). {% endcomment %}\n{% comment %} Reconoce las alternativas que el cliente ya probó (con una X roja animada sobre cada una) y remata {% endcomment %}\n{% comment %} con el porqué fallaron + un CTA. Poderoso en verticales donde \"ya probé de todo\". CTA opcional {% endcomment %}\n{% comment %} dispara Releasit vía data-cod (motor COD del config center). {% endcomment %}\n\n{% comment %} 📝 EDITAR AQUI {% endcomment %}\n{% assign TITLE = \"Ya lo intentaste casi todo…\" %}\n{% assign IT1 = \"Cremas de farmacia\" %}\n{% assign IT2 = \"Remedios caseros\" %}\n{% assign IT3 = \"Procedimientos costosos\" %}\n{% assign IT4 = \"Y el problema vuelve\" %}\n{% assign PUNCH1 = \"Y aun así… sigue ahí.\" %}\n{% assign PUNCH2 = \"El problema es que nunca lo atacaste desde la raíz.\" %}\n{% assign CTA_TEXT = \"Quiero solucionarlo\" %}\n\n{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}\n<style>\n.gfs-try{max-width:600px;margin:0 auto;padding:0 20px;text-align:center;box-sizing:border-box;}\n.gfs-try__title{font-weight:800;font-size:24px;color:#1a1a1a;margin:0 0 22px;opacity:0;transform:translateY(16px);transition:opacity .7s cubic-bezier(.16,1,.3,1),transform .7s cubic-bezier(.16,1,.3,1);}\n.gfs-try.gfs-go .gfs-try__title{opacity:1;transform:none;}\n.gfs-try__list{display:inline-flex;flex-direction:column;gap:13px;max-width:90%;margin:0 auto 30px;text-align:left;}\n.gfs-try__item{display:flex;align-items:center;gap:13px;font-weight:700;font-size:17px;color:#555;opacity:0;transform:translateY(18px);transition:opacity .6s cubic-bezier(.16,1,.3,1),transform .6s cubic-bezier(.16,1,.3,1),color .4s ease;}\n.gfs-try__item.gfs-on{opacity:1;transform:none;color:#a0a0a0;}\n.gfs-try__x{flex:0 0 28px;width:28px;height:28px;border-radius:50%;background:#e0533f;color:#fff;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:900;transform:scale(0) rotate(-40deg);transition:transform .5s cubic-bezier(.34,1.56,.64,1);box-shadow:0 5px 14px rgba(224,83,63,.4);}\n.gfs-try__item.gfs-on .gfs-try__x{transform:scale(1) rotate(0);}\n.gfs-try__p1{font-weight:700;font-size:20px;color:#1a1a1a;margin:0 0 4px;opacity:0;transform:translateY(14px);transition:opacity .7s cubic-bezier(.16,1,.3,1),transform .7s cubic-bezier(.16,1,.3,1);}\n.gfs-try__p2{font-weight:900;font-size:25px;line-height:1.25;margin:0;color:var(--brand-dark,#8e1c19);opacity:0;transform:translateY(14px);transition:opacity .7s .12s cubic-bezier(.16,1,.3,1),transform .7s .12s cubic-bezier(.16,1,.3,1);}\n.gfs-try__btn{all:unset;box-sizing:border-box;display:inline-flex;align-items:center;justify-content:center;gap:6px;margin-top:22px;cursor:pointer;font-weight:800;font-size:14px;letter-spacing:.5px;text-transform:uppercase;color:#fff;background:linear-gradient(135deg,var(--cta,#1D9E06),var(--cta-dark,#157A04));padding:14px 28px;border-radius:999px;opacity:0;transform:translateY(10px);transition:opacity .8s .3s,transform .8s .3s,filter .2s;box-shadow:0 10px 24px -6px rgba(var(--cta-rgb,29,158,6),.5),inset 0 1px 0 rgba(255,255,255,.3);}\n.gfs-try__btn:hover{filter:brightness(1.04);}\n.gfs-try__btn:focus-visible{outline:3px solid var(--brand-dark,#8e1c19);outline-offset:3px;}\n.gfs-try.gfs-go .gfs-try__p1,.gfs-try.gfs-go .gfs-try__p2,.gfs-try.gfs-go .gfs-try__btn{opacity:1;transform:none;}\n@media(min-width:990px){.gfs-try{max-width:760px;}.gfs-try__title{font-size:30px;}.gfs-try__list{display:grid;grid-template-columns:1fr 1fr;gap:14px 28px;max-width:680px;}.gfs-try__item{font-size:18px;}.gfs-try__p2{font-size:31px;}}\n@media(prefers-reduced-motion:reduce){.gfs-try *{transition:none !important;opacity:1 !important;transform:none !important;}}\n</style>\n<div class=\"gfs-try\">\n  <p class=\"gfs-try__title\">{{ TITLE }}</p>\n  <div class=\"gfs-try__list\">\n    <div class=\"gfs-try__item\"><span class=\"gfs-try__x\" aria-hidden=\"true\">✕</span><span>{{ IT1 }}</span></div>\n    <div class=\"gfs-try__item\"><span class=\"gfs-try__x\" aria-hidden=\"true\">✕</span><span>{{ IT2 }}</span></div>\n    <div class=\"gfs-try__item\"><span class=\"gfs-try__x\" aria-hidden=\"true\">✕</span><span>{{ IT3 }}</span></div>\n    <div class=\"gfs-try__item\"><span class=\"gfs-try__x\" aria-hidden=\"true\">✕</span><span>{{ IT4 }}</span></div>\n  </div>\n  <p class=\"gfs-try__p1\">{{ PUNCH1 }}</p>\n  <p class=\"gfs-try__p2\">{{ PUNCH2 }}</p>\n  {% if CTA_TEXT != blank %}<button class=\"gfs-try__btn\" type=\"button\" data-cod=\"1\">{{ CTA_TEXT }} →</button>{% endif %}\n</div>\n<script>(function(){var s=document.querySelector('.gfs-try');if(!s)return;var items=s.querySelectorAll('.gfs-try__item');if(!('IntersectionObserver' in window)){s.classList.add('gfs-go');items.forEach(function(it){it.classList.add('gfs-on');});return;}var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){s.classList.add('gfs-go');items.forEach(function(it,i){setTimeout(function(){it.classList.add('gfs-on');},300*(i+1));});io.unobserve(s);}});},{threshold:.3});io.observe(s);})();</script>\n",
