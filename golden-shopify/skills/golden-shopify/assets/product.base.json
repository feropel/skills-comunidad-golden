-banner__box{max-width:{{ BOX_MAX_WIDTH_DESKTOP }};margin:0 auto;background:{{ BG_COLOR }};border:{{ BORDER_WIDTH }} solid {{ BORDER_COLOR }};border-radius:{{ BORDER_RADIUS }};padding:{{ PADDING_Y_DESKTOP }} {{ PADDING_X_DESKTOP }};color:{{ TEXT_COLOR }};font-size:{{ FONT_SIZE_DESKTOP }};font-weight:{{ FONT_WEIGHT }};font-family:{{ FONT_FAMILY }};text-transform:uppercase;text-align:center;line-height:{{ LINE_HEIGHT }};letter-spacing:0.4px;box-sizing:border-box;}\n.mb-line-1{display:block;}\n.mb-line-2{display:block;margin-top:1px;font-size:{{ SUBTEXT_SCALE }}em;opacity:0.9;}\n\n/* ========================\n   MOBILE\n======================== */\n@media (max-width:749px){\n  .mb-banner__box{\n    max-width:{{ BOX_MAX_WIDTH_MOBILE }};\n    padding:{{ PADDING_Y_MOBILE }} {{ PADDING_X_MOBILE }};\n    font-size:{{ FONT_SIZE_MOBILE }};\n  }\n  .mb-line-2{\n    font-size:0.75em;\n  }\n}\n</style>"
