    "sec_autoridad": {
      "type": "custom-liquid",
      "name": "BANDA DE AUTORIDAD",
      "settings": {
        "visibility": "always-display",
        "custom_liquid": "{%- comment -%} ═══ 📝 BANDA DE AUTORIDAD — solo cifras REALES de la tienda ═══ {%- endcomment -%}\n{% assign ITEMS = \"Tienda verificada|+5.000 órdenes entregadas|Fabricado y testeado en laboratorio|Pagas al recibir, a tu puerta\" %}\n{% assign SEP_EMOJI = \"★\" %}\n{% assign SPEED = \"26s\" %}\n{%- comment -%} ═══ ↓ NO TOCAR ↓ ═══ {%- endcomment -%}\n<style>\n.gfs-auth{margin:22px 0;padding:13px 0;background:linear-gradient(135deg,var(--brand-primary),var(--brand-dark));overflow:hidden;position:relative;}\n.gfs-auth__track{display:flex;width:max-content;animation:gfsAuthScroll var(--sp,26s) linear infinite;}\n.gfs-auth:hover .gfs-auth__track{animation-play-state:paused;}\n.gfs-auth__item{display:inline-flex;align-items:center;gap:10px;padding:0 26px;font-size:14px;font-weight:800;color:#fff;letter-spacing:.4px;text-transform:uppercase;white-space:nowrap;}\n.gfs-auth__sep{color:rgba(255,255,255,.55);font-size:12px;}\n@keyframes gfsAuthScroll{0%{transform:translateX(0);}100%{transform:translateX(-50%);}}\n@media(min-width:750px){.gfs-auth__item{font-size:16px;padding:0 34px;}}\n</style>\n<div class=\"gfs-auth\" style=\"--sp:{{ SPEED }};\"><div class=\"gfs-auth__track\">{% assign LIST = ITEMS | split: '|' %}{% for pass in (1..2) %}{% for it in LIST %}<span class=\"gfs-auth__item\">{{ it }}<span class=\"gfs-auth__sep\">{{ SEP_EMOJI }}</span></span>{% endfor %}{% endfor %}</div></div>",
