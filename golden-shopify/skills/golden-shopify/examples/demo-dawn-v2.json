/*
 * EJEMPLO DE REFERENCIA — GOLDEN SHOPIFY (Dawn) · arquitectura G3.7 (embudo canónico 17 secciones).
 * Dawn: tickers custom-liquid, color_scheme scheme-1. La plantilla 'down' que se enseña/regala.
 */
{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "config_center": {
          "type": "custom_liquid",
          "name": "0 CONFIG CENTER (Paleta & Marca)",
          "settings": {
            "custom_liquid": "{%- comment -%}\n═══════════════════════════════════════════════════\n  🎨 PALETA & MARCA — CENTRO DE CONTROL\n  Cambia AQUI los colores y datos. Todo lo demas hereda.\n  CTA = verde ganador #1D9E06 (REGLA #2, NO cambiar).\n═══════════════════════════════════════════════════\n{%- endcomment -%}\n\n{% assign BRAND_NAME       = \"PRODUCTO DEMO\" %}\n{% assign BRAND_PRIMARY    = \"#0E9B8E\" %}\n{% assign BRAND_DARK       = \"#0A6F66\" %}\n{% assign BRAND_BRIGHT     = \"#16C8B6\" %}\n{% assign BRAND_LIGHT      = \"#E7F7F4\" %}\n{% assign BRAND_TEXT       = \"#ffffff\" %}\n{% assign BRAND_TEXT_HOVER = \"#D2F1EC\" %}\n\n{% comment %} CTA fijo — VERDE GANADOR (REGLA #2) {% endcomment %}\n{% assign CTA_BG       = \"#1D9E06\" %}\n{% assign CTA_BG_DARK  = \"#157A04\" %}\n{% assign CTA_BG_RGB   = \"29,158,6\" %}\n\n{% comment %} 📝 WhatsApp: numero con codigo de pais {% endcomment %}\n{% assign WHATSAPP_NUMBER  = \"573001234567\" %}\n{% assign WHATSAPP_MESSAGE = \"Hola, quiero información de PRODUCTO DEMO 🌿\" %}\n\n{% assign REVIEW_COUNT     = \"3\" %}\n{% assign RATING_VALUE     = \"5.0\" %}\n\n{% assign GFS_VERSION      = \"v1.31\" %}\n{% assign GFS_DATE         = \"2026-06-19\" %}\n\n{% assign BRAND_PRIMARY_RGB = \"14,155,142\" %}\n{% assign BRAND_DARK_RGB    = \"10,111,102\" %}\n{% assign BRAND_BRIGHT_RGB  = \"22,200,182\" %}\n\n{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}\n<!-- Generado con GOLDEN FULL SHOPIFY {{ GFS_VERSION }} · {{ BRAND_NAME }} · {{ GFS_DATE }} -->\n<style id=\"gfs-brand-tokens\">\n:root{\n  --brand-name: \"{{ BRAND_NAME }}\";\n  --brand-primary: {{ BRAND_PRIMARY }};\n  --brand-dark: {{ BRAND_DARK }};\n  --brand-bright: {{ BRAND_BRIGHT }};\n  --brand-light: {{ BRAND_LIGHT }};\n  --brand-text: {{ BRAND_TEXT }};\n  --brand-text-hover: {{ BRAND_TEXT_HOVER }};\n  --brand-primary-rgb: {{ BRAND_PRIMARY_RGB }};\n  --brand-dark-rgb: {{ BRAND_DARK_RGB }};\n  --brand-bright-rgb: {{ BRAND_BRIGHT_RGB }};\n  --cta: {{ CTA_BG }};\n  --cta-dark: {{ CTA_BG_DARK }};\n  --cta-rgb: {{ CTA_BG_RGB }};\n}\n.gfs-faq,.gfs-ship,.gfs-lad,.gfs-steps,.gfs-reviews,.gfs-why,.pe-manifesto{content-visibility:auto;contain-intrinsic-size:auto 600px;}@media(min-width:990px){.gfs-lad,.gfs-steps,.gfs-reviews,.gfs-why,.pe-pyramid{max-width:1140px !important;}.gfs-faq{max-width:920px !important;}.gfs-mid-cta{max-width:560px !important;}}@media(min-width:1400px){.gfs-lad,.gfs-steps,.gfs-reviews,.gfs-why,.pe-pyramid{max-width:1280px !important;}}\n</style>\n<script>\nwindow.GFS_BRAND = {\n  name:        {{ BRAND_NAME | json }},\n  primary:     {{ BRAND_PRIMARY | json }},\n  dark:        {{ BRAND_DARK | json }},\n  bright:      {{ BRAND_BRIGHT | json }},\n  light:       {{ BRAND_LIGHT | json }},\n  whatsapp:    {{ WHATSAPP_NUMBER | json }},\n  whatsappMsg: {{ WHATSAPP_MESSAGE | json }},\n  reviewCount: {{ REVIEW_COUNT | json }},\n  ratingValue: {{ RATING_VALUE | json }}\n};\n</script>"
          }
        },
        "propuesta": {
          "type": "custom_liquid",
          "name": "1 PROPUESTA / EYEBROW + SCHEMA",
          "settings": {
            "custom_liquid": "{%- comment -%}\n═══ 📝 EDITAR AQUI — EYEBROW DE BENEFICIO (encima del titulo) ═══\n{%- endcomment -%}\n\n{% assign BADGE_TEXT    = \"ALIENTO FRESCO DESDE ADENTRO\" %}\n{% assign SUBTITLE_TEXT = \"Para cuando el mal aliento vuelve aunque te cepilles\" %}\n\n{%- comment -%} ═══ ↓ NO TOCAR ↓ ═══ {%- endcomment -%}\n<style>\n@keyframes mbPulse{0%{transform:scale(1)}50%{transform:scale(1.03)}100%{transform:scale(1)}}\n.mb-header-wrapper{display:flex;flex-direction:column;align-items:center;gap:5px;margin:4px 0 6px;}\n.mb-badge{background:linear-gradient(135deg,var(--brand-primary),var(--brand-dark));color:#fff;padding:8px 22px;font-size:15px;font-weight:800;border-radius:10px;text-transform:uppercase;text-align:center;line-height:1.15;letter-spacing:.4px;animation:mbPulse 2.4s infinite ease-in-out;box-shadow:0 4px 14px rgba(var(--brand-primary-rgb),.35);}\n.mb-subtitle{color:var(--brand-dark);font-size:14px;text-align:center;font-weight:600;max-width:340px;line-height:1.3;font-style:italic;}\n@media(max-width:749px){.mb-badge{font-size:13px;padding:7px 14px;}.mb-subtitle{font-size:13px;max-width:92%;}}\n.gfs-guarantee,.gfs-ship{opacity:0;transform:translateY(26px);transition:opacity .8s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1);}\n.pe-revealed{opacity:1 !important;transform:translateY(0) !important;}\n.header__icon[href*=\"/cart\"] svg,.header__icon--cart svg,header a[href*=\"/cart\"] svg{color:var(--brand-primary) !important;}\n</style>\n<div class=\"mb-header-wrapper\"><div class=\"mb-badge\">{{ BADGE_TEXT }}</div><div class=\"mb-subtitle\">{{ SUBTITLE_TEXT }}</div></div>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Product\",\n  \"name\": {{ product.title | json }},\n  \"image\": [{% for img in product.images limit:4 %}\"https:{{ img | image_url: width: 1200 }}\"{% unless forloop.last %},{% endunless %}{% endfor %}],\n  \"description\": {{ product.description | strip_html | truncate: 300 | json }},\n  \"brand\": { \"@type\": \"Brand\", \"name\": {{ shop.name | json }} },\n  \"offers\": {\n    \"@type\": \"Offer\",\n    \"url\": \"{{ shop.url }}{{ product.url }}\",\n    \"priceCurrency\": \"{{ cart.currency.iso_code }}\",\n    \"price\": \"{{ product.selected_or_first_available_variant.price }}\",\n    \"availability\": \"{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}\",\n    \"itemCondition\": \"https://schema.org/NewCondition\"\n  },\n  \"aggregateRating\": { \"@type\": \"AggregateRating\", \"ratingValue\": \"5.0\", \"reviewCount\": \"3\", \"bestRating\": \"5\" }\n}\n</script>\n\n{%- comment -%} Footer en color de marca (solo en esta pagina) {%- endcomment -%}\n<style>\nfooter.footer,.shopify-section-group-footer-group,.shopify-section-group-footer-group section,.shopify-section-group-footer-group [class*=\"color-\"]{background:var(--brand-primary) !important;background-image:none !important;}\nfooter.footer p,footer.footer a,footer.footer span,footer.footer h1,footer.footer h2,footer.footer h3,footer.footer li,footer.footer small,.shopify-section-group-footer-group p,.shopify-section-group-footer-group a,.shopify-section-group-footer-group span,.shopify-section-group-footer-group h2,.shopify-section-group-footer-group li{color:#fff !important;}\nfooter.footer a:hover,.shopify-section-group-footer-group a:hover{color:var(--brand-text-hover) !important;}\n</style>\n\n<script>\ndocument.addEventListener('DOMContentLoaded',function(){var sel='.gfs-guarantee,.gfs-ship';function inView(el){var r=el.getBoundingClientRect();return r.top<window.innerHeight*0.95&&r.bottom>0;}var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('pe-revealed');io.unobserve(e.target);}});},{threshold:0.12,rootMargin:'0px 0px -40px 0px'});document.querySelectorAll(sel).forEach(function(el){if(inView(el))el.classList.add('pe-revealed');else io.observe(el);});});\n</script>"
          }
        },
        "titulo": {
          "type": "custom_liquid",
          "name": "2 TITULO DEL PRODUCTO",
          "settings": {
            "custom_liquid": "{%- comment -%} ═══ 📝 TITULO (texto del producto) ═══ {%- endcomment -%}\n{% assign TITLE_COLOR = \"#1a1a1a\" %}\n{% assign TITLE_SIZE_MOBILE = \"23px\" %}\n{% assign TITLE_SIZE_DESKTOP = \"30px\" %}\n{%- comment -%} ═══ ↓ NO TOCAR ↓ ═══ {%- endcomment -%}\n<style>\n.pe-ptitle{text-align:center;max-width:580px;margin:10px auto 4px;padding:0 14px;box-sizing:border-box;}\n.pe-ptitle h1{margin:0;font-size:{{ TITLE_SIZE_MOBILE }};line-height:1.3;font-weight:800;color:{{ TITLE_COLOR }};letter-spacing:-.2px;}\n.pe-ptitle__line{width:54px;height:3px;background:var(--brand-primary);border-radius:3px;margin:12px auto 0;}\n@media(min-width:990px){.pe-ptitle h1{font-size:{{ TITLE_SIZE_DESKTOP }};}}\n</style>\n<div class=\"pe-ptitle\"><h1>{{ product.title }}</h1><div class=\"pe-ptitle__line\"></div></div>"
          }
        },
        "oferta": {
          "type": "custom_liquid",
          "name": "3 OFERTA DESTACADA",
          "settings": {
            "custom_liquid": "{%- comment -%} ═══ 📝 OFERTA DESTACADA ═══ {%- endcomment -%}\n{% assign LINE_1 = \"OFERTA EXCLUSIVA\" %}\n{% assign LINE_2 = \"POR TIEMPO LIMITADO\" %}\n{%- comment -%} ═══ ↓ NO TOCAR ↓ ═══ {%- endcomment -%}\n<style>\n.mb-banner{width:100%;margin:6px 0 2px;}\n.mb-banner__inner{max-width:1200px;margin:0 auto;text-align:center;}\n.mb-banner__box{max-width:520px;margin:0 auto;background:var(--brand-light);border:2px solid var(--brand-primary);border-radius:12px;padding:10px 20px;color:var(--brand-dark);font-size:22px;font-weight:800;text-transform:uppercase;text-align:center;line-height:1.1;letter-spacing:.4px;box-sizing:border-box;}\n.mb-line-1{display:block;}\n.mb-line-2{display:block;margin-top:1px;font-size:.7em;opacity:.9;}\n@media(max-width:749px){.mb-banner__box{max-width:96%;padding:10px;font-size:17px;}.mb-line-2{font-size:.75em;}}\n</style>\n<section class=\"mb-banner\"><div class=\"mb-banner__inner\"><div class=\"mb-banner__box\"><span class=\"mb-line-1\">{{ LINE_1 }}</span><span class=\"mb-line-2\">{{ LINE_2 }}</span></div></div></section>"
          }
        },
        "countdown": {
          "type": "custom_liquid",
          "name": "4 OFERTA TERMINA EN",
          "settings": {
            "custom_liquid": "{%- comment -%} ═══ 📝 COUNTDOWN 15 min evergreen ═══ {%- endcomment -%}\n{% assign LABEL_TEXT = \"⏰ La oferta termina en\" %}\n{% assign DURATION_MINUTES = 15 %}\n{%- comment -%} ═══ ↓ NO TOCAR ↓ ═══ {%- endcomment -%}\n<style>\n.gfs-cd{display:flex;align-items:center;justify-content:center;gap:8px;max-width:520px;margin:10px auto 0;padding:9px 14px;background:var(--brand-light);border:1px dashed var(--brand-primary);border-radius:10px;box-sizing:border-box;}\n.gfs-cd__label{font-size:14px;font-weight:600;color:#1a1a1a;}\n.gfs-cd__time{display:inline-block;min-width:54px;text-align:center;font-size:18px;font-weight:800;color:#fff;background:linear-gradient(135deg,var(--brand-primary),var(--brand-dark));padding:4px 12px;border-radius:6px;letter-spacing:.5px;box-shadow:0 3px 10px rgba(var(--brand-primary-rgb),.4);font-variant-numeric:tabular-nums;}\n</style>\n<div class=\"gfs-cd\"><span class=\"gfs-cd__label\">{{ LABEL_TEXT }}</span><span class=\"gfs-cd__time\" id=\"gfs-cd-time\">{{ DURATION_MINUTES }}:00</span></div>\n<script>(function(){var D={{ DURATION_MINUTES }}*60*1000;var K='gfs_cd_end';var el=document.getElementById('gfs-cd-time');if(!el)return;var end=parseInt(localStorage.getItem(K)||'0',10);if(!end||end<Date.now()){end=Date.now()+D;localStorage.setItem(K,end);}function t(){var d=end-Date.now();if(d<=0){end=Date.now()+D;localStorage.setItem(K,end);d=D;}var m=Math.floor(d/60000);var s=Math.floor((d%60000)/1000);el.textContent=(m<10?'0':'')+m+':'+(s<10?'0':'')+s;}t();setInterval(t,1000);})();</script>"
          }
        },
        "verificado": {
          "type": "custom_liquid",
          "name": "5 CALIFICACION (reseñas reales)",
          "settings": {
            "custom_liquid": "{%- comment -%}\n═══ 📝 CALIFICACION REAL (5.0 · 3 reseñas verificadas, fuente Trustoo) ═══\n{%- endcomment -%}\n{% assign RATING_VALUE = \"5.0\" %}\n{% assign RATING_TEXT  = \"· 3 reseñas verificadas\" %}\n{%- comment -%} ═══ ↓ NO TOCAR ↓ ═══ {%- endcomment -%}\n<style>\n.gfs-rating{display:flex;align-items:center;justify-content:center;gap:8px;margin:6px 0 -4px;}\n.gfs-rating .stars svg{display:inline-block;}\n.gfs-rating__num{font-size:14px;color:#555;font-weight:600;}\n.gfs-rating__num b{color:#1a1a1a;font-weight:800;}\n</style>\n<div class=\"gfs-rating\"><div class=\"stars\">{% for i in (1..5) %}<svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\"><path fill=\"var(--brand-primary)\" d=\"M10 15l-5.878 3.09 1.123-6.545L.49 6.91l6.561-.954L10 0l2.949 5.956 6.561.954-4.755 4.635 1.123 6.545z\"/></svg>{% endfor %}</div><div class=\"gfs-rating__num\"><b>{{ RATING_VALUE }}</b>/5 {{ RATING_TEXT }}</div></div>"
          }
        },
        "precio": {
          "type": "custom_liquid",
          "name": "6 PRECIO DINAMICO",
          "settings": {
            "custom_liquid": "{%- comment -%} ═══ PRECIO DINAMICO — lee precio y compare_at_price (NO hardcodear) ═══ {%- endcomment -%}\n<script>\nwindow.PRICE_CONFIG = {\n  align: \"center\", priceSize: \"30px\", priceWeight: \"700\", priceColor: \"#2E2A39\",\n  compareSize: \"20px\", compareColor: \"#888\", compareSpacing: \"12px\",\n  badgeText: \"Oferta\", badgeBg: \"var(--brand-primary)\", badgeColor: \"#FFFFFF\", badgeSize: \"14px\", badgeRadius: \"10px\", badgePaddingY: \"4px\", badgePaddingX: \"8px\",\n  savingTextPrefix: \"💸 Estás ahorrando\", savingSize: \"15px\", savingColor: \"#0A6F66\", savingWeight: \"700\", savingMarginTop: \"-6px\",\n  fontFamily: \"inherit\"\n};\n</script>\n<div class=\"custom-price-section\"><div class=\"custom-price-wrapper\"><span class=\"custom-price\">{{ product.selected_or_first_available_variant.price | money }}</span>{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}<span class=\"custom-compare-price\">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span><span class=\"custom-badge\"></span>{% endif %}</div>{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}<div class=\"custom-saving\"></div>{% endif %}</div>\n<style>\n.custom-price-section{text-align:var(--align);font-family:var(--ff);}\n.custom-price-wrapper{display:inline-flex;align-items:center;justify-content:center;}\n.custom-price{font-size:var(--ps);font-weight:var(--pw);color:var(--pc);}\n.custom-compare-price{font-size:var(--cs);text-decoration:line-through;color:var(--cc);margin-left:var(--csp);}\n.custom-badge{background:var(--bbg);color:var(--btc);font-size:var(--bs);padding:var(--bpy) var(--bpx);border-radius:var(--br);margin-left:var(--csp);}\n.custom-saving{margin-top:var(--smt);font-size:var(--ss);color:var(--sc);font-weight:var(--sw);}\n</style>\n<script>(function(){var c=window.PRICE_CONFIG;var root=document.querySelector('.custom-price-section');if(!root)return;root.style.setProperty('--align',c.align);root.style.setProperty('--ff',c.fontFamily);root.style.setProperty('--ps',c.priceSize);root.style.setProperty('--pw',c.priceWeight);root.style.setProperty('--pc',c.priceColor);root.style.setProperty('--cs',c.compareSize);root.style.setProperty('--cc',c.compareColor);root.style.setProperty('--csp',c.compareSpacing);root.style.setProperty('--bbg',c.badgeBg);root.style.setProperty('--btc',c.badgeColor);root.style.setProperty('--bs',c.badgeSize);root.style.setProperty('--br',c.badgeRadius);root.style.setProperty('--bpy',c.badgePaddingY);root.style.setProperty('--bpx',c.badgePaddingX);root.style.setProperty('--ss',c.savingSize);root.style.setProperty('--sc',c.savingColor);root.style.setProperty('--sw',c.savingWeight);root.style.setProperty('--smt',c.savingMarginTop);var b=root.querySelector('.custom-badge');if(b)b.innerText=c.badgeText;var s=root.querySelector('.custom-saving');if(s){s.innerText=c.savingTextPrefix+' '+'{{ product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price | money }}';}})();</script>"
          }
        },
        "releasit_cod_form_button": {
          "type": "shopify://apps/releasit-cod-form/blocks/button-app-block/72faf214-4174-4fec-886b-0d0e8d3af9a2",
          "name": "7 BOTON RELEASIT (motor — NO TOCAR)",
          "disabled": true,
          "settings": {
            "product": "{{product}}"
          }
        },
        "boton": {
          "type": "custom_liquid",
          "name": "8 BOTON DE COMPRA",
          "settings": {
            "custom_liquid": "{%- comment -%} ═══ BOTON DE COMPRA — dispara Releasit. CTA VERDE #1D9E06 (REGLA #2) ═══ {%- endcomment -%}\n<script>\nwindow.RELEASIT_BUTTON_CONFIG = {\n  text: \"QUIERO MI PRODUCTO 🔥 \",\n  width: \"100%\", height: \"58px\",\n  paddingY: \"14px\", paddingX: \"20px\", marginTop: \"12px\", marginBottom: \"12px\",\n  bgColor: \"var(--cta)\", bgColorHover: \"#157A04\",\n  textColor: \"#FFFFFF\", fontSize: \"17px\", fontWeight: \"800\", letterSpacing: \"0.5px\",\n  borderWidth: \"1px\", borderStyle: \"solid\", borderColor: \"#FFFFFF\", borderRadius: \"16px\",\n  shadowColor: \"rgba(21,122,4,0.45)\", shadowBlur: \"22px\", shadowOffsetY: \"8px\",\n  hoverScale: 1.04, animation: \"pulse\", animationSpeed: \"1.8s\", textOffsetX: \"0px\"\n};\n</script>\n<button id=\"custom-releasit-btn\" type=\"button\"><span></span></button>\n<style>\n#_rsi-buy-now-button-floating,._rsi-buy-now-button-product-floating{display:none !important;}\n._rsi-buy-now-button-cart:not([data-gfs-painted=\"1\"]),._rsi-build-block-submit-button ._rsi-modal-submit-button:not([data-gfs-painted=\"1\"]){opacity:0 !important;transition:opacity .25s ease !important;}\n._rsi-buy-now-button-cart[data-gfs-painted=\"1\"],._rsi-build-block-submit-button ._rsi-modal-submit-button[data-gfs-painted=\"1\"]{opacity:1 !important;}\n#custom-releasit-btn{all:unset;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;cursor:pointer;user-select:none;transition:all .25s ease;box-sizing:border-box;}\n#custom-releasit-btn:hover{transform:scale(var(--hs));background:var(--bh);}\n#custom-releasit-btn span{position:relative;z-index:2;transform:translateX(var(--tox));text-align:center;line-height:1.25;}\n#custom-releasit-btn::before{content:\"\";position:absolute;top:0;left:-100%;width:60%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.45),transparent);animation:ggBtnShine 3.5s infinite;pointer-events:none;z-index:1;}\n@keyframes ggBtnShine{0%{left:-100%;}40%{left:140%;}100%{left:140%;}}\n@keyframes pulse{0%{transform:scale(1)}50%{transform:scale(1.05)}100%{transform:scale(1)}}\n</style>\n<script>(function(){var c=window.RELEASIT_BUTTON_CONFIG;var b=document.getElementById('custom-releasit-btn');if(!b)return;b.querySelector('span').innerText=c.text;b.style.width=c.width;b.style.height=c.height;b.style.padding=c.paddingY+' '+c.paddingX;b.style.marginTop=c.marginTop;b.style.marginBottom=c.marginBottom;b.style.background=c.bgColor;b.style.color=c.textColor;b.style.fontSize=c.fontSize;b.style.fontWeight=c.fontWeight;b.style.letterSpacing=c.letterSpacing;b.style.border=c.borderWidth+' '+c.borderStyle+' '+c.borderColor;b.style.borderRadius=c.borderRadius;b.style.boxShadow='0 '+c.shadowOffsetY+' '+c.shadowBlur+' '+c.shadowColor;b.style.setProperty('--hs',c.hoverScale);b.style.setProperty('--bh',c.bgColorHover);b.style.setProperty('--tox',c.textOffsetX);if(c.animation==='pulse')b.style.animation='pulse '+c.animationSpeed+' infinite';b.addEventListener('click',function(){var r=document.querySelector('#_rsi-buy-now-button-overwrite, ._rsi-buy-now-button');if(r)r.click();});})();</script>\n\n{%- comment -%} ═══ 📝 COLOR DE LOS BOTONES DE RELEASIT ═══ {%- endcomment -%}\n{% assign RSI_PRIMARY_BG = \"var(--cta)\" %}\n{% assign RSI_SECONDARY_BG = \"\" %}\n{% assign RSI_TEXT = \"#ffffff\" %}\n{%- comment -%} ═══ ↓ NO TOCAR ↓ ═══ {%- endcomment -%}\n<script>(function(){var P=\"{{ RSI_PRIMARY_BG }}\",S=\"{{ RSI_SECONDARY_BG }}\",T=\"{{ RSI_TEXT }}\";function paintEl(el,bg){if(!el||!bg)return;el.style.setProperty('background',bg,'important');el.style.setProperty('background-color',bg,'important');if(T)el.style.setProperty('color',T,'important');el.setAttribute('data-gfs-painted','1');}function paint(){if(P){document.querySelectorAll('._rsi-build-block-submit-button ._rsi-modal-submit-button').forEach(function(el){paintEl(el,P);});document.querySelectorAll('._rsi-buy-now-button-cart').forEach(function(el){paintEl(el,P);});}if(S){document.querySelectorAll('._rsi-build-block-custom-button ._rsi-buy-now-custom-additionals-button').forEach(function(el){paintEl(el,S);});}try{var cfg=window.RELEASIT_BUTTON_CONFIG;if(cfg&&cfg.text){document.querySelectorAll('._rsi-buy-now-button-cart').forEach(function(el){var sp=el.querySelector('span');if(sp&&sp.textContent.trim()!==cfg.text.trim())sp.textContent=cfg.text;else if(!sp&&el.textContent.trim()!==cfg.text.trim())el.textContent=cfg.text;});}}catch(e){}}function init(){paint();var throttle=null;function tPaint(){if(throttle)return;throttle=setTimeout(function(){throttle=null;paint();},120);}var mo=new MutationObserver(function(muts){for(var i=0;i<muts.length;i++)if(muts[i].addedNodes.length){tPaint();return;}});if(document.body)mo.observe(document.body,{childList:true,subtree:true});document.addEventListener('click',function(){paint();setTimeout(paint,40);setTimeout(paint,160);setTimeout(paint,400);},true);}if(document.body){init();}else if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init);}else{init();}})();</script>"
          }
        },
        "garantia": {
          "type": "custom_liquid",
          "name": "9 COMPRA SEGURA",
          "settings": {
            "custom_liquid": "{%- comment -%} ═══ 📝 COMPRA SEGURA (MODE: contraentrega | anticipado | ambos) ═══ {%- endcomment -%}\n{% assign MODE = \"ambos\" %}\n{% assign TITLE_PART1 = \"Compra\" %}\n{% assign TITLE_PART2 = \"100% Segura\" %}\n{% assign SEAL_EMOJI = \"🛡️\" %}\n{%- comment -%} ═══ ↓ NO TOCAR ↓ ═══ {%- endcomment -%}\n<style>\n.gfs-guarantee{max-width:480px;margin:14px auto;background:var(--brand-light);border:1px solid rgba(var(--brand-primary-rgb),.3);border-radius:16px;padding:14px 16px;display:flex;align-items:center;gap:12px;box-sizing:border-box;text-align:left;box-shadow:0 8px 28px rgba(var(--brand-primary-rgb),.10),inset 0 1px 0 rgba(255,255,255,.5);}\n.gfs-guarantee__seal{flex:0 0 44px;width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--brand-primary),var(--brand-dark));display:flex;align-items:center;justify-content:center;font-size:22px;box-shadow:0 4px 12px rgba(var(--brand-primary-rgb),.4),inset 0 1px 0 rgba(255,255,255,.3);}\n.gfs-guarantee__title{font-size:14px;font-weight:800;color:#1a1a1a;margin:0 0 2px;text-transform:uppercase;letter-spacing:.3px;}\n.gfs-guarantee__title span{color:var(--brand-dark);}\n.gfs-guarantee__text{font-size:13px;color:#444;line-height:1.4;margin:0;}\n.gfs-guarantee__text strong{color:#1a1a1a;}\n</style>\n<div class=\"gfs-guarantee\"><div class=\"gfs-guarantee__seal\">{{ SEAL_EMOJI }}</div><div><p class=\"gfs-guarantee__title\">{{ TITLE_PART1 }} <span>{{ TITLE_PART2 }}</span></p><p class=\"gfs-guarantee__text\">{%- if MODE == \"anticipado\" -%}<strong>Pago 100% seguro</strong> con tarjetas, PSE o transferencia. Producto sellado, entregado en perfecto estado.{%- elsif MODE == \"ambos\" -%}Elige cómo pagar: <strong>contra entrega</strong> al recibir o <strong>pago anticipado</strong> seguro online. Producto sellado y en perfecto estado.{%- else -%}<strong>Pagas al recibir</strong> en la puerta de tu casa — sin transferencias ni adelantos. Producto sellado y en perfecto estado.{%- endif -%}</p></div></div>"
          }
        },
        "barra_logistica": {
          "type": "custom_liquid",
          "name": "10 BARRA LOGISTICA (Colombia)",
          "settings": {
            "custom_liquid": "{%- comment -%} ═══ 📝 BARRA LOGISTICA (Colombia: 3 a 7 días) ═══ {%- endcomment -%}\n{% assign HEADER_TITLE = \"Así llega tu pedido\" %}\n{% assign HEADER_SUB = \"Pagas al recibir, en la puerta de tu casa\" %}\n{% assign STEP_1_TITLE = \"Pedido\" %}{% assign STEP_1_TEXT = \"Hoy mismo\" %}\n{% assign STEP_2_TITLE = \"En camino\" %}{% assign STEP_2_TEXT = \"2 a 3 días\" %}\n{% assign STEP_3_TITLE = \"Entrega\" %}{% assign STEP_3_TEXT = \"3 a 7 días\" %}\n{%- comment -%} ═══ ↓ NO TOCAR ↓ ═══ {%- endcomment -%}\n<style>\n.gfs-ship{max-width:560px;margin:18px auto;box-sizing:border-box;padding:18px 14px;background:linear-gradient(135deg,var(--brand-light) 0%,#ffffff 100%);border:1px solid rgba(var(--brand-primary-rgb),.15);border-radius:16px;box-shadow:0 8px 24px rgba(var(--brand-primary-rgb),.07);}\n.gfs-ship__head{text-align:center;margin-bottom:14px;}\n.gfs-ship__title{font-size:15px;font-weight:800;color:#1a1a1a;letter-spacing:.3px;margin:0 0 3px;text-transform:uppercase;}\n.gfs-ship__sub{font-size:12px;color:#777;font-style:italic;margin:0;}\n.gfs-ship__steps{display:flex;flex-direction:row;align-items:flex-start;justify-content:space-between;gap:0;position:relative;}\n.gfs-ship__step{flex:0 0 auto;display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;padding:0 4px;max-width:95px;transition:transform .3s cubic-bezier(.16,1,.3,1);}\n.gfs-ship__step:hover{transform:translateY(-3px);}\n.gfs-ship__icon{flex:0 0 44px;width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--brand-primary),var(--brand-dark));display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(var(--brand-primary-rgb),.4),inset 0 1px 0 rgba(255,255,255,.25);animation:gfsShipPulse 2.8s ease-in-out infinite;}\n.gfs-ship__step:nth-child(3) .gfs-ship__icon{animation-delay:.5s;}\n.gfs-ship__step:nth-child(5) .gfs-ship__icon{animation-delay:1s;}\n.gfs-ship__icon svg{width:22px;height:22px;}\n.gfs-ship__h3{font-size:12px;font-weight:800;color:#1a1a1a;margin:0 0 2px;text-transform:uppercase;letter-spacing:.4px;line-height:1.15;}\n.gfs-ship__p{font-size:11.5px;color:#555;margin:0;line-height:1.3;font-weight:600;}\n.gfs-ship__line{flex:1 1 auto;height:3px;margin:20px 2px 0;border-radius:3px;background:linear-gradient(90deg,var(--brand-primary) 0%,rgba(var(--brand-primary-rgb),.25) 100%);position:relative;overflow:hidden;}\n.gfs-ship__line::after{content:\"\";position:absolute;top:0;left:-30%;width:30%;height:100%;background:linear-gradient(90deg,transparent,var(--brand-bright),transparent);animation:gfsShipFlowH 2.5s ease-in-out infinite;}\n@keyframes gfsShipPulse{0%,100%{transform:scale(1);}50%{transform:scale(1.07);}}\n@keyframes gfsShipFlowH{0%{left:-30%;opacity:0;}30%{opacity:1;}70%{opacity:1;}100%{left:100%;opacity:0;}}\n@media(min-width:750px){.gfs-ship{max-width:820px;padding:28px 24px;}.gfs-ship__title{font-size:22px;}.gfs-ship__sub{font-size:14.5px;}.gfs-ship__step{max-width:180px;gap:12px;}.gfs-ship__icon{flex:0 0 64px;width:64px;height:64px;}.gfs-ship__icon svg{width:32px;height:32px;}.gfs-ship__h3{font-size:15px;}.gfs-ship__p{font-size:14px;}.gfs-ship__line{height:4px;margin:30px 8px 0;}}\n</style>\n<div class=\"gfs-ship\"><div class=\"gfs-ship__head\"><p class=\"gfs-ship__title\">{{ HEADER_TITLE }}</p><p class=\"gfs-ship__sub\">{{ HEADER_SUB }}</p></div><div class=\"gfs-ship__steps\"><div class=\"gfs-ship__step\"><div class=\"gfs-ship__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 3h2l2.5 10h10l2-7H7\"/><circle cx=\"10\" cy=\"20\" r=\"1.5\" fill=\"#fff\" stroke=\"none\"/><circle cx=\"18\" cy=\"20\" r=\"1.5\" fill=\"#fff\" stroke=\"none\"/></svg></div><div class=\"gfs-ship__body\"><h3 class=\"gfs-ship__h3\">{{ STEP_1_TITLE }}</h3><p class=\"gfs-ship__p\">{{ STEP_1_TEXT }}</p></div></div><div class=\"gfs-ship__line\"></div><div class=\"gfs-ship__step\"><div class=\"gfs-ship__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 7h13v7H3zM16 10h4l2 3v4h-6z\"/><circle cx=\"7\" cy=\"18\" r=\"2\" fill=\"#fff\" stroke=\"none\"/><circle cx=\"17\" cy=\"18\" r=\"2\" fill=\"#fff\" stroke=\"none\"/></svg></div><div class=\"gfs-ship__body\"><h3 class=\"gfs-ship__h3\">{{ STEP_2_TITLE }}</h3><p class=\"gfs-ship__p\">{{ STEP_2_TEXT }}</p></div></div><div class=\"gfs-ship__line\"></div><div class=\"gfs-ship__step\"><div class=\"gfs-ship__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 11l9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1V11z\"/></svg></div><div class=\"gfs-ship__body\"><h3 class=\"gfs-ship__h3\">{{ STEP_3_TITLE }}</h3><p class=\"gfs-ship__p\">{{ STEP_3_TEXT }}</p></div></div></div></div>"
          }
        },
