    "sec_manifiesto": {
      "type": "custom-liquid",
      "name": "MANIFIESTO",
      "settings": {
        "visibility": "always-display",
        "custom_liquid": "{%- comment -%} ═══ 📝 MANIFIESTO emocional (cierre) ═══ {%- endcomment -%}\n{% assign LINE_1 = \"Hay quienes evitan hablar de cerca.\" %}\n{% assign LINE_2 = \"Hay quienes viven pendientes de una menta.\" %}\n{% assign LINE_3 = \"Y hay quienes\" %}\n{% assign LINE_4 = \"vuelven a hablar tranquilos.\" %}\n{% assign CLOSING = \"PRODUCTO DEMO es para los terceros.\" %}\n{% assign BG_FROM = \"#0a1f1c\" %}\n{%- comment -%} ═══ ↓ NO TOCAR ↓ ═══ {%- endcomment -%}\n<style>\n.pe-manifesto{position:relative;background:linear-gradient(135deg,{{ BG_FROM }} 0%,var(--brand-primary) 100%);padding:64px 24px;overflow:hidden;text-align:center;color:#fff;box-sizing:border-box;}\n.pe-manifesto__particles{position:absolute;inset:0;pointer-events:none;}\n.pe-manifesto__particles span{position:absolute;width:5px;height:5px;border-radius:50%;background:#E7F7F4;opacity:.45;animation:peFloat 14s linear infinite;bottom:-10px;box-shadow:0 0 6px #E7F7F4;}\n.pe-manifesto__particles span:nth-child(1){left:8%;animation-delay:0s;animation-duration:11s;}\n.pe-manifesto__particles span:nth-child(2){left:20%;animation-delay:2s;animation-duration:13s;}\n.pe-manifesto__particles span:nth-child(3){left:33%;animation-delay:4s;animation-duration:10s;}\n.pe-manifesto__particles span:nth-child(4){left:46%;animation-delay:1s;animation-duration:15s;}\n.pe-manifesto__particles span:nth-child(5){left:58%;animation-delay:3s;animation-duration:12s;}\n.pe-manifesto__particles span:nth-child(6){left:70%;animation-delay:5s;animation-duration:11s;}\n.pe-manifesto__particles span:nth-child(7){left:82%;animation-delay:2s;animation-duration:14s;}\n.pe-manifesto__particles span:nth-child(8){left:92%;animation-delay:6s;animation-duration:12s;}\n@keyframes peFloat{0%{transform:translateY(0) translateX(0);opacity:0;}10%{opacity:.55;}90%{opacity:.4;}100%{transform:translateY(-120vh) translateX(30px);opacity:0;}}\n.pe-manifesto__content{position:relative;max-width:680px;margin:0 auto;}\n.pe-manifesto__line{font-size:22px;line-height:1.4;margin:0 0 6px;font-weight:300;letter-spacing:.3px;color:#fff;opacity:0;transform:translateY(20px);transition:opacity 1s cubic-bezier(.16,1,.3,1),transform 1s cubic-bezier(.16,1,.3,1);}\n.pe-manifesto__line.pe-shown{opacity:1;transform:translateY(0);}\n.pe-manifesto__line strong{color:#E7F7F4;font-weight:700;}\n.pe-manifesto__closing{margin-top:30px;font-size:12px;text-transform:uppercase;letter-spacing:3px;color:#E7F7F4;opacity:0;transition:opacity 1.2s ease 1.7s;}\n.pe-manifesto.pe-show .pe-manifesto__closing{opacity:.9;}\n@media(min-width:990px){.pe-manifesto{padding:100px 24px;}.pe-manifesto__line{font-size:32px;}}\n</style>\n<section class=\"pe-manifesto\"><div class=\"pe-manifesto__particles\"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div><div class=\"pe-manifesto__content\"><p class=\"pe-manifesto__line\" data-delay=\"0\">{{ LINE_1 }}</p><p class=\"pe-manifesto__line\" data-delay=\"350\">{{ LINE_2 }}</p><p class=\"pe-manifesto__line\" data-delay=\"700\">{{ LINE_3 }}</p><p class=\"pe-manifesto__line\" data-delay=\"1050\"><strong>{{ LINE_4 }}</strong></p><p class=\"pe-manifesto__closing\">{{ CLOSING }}</p></div></section>\n<script>(function(){var section=document.querySelector('.pe-manifesto');if(!section)return;var lines=section.querySelectorAll('.pe-manifesto__line');var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){section.classList.add('pe-show');lines.forEach(function(l){var d=parseInt(l.dataset.delay||0,10);setTimeout(function(){l.classList.add('pe-shown');},d);});io.unobserve(section);}});},{threshold:0.25});io.observe(section);})();</script>",
        "color_scheme": "scheme-1"
      }
    },
    "seccion_faq": {
      "type": "custom-liquid",
      "name": "PREGUNTAS FRECUENTES",
      "settings": {
        "visibility": "always-display",
        "custom_liquid": "{% comment %}\n========================\nTEXTOS EDITABLES\n========================\n{% endcomment %}\n{% assign TITLE = \"Preguntas Frecuentes\" %}\n{% assign Q1 = \"Cómo se usa PRODUCTO DEMO?\" %}\n{% assign A1 = \"Muy fácil, siguiendo las indicaciones del empaque. <strong>Práctico y para usar en casa.</strong>\" %}\n{% assign Q2 = \"Qué tan rápido actúa?\" %}\n{% assign A2 = \"Es de <strong>acción progresiva</strong>: con <strong>uso constante</strong> se notan los mejores resultados.\" %}\n{% assign Q3 = \"Es natural y seguro?\" %}\n{% assign A3 = \"Sí, siguiendo las instrucciones de uso. Si tienes alguna condición particular, consulta a un profesional de la salud.\" %}\n{% assign Q4 = \"Cómo y cuándo pago?\" %}\n{% assign A4 = \"<strong>Pago contra entrega:</strong> pagas en efectivo cuando el transportador te entrega el pedido en la puerta de tu casa. Sin transferencias ni adelantos.\" %}\n{% assign Q5 = \"El envío es discreto?\" %}\n{% assign A5 = \"Sí. Llega en <strong>empaque discreto</strong>, con <strong>envío gratis a todo el país</strong>, normalmente entre <strong>3 y 7 días hábiles</strong>.\" %}\n{% assign ACCENT_COLOR = \"var(--brand-primary,#b82622)\" %}\n\n{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}\n<style>\n.gfs-faq{max-width:560px;margin:8px auto;box-sizing:border-box;padding:0 14px;}\n.gfs-faq__title{text-align:center;font-size:24px;font-weight:800;color:#1a1a1a;margin:0 0 18px;}\n.gfs-faq__item{background:#fff;border:1px solid rgba(var(--brand-primary-rgb),.15);border-radius:14px;margin-bottom:10px;overflow:hidden;box-shadow:0 4px 14px rgba(0,0,0,.04);position:relative;}\n.gfs-faq__item::before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:0;background:linear-gradient(180deg,{{ ACCENT_COLOR }},var(--brand-dark,#8e1c19));border-radius:14px 0 0 14px;transition:width .35s cubic-bezier(.16,1,.3,1);z-index:1;}\n.gfs-faq__item.gfs-open::before{width:4px;}\n.gfs-faq__q{all:unset;box-sizing:border-box;position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;padding:14px 16px;cursor:pointer;font-family:inherit;font-size:14.5px;font-weight:700;color:#1a1a1a;text-align:left;}\n.gfs-faq__q::after{content:\"+\";font-size:22px;font-weight:700;color:{{ ACCENT_COLOR }};flex:0 0 auto;transition:transform .35s cubic-bezier(.16,1,.3,1);}\n.gfs-faq__item.gfs-open .gfs-faq__q[aria-expanded=\"true\"]::after{transform:rotate(45deg);}\n.gfs-faq__q:focus-visible{outline:3px solid {{ ACCENT_COLOR }};outline-offset:-3px;border-radius:14px;}\n.gfs-faq__a{max-height:0;overflow:hidden;transition:max-height .4s cubic-bezier(.16,1,.3,1);}\n.gfs-faq__a p{padding:0 16px 14px;margin:0;font-size:14px;color:#555;line-height:1.6;text-align:left;}\n@media(min-width:990px){.gfs-faq{max-width:720px;}.gfs-faq__title{font-size:30px;}}\n@media(prefers-reduced-motion:reduce){.gfs-faq__item::before,.gfs-faq__q::after,.gfs-faq__a{transition:none !important;}}\n</style>\n<div class=\"gfs-faq\">\n  <p class=\"gfs-faq__title\">{{ TITLE }}</p>\n  <div class=\"gfs-faq__item\"><button class=\"gfs-faq__q\" type=\"button\" id=\"gfs-faq-q1\" aria-expanded=\"false\" aria-controls=\"gfs-faq-a1\"><span>{{ Q1 }}</span></button><div class=\"gfs-faq__a\" id=\"gfs-faq-a1\" role=\"region\" aria-labelledby=\"gfs-faq-q1\"><p>{{ A1 }}</p></div></div>\n  <div class=\"gfs-faq__item\"><button class=\"gfs-faq__q\" type=\"button\" id=\"gfs-faq-q2\" aria-expanded=\"false\" aria-controls=\"gfs-faq-a2\"><span>{{ Q2 }}</span></button><div class=\"gfs-faq__a\" id=\"gfs-faq-a2\" role=\"region\" aria-labelledby=\"gfs-faq-q2\"><p>{{ A2 }}</p></div></div>\n  <div class=\"gfs-faq__item\"><button class=\"gfs-faq__q\" type=\"button\" id=\"gfs-faq-q3\" aria-expanded=\"false\" aria-controls=\"gfs-faq-a3\"><span>{{ Q3 }}</span></button><div class=\"gfs-faq__a\" id=\"gfs-faq-a3\" role=\"region\" aria-labelledby=\"gfs-faq-q3\"><p>{{ A3 }}</p></div></div>\n  <div class=\"gfs-faq__item\"><button class=\"gfs-faq__q\" type=\"button\" id=\"gfs-faq-q4\" aria-expanded=\"false\" aria-controls=\"gfs-faq-a4\"><span>{{ Q4 }}</span></button><div class=\"gfs-faq__a\" id=\"gfs-faq-a4\" role=\"region\" aria-labelledby=\"gfs-faq-q4\"><p>{{ A4 }}</p></div></div>\n  <div class=\"gfs-faq__item\"><button class=\"gfs-faq__q\" type=\"button\" id=\"gfs-faq-q5\" aria-expanded=\"false\" aria-controls=\"gfs-faq-a5\"><span>{{ Q5 }}</span></button><div class=\"gfs-faq__a\" id=\"gfs-faq-a5\" role=\"region\" aria-labelledby=\"gfs-faq-q5\"><p>{{ A5 }}</p></div></div>\n</div>\n<script>(function(){var items=document.querySelectorAll('.gfs-faq__item');items.forEach(function(it){var q=it.querySelector('.gfs-faq__q');var a=it.querySelector('.gfs-faq__a');q.addEventListener('click',function(){var open=it.classList.contains('gfs-open');items.forEach(function(o){o.classList.remove('gfs-open');var oq=o.querySelector('.gfs-faq__q');var oa=o.querySelector('.gfs-faq__a');if(oq)oq.setAttribute('aria-expanded','false');if(oa)oa.style.maxHeight='0';});if(!open){it.classList.add('gfs-open');q.setAttribute('aria-expanded','true');a.style.maxHeight=a.scrollHeight+'px';}});});})();</script>",
        "color_scheme": "scheme-1"
      }
    },
