    "ticker_top": {
      "type": "custom-liquid",
      "name": "TICKER TOP",
      "settings": {
        "visibility": "always-display",
        "custom_liquid": "<style id=\"gfs-a11y\">\n/* Capa GLOBAL de accesibilidad (WCAG 2.2): foco visible + reset universal de movimiento. */\n#custom-releasit-btn:focus-visible,#gfs-sticky-btn:focus-visible,#gfs-cta-mid:focus-visible,#gfs-mani-cta:focus-visible,.wa-float:focus-visible,.gfs-faq__q:focus-visible{outline:3px solid var(--brand-dark,#8e1c19)!important;outline-offset:3px!important;border-radius:12px;}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important;}}\n</style>\n{%- comment -%} ═══ 📝 TICKER TOP ═══ {%- endcomment -%}\n{% assign TEXT_1 = \"PAGA AL RECIBIR · CONTRA ENTREGA 💳\" %}\n{% assign TEXT_2 = \"ALIENTO FRESCO DESDE ADENTRO 🌿\" %}\n{% assign TEXT_3 = \"+5.000 ÓRDENES ENTREGADAS ✅\" %}\n{% assign SPEED_SECONDS = 22 %}\n{%- comment -%} ═══ ↓ NO TOCAR ↓ ═══ {%- endcomment -%}\n<style>\n.pe-mq{overflow:hidden;background:#ffffff;border-top:1px solid #ececec;border-bottom:1px solid #ececec;}\n.pe-mq__track{display:flex;width:max-content;animation:peMqTop {{ SPEED_SECONDS }}s linear infinite;}\n.pe-mq__track span{padding:13px 34px;font-size:13.5px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:#121212;white-space:nowrap;}\n@keyframes peMqTop{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}\n</style>\n<div class=\"pe-mq\" aria-hidden=\"true\"><div class=\"pe-mq__track\"><span>{{ TEXT_1 }}</span><span>{{ TEXT_2 }}</span><span>{{ TEXT_3 }}</span><span>{{ TEXT_1 }}</span><span>{{ TEXT_2 }}</span><span>{{ TEXT_3 }}</span></div></div>",
        "color_scheme": "scheme-1"
      }
    },
    "sec_escalera": {
      "type": "custom-liquid",
      "name": "ESCALERA DE VENTA",
      "settings": {
        "visibility": "always-display",
        "custom_liquid": "{%- comment -%}\n═══ 📝 EDITAR AQUI — ESCALERA DE VENTA (imagen + texto, copy e imágenes REALES) ═══\n{%- endcomment -%}\n{% assign SECTION_TITLE = \"Por qué PRODUCTO DEMO sí funciona\" %}\n\n{% assign P1_KICKER = \"Te suena?\" %}\n{% assign P1_TITLE  = \"El mal aliento que vuelve aunque te cepilles\" %}\n{% assign P1_TEXT   = \"Te cepillas, usas enjuague, cargas chicles… y al rato vuelve esa sensación incómoda. Muchas veces el problema no está solo en la boca.\" %}\n{% assign P1_IMG    = \"https://REEMPLAZA-TU-CDN/01_problema.jpg\" %}\n\n{% assign P2_KICKER = \"La diferencia\" %}\n{% assign P2_TITLE  = \"No nos quedamos solo en la boca\" %}\n{% assign P2_TEXT   = \"A diferencia de un chicle que solo deja sabor a menta por unos minutos, PRODUCTO DEMO apoya la frescura del aliento desde el sistema digestivo.\" %}\n{% assign P2_IMG    = \"https://REEMPLAZA-TU-CDN/05_frescura.jpg\" %}\n\n{% assign P3_KICKER = \"La fórmula\" %}\n{% assign P3_TITLE  = \"producto-demo, probióticos y enzimas\" %}\n{% assign P3_TEXT   = \"Tres componentes que trabajan juntos: frescura interna, equilibrio de tu flora intestinal y mejor digestión del día a día.\" %}\n{% assign P3_IMG    = \"https://REEMPLAZA-TU-CDN/03_formula.jpg\" %}\n\n{% assign P4_KICKER = \"En tu día\" %}\n{% assign P4_TITLE  = \"Más seguridad al hablar de cerca\" %}\n{% assign P4_TEXT   = \"Cuando sientes que tu aliento está bajo control, hablas con tranquilidad en reuniones, citas o en el trabajo.\" %}\n{% assign P4_IMG    = \"https://REEMPLAZA-TU-CDN/02_confianza.jpg\" %}\n\n{% assign P5_KICKER = \"Fácil\" %}\n{% assign P5_TITLE  = \"2 cápsulas al día, y listo\" %}\n{% assign P5_TEXT   = \"Una después del desayuno y otra después del almuerzo. Cada frasco trae 60 cápsulas: rinde 30 días.\" %}\n{% assign P5_IMG    = \"https://REEMPLAZA-TU-CDN/04_modo_uso.jpg\" %}\n\n{% assign P6_KICKER = \"\" %}{% assign P6_TITLE = \"\" %}{% assign P6_TEXT = \"\" %}{% assign P6_IMG = \"\" %}\n\n{%- comment -%} ═══ ↓ NO TOCAR ↓ ═══ {%- endcomment -%}\n<style>\n.gfs-lad{max-width:820px;margin:24px auto;box-sizing:border-box;padding:0 14px;}\n.gfs-lad__h{text-align:center;font-size:22px;font-weight:800;color:#1a1a1a;letter-spacing:.3px;margin:0 0 18px;text-transform:uppercase;}\n.gfs-lad__row{display:flex;flex-direction:column;align-items:stretch;gap:14px;background:linear-gradient(135deg,var(--brand-light) 0%,#fff 100%);border:1px solid rgba(var(--brand-primary-rgb),.14);border-radius:18px;overflow:hidden;box-shadow:0 10px 30px rgba(var(--brand-primary-rgb),.07);margin-bottom:16px;opacity:0;transform:translateY(22px);transition:opacity .6s ease,transform .6s cubic-bezier(.16,1,.3,1);}\n.gfs-lad__row.gfs-in{opacity:1;transform:none;}\n.gfs-lad__media{position:relative;width:100%;aspect-ratio:16/10;background:rgba(var(--brand-primary-rgb),.06);}\n.gfs-lad__media img{width:100%;height:100%;object-fit:cover;display:block;}\n.gfs-lad__body{padding:16px 18px 20px;}\n.gfs-lad__kicker{display:inline-block;font-size:12px;font-weight:800;letter-spacing:.5px;text-transform:uppercase;color:var(--brand-dark);background:rgba(var(--brand-primary-rgb),.12);padding:4px 10px;border-radius:20px;margin:0 0 8px;}\n.gfs-lad__t{font-size:18px;font-weight:800;color:#1a1a1a;line-height:1.25;margin:0 0 6px;}\n.gfs-lad__p{font-size:14px;color:#444;line-height:1.55;margin:0;}\n@media(min-width:750px){.gfs-lad__row{flex-direction:row;align-items:center;gap:0;}.gfs-lad__row:nth-child(even){flex-direction:row-reverse;}.gfs-lad__media{flex:0 0 46%;aspect-ratio:4/3;align-self:stretch;}.gfs-lad__body{flex:1 1 auto;padding:26px 30px;}.gfs-lad__h{font-size:28px;margin-bottom:26px;}.gfs-lad__t{font-size:22px;}.gfs-lad__p{font-size:15.5px;}}\n.gfs-lad__row--noimg .gfs-lad__media{display:none;}\n.gfs-lad__row--noimg .gfs-lad__body{flex-basis:100%;text-align:center;}\n</style>\n<div class=\"gfs-lad\">{% if SECTION_TITLE != \"\" %}<p class=\"gfs-lad__h\">{{ SECTION_TITLE }}</p>{% endif %}{% assign K = P1_KICKER | append: '||' | append: P2_KICKER | append: '||' | append: P3_KICKER | append: '||' | append: P4_KICKER | append: '||' | append: P5_KICKER | append: '||' | append: P6_KICKER | split: '||' %}{% assign T = P1_TITLE | append: '||' | append: P2_TITLE | append: '||' | append: P3_TITLE | append: '||' | append: P4_TITLE | append: '||' | append: P5_TITLE | append: '||' | append: P6_TITLE | split: '||' %}{% assign X = P1_TEXT | append: '||' | append: P2_TEXT | append: '||' | append: P3_TEXT | append: '||' | append: P4_TEXT | append: '||' | append: P5_TEXT | append: '||' | append: P6_TEXT | split: '||' %}{% assign M = P1_IMG | append: '||' | append: P2_IMG | append: '||' | append: P3_IMG | append: '||' | append: P4_IMG | append: '||' | append: P5_IMG | append: '||' | append: P6_IMG | split: '||' %}{% for t in T %}{% assign kick = K[forloop.index0] %}{% assign txt = X[forloop.index0] %}{% assign img = M[forloop.index0] %}{% if t != blank or txt != blank %}<div class=\"gfs-lad__row{% if img == blank %} gfs-lad__row--noimg{% endif %}\"><div class=\"gfs-lad__media\">{% if img != blank %}<img src=\"{{ img }}\" alt=\"{{ t | escape }}\" loading=\"lazy\" decoding=\"async\">{% endif %}</div><div class=\"gfs-lad__body\">{% if kick != blank %}<span class=\"gfs-lad__kicker\">{{ kick }}</span>{% endif %}{% if t != blank %}<h3 class=\"gfs-lad__t\">{{ t }}</h3>{% endif %}{% if txt != blank %}<p class=\"gfs-lad__p\">{{ txt }}</p>{% endif %}</div></div>{% endif %}{% endfor %}</div>\n<script>(function(){var rows=document.querySelectorAll('.gfs-lad__row');if(!('IntersectionObserver' in window)){rows.forEach(function(r){r.classList.add('gfs-in');});return;}var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('gfs-in');io.unobserve(e.target);}});},{threshold:.15});rows.forEach(function(r){io.observe(r);});})();</script>",
        "color_scheme": "scheme-1"
      }
    },
    "sec_como_actua": {
      "type": "custom-liquid",
      "name": "COMO ACTUA",
      "settings": {
        "visibility": "always-display",
        "custom_liquid": "{%- comment -%} ═══ 📝 CÓMO ACTÚA (3 fases = los 3 activos reales) ═══ {%- endcomment -%}\n{% assign TITLE = \"Cómo actúa PRODUCTO DEMO\" %}\n{% assign SUBTITLE = \"Frescura que empieza por dentro, no solo en la boca\" %}\n{% assign L1_LABEL = \"Equilibra\" %}{% assign L1_NOTES = \"Probióticos que apoyan tu flora intestinal\" %}{% assign L1_ICON = \"🦠\" %}\n{% assign L2_LABEL = \"Procesa\" %}{% assign L2_NOTES = \"Enzimas que ayudan a digerir mejor lo que comes\" %}{% assign L2_ICON = \"⚙️\" %}\n{% assign L3_LABEL = \"Refresca\" %}{% assign L3_NOTES = \"producto-demo que aporta frescura interna desde la raíz\" %}{% assign L3_ICON = \"🌿\" %}\n{%- comment -%} ═══ ↓ NO TOCAR ↓ ═══ {%- endcomment -%}\n<style>\n.gfs-steps{max-width:560px;margin:8px auto;box-sizing:border-box;padding:0 14px;}\n.gfs-steps__title{text-align:center;font-size:24px;font-weight:800;color:#1a1a1a;letter-spacing:.3px;margin:0 0 4px;}\n.gfs-steps__sub{text-align:center;font-size:14px;color:#6b6b6b;margin:0 0 22px;font-style:italic;}\n.gfs-steps__grid{display:flex;flex-direction:column;gap:12px;}\n.gfs-step{display:flex;align-items:center;gap:14px;background:var(--brand-light);border:1px solid rgba(var(--brand-primary-rgb),.2);border-left:5px solid var(--brand-primary);border-radius:14px;padding:14px 16px;box-shadow:0 8px 24px rgba(var(--brand-primary-rgb),.08);}\n.gfs-step__icon{flex:0 0 46px;width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,var(--brand-primary),var(--brand-dark));display:flex;align-items:center;justify-content:center;font-size:22px;box-shadow:0 4px 12px rgba(var(--brand-primary-rgb),.4),inset 0 1px 0 rgba(255,255,255,.25);}\n.gfs-step__label{font-size:13px;font-weight:800;color:var(--brand-primary);text-transform:uppercase;letter-spacing:.6px;margin:0 0 3px;}\n.gfs-step__notes{font-size:15px;font-weight:600;color:#1a1a1a;margin:0;}\n@media(min-width:990px){.gfs-steps{max-width:960px;}.gfs-steps__title{font-size:30px;}.gfs-steps__grid{flex-direction:row;align-items:stretch;gap:20px;}.gfs-step{flex:1;flex-direction:column;text-align:center;gap:14px;border-left:none;border-top:5px solid var(--brand-primary);padding:28px 18px;}.gfs-step__icon{width:54px;height:54px;flex:0 0 54px;font-size:26px;}}\n</style>\n<div class=\"gfs-steps\"><p class=\"gfs-steps__title\">{{ TITLE }}</p><p class=\"gfs-steps__sub\">{{ SUBTITLE }}</p><div class=\"gfs-steps__grid\"><div class=\"gfs-step\"><div class=\"gfs-step__icon\">{{ L1_ICON }}</div><div><p class=\"gfs-step__label\">{{ L1_LABEL }}</p><p class=\"gfs-step__notes\">{{ L1_NOTES }}</p></div></div><div class=\"gfs-step\"><div class=\"gfs-step__icon\">{{ L2_ICON }}</div><div><p class=\"gfs-step__label\">{{ L2_LABEL }}</p><p class=\"gfs-step__notes\">{{ L2_NOTES }}</p></div></div><div class=\"gfs-step\"><div class=\"gfs-step__icon\">{{ L3_ICON }}</div><div><p class=\"gfs-step__label\">{{ L3_LABEL }}</p><p class=\"gfs-step__notes\">{{ L3_NOTES }}</p></div></div></div></div>",
        "color_scheme": "scheme-1"
      }
    },
    "cta_mid": {
      "type": "custom-liquid",
      "name": "DOBLE CTA (media página)",
      "settings": {
        "visibility": "always-display",
        "custom_liquid": "{%- comment -%} ═══ 📝 DOBLE CTA — segundo botón verde a media página ═══ {%- endcomment -%}\n{% assign BTN_TEXT = \"PEDIR AHORA 🔥\" %}\n{%- comment -%} ═══ ↓ NO TOCAR ↓ ═══ {%- endcomment -%}\n<style>\n.gfs-mid-cta{max-width:480px;margin:6px auto 4px;padding:0 16px;box-sizing:border-box;text-align:center;}\n#gfs-cta-mid{position:relative;overflow:hidden;display:inline-flex;align-items:center;justify-content:center;width:100%;min-height:56px;padding:14px 20px;border:1px solid #fff;border-radius:16px;background:linear-gradient(180deg,var(--cta),var(--cta-dark));color:#fff;font-size:17px;font-weight:800;letter-spacing:.5px;cursor:pointer;box-shadow:0 10px 24px rgba(var(--cta-rgb),.4);animation:gfsMidPulse 1.9s infinite;}\n#gfs-cta-mid span{position:relative;z-index:2;}\n#gfs-cta-mid::before{content:\"\";position:absolute;top:0;left:-100%;width:60%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.4),transparent);animation:gfsMidShine 3.5s infinite;pointer-events:none;z-index:1;}\n#gfs-cta-mid:active{transform:translateY(3px);}\n@keyframes gfsMidShine{0%{left:-100%;}40%{left:140%;}100%{left:140%;}}\n@keyframes gfsMidPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.03)}}\n</style>\n<div class=\"gfs-mid-cta\"><button id=\"gfs-cta-mid\" type=\"button\"><span>{{ BTN_TEXT }}</span></button></div>\n<script>(function(){var b=document.getElementById('gfs-cta-mid');if(!b)return;b.addEventListener('click',function(){var m=document.getElementById('custom-releasit-btn');if(m)m.click();});})();</script>",
        "color_scheme": "scheme-1"
      }
    },
    "sec_resenas": {
      "type": "custom-liquid",
      "name": "RESEÑAS (reales)",
      "settings": {
        "visibility": "always-display",
        "custom_liquid": "{%- comment -%} ═══ 📝 RESEÑAS REALES (de la tienda, no inventadas) ═══ {%- endcomment -%}\n{% assign TITLE = \"Lo que dicen quienes ya lo usan\" %}\n{% assign COUNT_TEXT = \"Reseñas verificadas de clientes reales\" %}\n{%- comment -%} ═══ ↓ NO TOCAR (salvo el bloque de reseñas) ↓ ═══ {%- endcomment -%}\n<style>\n.gfs-reviews{max-width:560px;margin:8px auto;box-sizing:border-box;padding:0 14px;}\n.gfs-reviews__head{text-align:center;margin-bottom:18px;}\n.gfs-reviews__title{font-size:24px;font-weight:800;color:#1a1a1a;margin:0 0 4px;}\n.gfs-reviews__stars{font-size:16px;color:#f6c701;letter-spacing:2px;}\n.gfs-reviews__count{font-size:13px;color:#6b6b6b;margin-top:2px;font-style:italic;}\n.gfs-reviews__list{display:flex;flex-direction:column;gap:12px;}\n.gfs-review{background:#fff;border:1px solid rgba(0,0,0,.06);border-radius:16px;padding:16px 18px;box-shadow:0 8px 28px rgba(0,0,0,.06);}\n.gfs-review__top{display:flex;align-items:center;gap:12px;margin-bottom:8px;}\n.gfs-review__avatar{flex:0 0 44px;width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--brand-primary),var(--brand-dark));color:#fff;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700;box-shadow:0 4px 12px rgba(var(--brand-primary-rgb),.35);}\n.gfs-review__id{flex:1 1 auto;text-align:left;}\n.gfs-review__name{font-size:15px;font-weight:700;color:#1a1a1a;margin:0;display:flex;align-items:center;gap:6px;flex-wrap:wrap;}\n.gfs-review__verified{font-size:11px;font-weight:700;color:var(--brand-primary);background:var(--brand-light);padding:2px 7px;border-radius:20px;}\n.gfs-review__stars{color:#f6c701;font-size:14px;letter-spacing:1px;margin-top:2px;}\n.gfs-review__text{font-size:14px;color:#444;line-height:1.55;margin:0;text-align:left;}\n@media(min-width:990px){.gfs-reviews{max-width:1000px;}.gfs-reviews__title{font-size:30px;}.gfs-reviews__list{flex-direction:row;align-items:stretch;}.gfs-reviews__list .gfs-review{flex:1 1 0;}}\n</style>\n<div class=\"gfs-reviews\"><div class=\"gfs-reviews__head\"><p class=\"gfs-reviews__title\">{{ TITLE }}</p><div class=\"gfs-reviews__stars\">★★★★★</div><p class=\"gfs-reviews__count\">{{ COUNT_TEXT }}</p></div><div id=\"gfs-reviews-list\" class=\"gfs-reviews__list\"></div></div>\n<script>\n/* ═══ RESEÑAS REALES tomadas de la tienda (Trustoo / testimonios). NO inventar. ═══ */\nwindow.GFS_REVIEWS = [\n  {name:\"Carmen V.\", stars:5, image:\"\", text:\"Antes me daba mucha pena hablar cerca de la gente, usaba chicles y aun así sentía inseguridad. Con estas pastillas empecé a sentirme más tranquila cada que hablaba.\"},\n  {name:\"Estefanía M.\", stars:5, image:\"\", text:\"Mi problema era que me cepillaba y a las dos horas otra vez sentía ese sabor raro. Estas pastillas me han quitado ese problema con dos meses que llevo tomándolas.\"},\n  {name:\"Camilo C.\", stars:5, image:\"\", text:\"Trabajo atendiendo personas y el tema del aliento me generaba mucha inseguridad. Con esto sentí que podía estar más tranquilo durante el día. Se volvió parte de mi rutina.\"}\n];\n/* ═══ NO TOCAR ABAJO ═══ */\n(function(){var list=document.getElementById('gfs-reviews-list');if(!list)return;var data=window.GFS_REVIEWS||[];data.forEach(function(r){var initials=r.name.trim().charAt(0).toUpperCase();var full=Math.max(0,Math.min(5,r.stars||0));var stars='★★★★★'.slice(0,full)+'☆☆☆☆☆'.slice(0,5-full);var avatarStyle=r.image?('background-image:url('+r.image+');background-size:cover;background-position:center;'):'';var avatarText=r.image?'':initials;var el=document.createElement('div');el.className='gfs-review';el.innerHTML='<div class=\"gfs-review__top\"><div class=\"gfs-review__avatar\" style=\"'+avatarStyle+'\">'+avatarText+'</div><div class=\"gfs-review__id\"><p class=\"gfs-review__name\">'+r.name+' <span class=\"gfs-review__verified\">✓ Verificada</span></p><div class=\"gfs-review__stars\">'+stars+'</div></div></div><p class=\"gfs-review__text\">'+r.text+'</p>';list.appendChild(el);});})();\n</script>",
        "color_scheme": "scheme-1"
      }
    },
    "sec_por_que_elegir": {
      "type": "custom-liquid",
      "name": "POR QUE ELEGIR",
      "settings": {
        "visibility": "always-display",
        "custom_liquid": "{%- comment -%} ═══ 📝 POR QUÉ ELEGIR MI PRODUCTO? (4 razones del producto) ═══ {%- endcomment -%}\n{% assign SECTION_TITLE = \"Por qué elegir PRODUCTO DEMO?\" %}\n{% assign R1_ICON = \"🌿\" %}{% assign R1_TITLE = \"Desde adentro\" %}{% assign R1_TEXT = \"Apoya la frescura desde el sistema digestivo, no solo la tapa.\" %}\n{% assign R2_ICON = \"🧪\" %}{% assign R2_TITLE = \"Fórmula con respaldo\" %}{% assign R2_TEXT = \"producto-demo, probióticos y enzimas; fabricado y testeado en laboratorio.\" %}\n{% assign R3_ICON = \"💬\" %}{% assign R3_TITLE = \"Más confianza\" %}{% assign R3_TEXT = \"Hablas de cerca con tranquilidad, sin depender de mentas.\" %}\n{% assign R4_ICON = \"🛡️\" %}{% assign R4_TITLE = \"Compra segura\" %}{% assign R4_TEXT = \"Pagas al recibir, sin adelantos ni riesgo.\" %}\n{%- comment -%} ═══ ↓ NO TOCAR ↓ ═══ {%- endcomment -%}\n<style>\n.gfs-why{max-width:820px;margin:24px auto;box-sizing:border-box;padding:0 14px;}\n.gfs-why__h{text-align:center;font-size:20px;font-weight:800;color:#1a1a1a;letter-spacing:.3px;margin:0 0 16px;text-transform:uppercase;}\n.gfs-why__grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}\n.gfs-why__card{background:linear-gradient(135deg,var(--brand-light) 0%,#fff 100%);border:1px solid rgba(var(--brand-primary-rgb),.16);border-radius:16px;padding:16px 14px;text-align:center;box-shadow:0 6px 20px rgba(var(--brand-primary-rgb),.06);transition:transform .3s cubic-bezier(.16,1,.3,1);}\n.gfs-why__card:hover{transform:translateY(-4px);}\n.gfs-why__icon{width:48px;height:48px;margin:0 auto 8px;border-radius:50%;background:linear-gradient(135deg,var(--brand-primary),var(--brand-dark));display:flex;align-items:center;justify-content:center;font-size:24px;box-shadow:0 4px 12px rgba(var(--brand-primary-rgb),.4),inset 0 1px 0 rgba(255,255,255,.3);}\n.gfs-why__t{font-size:14px;font-weight:800;color:#1a1a1a;margin:0 0 4px;text-transform:uppercase;letter-spacing:.3px;line-height:1.2;}\n.gfs-why__p{font-size:12.5px;color:#555;line-height:1.4;margin:0;}\n@media(min-width:750px){.gfs-why__h{font-size:26px;margin-bottom:24px;}.gfs-why__grid{grid-template-columns:repeat(4,1fr);gap:16px;}.gfs-why__card{padding:24px 16px;}.gfs-why__icon{width:60px;height:60px;font-size:30px;}.gfs-why__t{font-size:15px;}.gfs-why__p{font-size:13.5px;}}\n</style>\n<div class=\"gfs-why\"><p class=\"gfs-why__h\">{{ SECTION_TITLE }}</p><div class=\"gfs-why__grid\"><div class=\"gfs-why__card\"><div class=\"gfs-why__icon\">{{ R1_ICON }}</div><p class=\"gfs-why__t\">{{ R1_TITLE }}</p><p class=\"gfs-why__p\">{{ R1_TEXT }}</p></div><div class=\"gfs-why__card\"><div class=\"gfs-why__icon\">{{ R2_ICON }}</div><p class=\"gfs-why__t\">{{ R2_TITLE }}</p><p class=\"gfs-why__p\">{{ R2_TEXT }}</p></div><div class=\"gfs-why__card\"><div class=\"gfs-why__icon\">{{ R3_ICON }}</div><p class=\"gfs-why__t\">{{ R3_TITLE }}</p><p class=\"gfs-why__p\">{{ R3_TEXT }}</p></div><div class=\"gfs-why__card\"><div class=\"gfs-why__icon\">{{ R4_ICON }}</div><p class=\"gfs-why__t\">{{ R4_TITLE }}</p><p class=\"gfs-why__p\">{{ R4_TEXT }}</p></div></div></div>",
        "color_scheme": "scheme-1"
      }
