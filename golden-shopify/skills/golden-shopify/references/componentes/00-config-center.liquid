<style id="gfs-desktop-apple">
/* === LAYOUT ESCRITORIO (PC) estilo "Apple": ancho real, tipografía grande, rejillas, aire.
   Capa centralizada y apagable. Absorbida de un build real probado (PRODUCTO DEMO) en G2.1. === */
@media(min-width:990px){
  .gfs-steps,.gfs-reviews,.gfs-faq,.gfs-why,.gfs-lad,.pe-pyramid{max-width:1140px !important;margin-left:auto !important;margin-right:auto !important;}
  .gfs-steps__title,.gfs-reviews__title,.gfs-faq__title,.gfs-why__title,.gfs-lad__h{font-size:40px !important;letter-spacing:-.6px !important;}
  .gfs-steps__sub,.gfs-reviews__count,.gfs-why__sub{font-size:16px !important;}
  /* Escalera → rejilla de tarjetas (no filas largas con lados vacíos) */
  .gfs-lad{display:grid !important;grid-template-columns:repeat(2,1fr) !important;gap:22px !important;align-items:stretch !important;}
  .gfs-lad__h{grid-column:1/-1 !important;margin-bottom:8px !important;}
  .gfs-lad__row{margin-bottom:0 !important;height:100% !important;padding:26px 30px !important;}
  .gfs-lad__t{font-size:22px !important;}
  .gfs-lad__p{font-size:16px !important;}
  /* FAQ ancha y legible */
  .gfs-faq{max-width:920px !important;}
  .gfs-faq__q{font-size:17px !important;padding:18px 24px !important;}
  .gfs-faq__a p{font-size:15.5px !important;padding:0 24px 16px !important;}
  /* Reseñas amplias */
  .gfs-reviews__list .gfs-review{padding:24px 26px !important;}
  .gfs-review__text{font-size:15.5px !important;line-height:1.6 !important;}
  /* Bloques de la columna de compra: que no se vean "móvil" en PC */
  .gfs-guarantee{max-width:640px !important;}
  .gfs-ship{max-width:920px !important;}
  .gfs-cd,.mb-banner__box{max-width:640px !important;}
  /* Doble CTA más presente en PC */
  .gfs-mid-cta{max-width:560px !important;}
  #gfs-cta-mid{font-size:18px !important;min-height:60px !important;}
}
@media(min-width:1280px){
  .gfs-steps,.gfs-reviews,.gfs-why,.gfs-lad,.pe-pyramid{max-width:1240px !important;}
}
