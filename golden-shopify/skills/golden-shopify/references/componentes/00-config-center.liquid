<script>
/* === MOTOR COD ROBUSTO (gfsFireCOD) — G3.2. Cualquier [data-cod] dispara el botón Releasit correcto,
   evita el del modal y reintenta si aún no inyectó. Coexiste con los botones existentes. === */
(function(){if(window.gfsFireCOD)return;
  function inModal(el){return !!(el.closest&&el.closest('._rsi-cod-form-modal, ._rsi-modal-container'));}
  function inner(el){if(!el)return null;return (el.classList&&el.classList.contains('_rsi-buy-now-button'))?el:((el.querySelector&&el.querySelector('._rsi-buy-now-button'))||el);}
  function pick(){var sels=['._rsi-buy-now-button-product:not(._rsi-buy-now-button-product-floating)','#_rsi-buy-now-button-overwrite','._rsi-buy-now-button-product-floating','#_rsi-buy-now-button-floating','._rsi-buy-now-button'];for(var s=0;s<sels.length;s++){var n=document.querySelectorAll(sels[s]);for(var i=0;i<n.length;i++){if(!inModal(n[i]))return inner(n[i]);}}return null;}
  function fire(el){var o={bubbles:true,cancelable:true,view:window};try{el.dispatchEvent(new MouseEvent('mousedown',o));}catch(e){}try{el.dispatchEvent(new MouseEvent('mouseup',o));}catch(e){}try{el.click();}catch(e){}}
  var iv=null;
  window.gfsFireCOD=function(){if(iv){clearInterval(iv);iv=null;}var b=pick();if(b){fire(b);return true;}var k=0;iv=setInterval(function(){var x=pick();if(x){fire(x);clearInterval(iv);iv=null;}else if(++k>=80){clearInterval(iv);iv=null;}},200);return false;};
  document.addEventListener('click',function(e){var t=e.target&&e.target.closest?e.target.closest('[data-cod]'):null;if(t){e.preventDefault();window.gfsFireCOD();}},true);
})();
</script>