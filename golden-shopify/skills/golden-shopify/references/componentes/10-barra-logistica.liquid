{% endcomment %}
{% assign HEADER_TITLE = "Así llega tu pedido" %}
{% assign HEADER_SUB = "Rápido, seguro y a tu puerta" %}

{% assign STEP_1_TITLE = "Pedido" %}
{% assign STEP_1_TEXT = "Mismo día" %}

{% assign STEP_2_TITLE = "En camino" %}
{% assign STEP_2_TEXT = "24 a 48 h" %}

{% assign STEP_3_TITLE = "Entrega" %}
{% assign STEP_3_TEXT = "3 a 7 días" %}

{% assign ACCENT_COLOR = "var(--brand-primary)" %}
{% assign DARK_ACCENT = "var(--brand-dark)" %}
{% assign BG_TINT = "var(--brand-light)" %}

{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}
<style>
.gfs-ship{max-width:560px;margin:18px auto;box-sizing:border-box;padding:18px 14px;background:linear-gradient(135deg,{{ BG_TINT }} 0%,#ffffff 100%);border:1px solid rgba(var(--brand-primary-rgb),.15);border-radius:16px;box-shadow:0 8px 24px rgba(var(--brand-primary-rgb),.07);}
.gfs-ship__head{text-align:center;margin-bottom:14px;}
.gfs-ship__title{font-size:15px;font-weight:800;color:#1a1a1a;letter-spacing:.3px;margin:0 0 3px;text-transform:uppercase;}
.gfs-ship__sub{font-size:12px;color:#777;font-style:italic;margin:0;}

/* === HORIZONTAL en MOBILE (default) === */
.gfs-ship__steps{display:flex;flex-direction:row;align-items:flex-start;justify-content:space-between;gap:0;position:relative;}
.gfs-ship__step{flex:0 0 auto;display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;padding:0 4px;max-width:95px;transition:transform .3s cubic-bezier(.16,1,.3,1);}
.gfs-ship__step:hover,.gfs-ship__step:active{transform:translateY(-3px);}
.gfs-ship__icon{flex:0 0 44px;width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,{{ ACCENT_COLOR }},{{ DARK_ACCENT }});display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(var(--brand-primary-rgb),.4),inset 0 1px 0 rgba(255,255,255,.25);animation:gfsShipPulse 2.8s ease-in-out infinite;}
.gfs-ship__step:nth-child(3) .gfs-ship__icon{animation-delay:.5s;}
.gfs-ship__step:nth-child(5) .gfs-ship__icon{animation-delay:1s;}
.gfs-ship__icon svg{width:22px;height:22px;}
.gfs-ship__body{text-align:center;}
.gfs-ship__h3{font-size:12px;font-weight:800;color:#1a1a1a;margin:0 0 2px;text-transform:uppercase;letter-spacing:.4px;line-height:1.15;}
.gfs-ship__p{font-size:11.5px;color:#555;margin:0;line-height:1.3;font-weight:600;}
.gfs-ship__line{flex:1 1 auto;height:3px;min-height:3px;width:auto;margin:20px 2px 0;border-radius:3px;background:linear-gradient(90deg,{{ ACCENT_COLOR }} 0%,rgba(var(--brand-primary-rgb),.25) 100%);position:relative;overflow:hidden;}
.gfs-ship__line::after{content:"";position:absolute;top:0;left:-30%;width:30%;height:100%;background:linear-gradient(90deg,transparent,var(--brand-bright),transparent);animation:gfsShipFlowH 2.5s ease-in-out infinite;}

@keyframes gfsShipPulse{0%,100%{transform:scale(1);box-shadow:0 4px 12px rgba(var(--brand-primary-rgb),.4),inset 0 1px 0 rgba(255,255,255,.25);}50%{transform:scale(1.07);box-shadow:0 8px 20px rgba(var(--brand-primary-rgb),.65),inset 0 1px 0 rgba(255,255,255,.3);}}
@keyframes gfsShipFlowH{0%{left:-30%;opacity:0;}30%{opacity:1;}70%{opacity:1;}100%{left:100%;opacity:0;}}

/* === DESKTOP: mismo layout pero más grande y espacioso === */
@media(min-width:750px){
  .gfs-ship{max-width:820px;padding:28px 24px;}
  .gfs-ship__head{margin-bottom:22px;}
  .gfs-ship__title{font-size:22px;}
  .gfs-ship__sub{font-size:14.5px;}
  .gfs-ship__step{max-width:180px;gap:12px;padding:0 6px;}
  .gfs-ship__step:hover{transform:translateY(-6px);}
  .gfs-ship__icon{flex:0 0 64px;width:64px;height:64px;}
  .gfs-ship__icon svg{width:32px;height:32px;}
  .gfs-ship__h3{font-size:15px;}
  .gfs-ship__p{font-size:14px;}
  .gfs-ship__line{height:4px;margin:30px 8px 0;}
}
</style>
<div class="gfs-ship">
  <div class="gfs-ship__head">
    <p class="gfs-ship__title">{{ HEADER_TITLE }}</p>
    <p class="gfs-ship__sub">{{ HEADER_SUB }}</p>
  </div>
  <div class="gfs-ship__steps">
    <div class="gfs-ship__step">
      <div class="gfs-ship__icon"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h2l2.5 10h10l2-7H7"/><circle cx="10" cy="20" r="1.5" fill="#fff" stroke="none"/><circle cx="18" cy="20" r="1.5" fill="#fff" stroke="none"/></svg></div>
      <div class="gfs-ship__body"><h3 class="gfs-ship__h3">{{ STEP_1_TITLE }}</h3><p class="gfs-ship__p">{{ STEP_1_TEXT }}</p></div>
    </div>
    <div class="gfs-ship__line"></div>
    <div class="gfs-ship__step">
      <div class="gfs-ship__icon"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h13v7H3zM16 10h4l2 3v4h-6z"/><circle cx="7" cy="18" r="2" fill="#fff" stroke="none"/><circle cx="17" cy="18" r="2" fill="#fff" stroke="none"/></svg></div>
      <div class="gfs-ship__body"><h3 class="gfs-ship__h3">{{ STEP_2_TITLE }}</h3><p class="gfs-ship__p">{{ STEP_2_TEXT }}</p></div>
    </div>
    <div class="gfs-ship__line"></div>
    <div class="gfs-ship__step">
      <div class="gfs-ship__icon"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1V11z"/></svg></div>
      <div class="gfs-ship__body"><h3 class="gfs-ship__h3">{{ STEP_3_TITLE }}</h3><p class="gfs-ship__p">{{ STEP_3_TEXT }}</p></div>
    </div>
  </div>
</div>