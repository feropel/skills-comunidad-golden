{% assign TITLE_COLOR        = "#1a1a1a" %}
{% assign ACCENT_LINE_COLOR  = "#0F6F5C" %}
{% assign TITLE_SIZE_MOBILE  = "25px" %}
{% assign TITLE_SIZE_DESKTOP = "33px" %}
{% assign LINE_WIDTH         = "54px" %}
{% assign MARGIN_TOP         = "10px" %}
{% assign MARGIN_BOTTOM      = "4px" %}

{%- comment -%}
═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══
{%- endcomment -%}

<style>
.pe-ptitle{text-align:center;max-width:560px;margin:{{ MARGIN_TOP }} auto {{ MARGIN_BOTTOM }};padding:0 14px;box-sizing:border-box;}
.pe-ptitle h1{margin:0;font-size:{{ TITLE_SIZE_MOBILE }};line-height:1.3;font-weight:800;color:{{ TITLE_COLOR }};letter-spacing:-.2px;}
.pe-ptitle__line{width:{{ LINE_WIDTH }};height:3px;background:{{ ACCENT_LINE_COLOR }};border-radius:3px;margin:12px auto 0;}
@media(min-width:990px){.pe-ptitle h1{font-size:{{ TITLE_SIZE_DESKTOP }};}}
</style>
<div class="pe-ptitle">
  <h1>{{ product.title }}</h1>
  <div class="pe-ptitle__line"></div>
</div>