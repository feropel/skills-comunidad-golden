{% comment %} === COMPONENTE: ESCALERA DE COMBOS (G4.0) === {% endcomment %}
{% comment %}
  OBLIGATORIA en el perfil CATÁLOGO/DROPSHIPPING (ver `references/perfiles.md`).
  En dropshipping el margen sale del ticket promedio: sin combos la página está incompleta.
  En perfil MARCA es opcional (úsala si el producto se consume y se repone).

  El truco de copy que funciona: NO argumentar "compra más porque es más barato" sino dar
  una RAZÓN DE USO para tener dos ("uno se queda en el baño, otro vive en la maleta").
  El descuento cierra, la razón de uso abre.

  ⚠️ Los precios NO se inventan: se confirman con el dueño. Si aún no los tienes, deja
  [confirmar] en el precio y NO publiques la sección.
{% endcomment %}

{% comment %}
═══════════════════════════════════════════════════
  📝 EDITAR AQUI — los 3 escalones y la razón de uso
═══════════════════════════════════════════════════
{% endcomment %}
{% assign KICKER  = "Por qué casi nadie lleva uno solo" %}
{% assign TITULO  = "Uno te dura,<br><em>pero nunca alcanza</em>" %}
{% assign RAZON   = "Escribe aquí la razón REAL de tener dos: dónde vive cada uno, quién más lo usa en la casa, cada cuánto se acaba." %}

{% assign C1_N = "1 unidad" %}{% assign C1_P = "[confirmar]" %}{% assign C1_A = "" %}          {% assign C1_TAG = "" %}
{% assign C2_N = "2 unidades" %}{% assign C2_P = "[confirmar]" %}{% assign C2_A = "Ahorras [confirmar]" %}{% assign C2_TAG = "EL MAS PEDIDO" %}
{% assign C3_N = "3 unidades" %}{% assign C3_P = "[confirmar]" %}{% assign C3_A = "Ahorras [confirmar]" %}{% assign C3_TAG = "MEJOR PRECIO" %}

{% assign NOTA    = "Puedes combinar las referencias que quieras en el mismo pedido." %}
{% assign BTN     = "PEDIR AHORA 🔥" %}

{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}
<style>
.gfs-cmb{max-width:1180px;margin:0 auto;padding:26px 14px 8px;box-sizing:border-box;font-family:var(--gfs-sans,inherit);}
.gfs-cmb__head{text-align:center;margin-bottom:20px;}
.gfs-cmb__k{display:block;font-size:13px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:var(--brand-primary);margin:0 0 8px;}
.gfs-cmb__t{font-size:28px;line-height:1.12;font-weight:900;color:var(--brand-dark);margin:0 0 10px;letter-spacing:-.6px;}
.gfs-cmb__t em{font-style:normal;color:var(--brand-primary);}
.gfs-cmb__r{font-size:16.5px;line-height:1.6;color:#5A5A5A;margin:0 auto;max-width:560px;}
.gfs-cmb__grid{display:grid;grid-template-columns:1fr;gap:12px;margin:22px 0 0;}
.gfs-cmb__c{position:relative;background:#fff;border:2px solid rgba(var(--brand-primary-rgb),.16);
  border-radius:20px;padding:20px 18px;text-align:center;transition:transform .3s cubic-bezier(.16,1,.3,1),box-shadow .3s,border-color .3s;}
.gfs-cmb__c:hover{transform:translateY(-4px);box-shadow:0 16px 34px rgba(var(--brand-primary-rgb),.14);}
.gfs-cmb__c--hot{border-color:var(--cta);box-shadow:0 14px 32px rgba(var(--cta-rgb),.20);}
.gfs-cmb__tag{position:absolute;top:-11px;left:50%;transform:translateX(-50%);white-space:nowrap;
  background:var(--cta);color:#fff;font-size:10.5px;font-weight:800;letter-spacing:1.2px;
  border-radius:999px;padding:5px 13px;}
.gfs-cmb__c:not(.gfs-cmb__c--hot) .gfs-cmb__tag{background:var(--brand-primary);}
.gfs-cmb__n{margin:0 0 6px;font-size:15px;font-weight:800;color:var(--brand-dark);letter-spacing:.3px;}
.gfs-cmb__p{margin:0;font-size:30px;font-weight:900;color:var(--brand-dark);letter-spacing:-1px;line-height:1;}
.gfs-cmb__a{margin:7px 0 0;font-size:13.5px;font-weight:700;color:var(--cta-dark);}
.gfs-cmb__note{margin:18px auto 0;text-align:center;font-size:13.5px;color:#7A7A7A;max-width:520px;}
@media(min-width:900px){
  .gfs-cmb{padding:40px 24px 10px;}
  .gfs-cmb__t{font-size:40px;}
  .gfs-cmb__grid{grid-template-columns:repeat(3,1fr);gap:22px;margin-top:34px;}
  .gfs-cmb__c{padding:30px 24px;border-radius:24px;}
  .gfs-cmb__p{font-size:38px;}
  .gfs-cmb__n{font-size:17px;}
  .gfs-cmb__note{font-size:15px;}
}
</style>
<section class="gfs-cmb">
  <div class="gfs-cmb__head">
    <span class="gfs-cmb__k gfs-r">{{ KICKER }}</span>
    <h2 class="gfs-cmb__t gfs-r" style="--d:80ms">{{ TITULO }}</h2>
    <p class="gfs-cmb__r gfs-r" style="--d:150ms">{{ RAZON }}</p>
  </div>
  <div class="gfs-cmb__grid">
    <div class="gfs-cmb__c gfs-r" style="--d:120ms">
      {% if C1_TAG != blank %}<span class="gfs-cmb__tag">{{ C1_TAG }}</span>{% endif %}
      <p class="gfs-cmb__n">{{ C1_N }}</p><p class="gfs-cmb__p">{{ C1_P }}</p>
      {% if C1_A != blank %}<p class="gfs-cmb__a">{{ C1_A }}</p>{% endif %}
    </div>
    <div class="gfs-cmb__c gfs-cmb__c--hot gfs-r" style="--d:200ms">
      {% if C2_TAG != blank %}<span class="gfs-cmb__tag">{{ C2_TAG }}</span>{% endif %}
      <p class="gfs-cmb__n">{{ C2_N }}</p><p class="gfs-cmb__p">{{ C2_P }}</p>
      {% if C2_A != blank %}<p class="gfs-cmb__a">{{ C2_A }}</p>{% endif %}
    </div>
    <div class="gfs-cmb__c gfs-r" style="--d:280ms">
      {% if C3_TAG != blank %}<span class="gfs-cmb__tag">{{ C3_TAG }}</span>{% endif %}
      <p class="gfs-cmb__n">{{ C3_N }}</p><p class="gfs-cmb__p">{{ C3_P }}</p>
      {% if C3_A != blank %}<p class="gfs-cmb__a">{{ C3_A }}</p>{% endif %}
    </div>
  </div>
  <p class="gfs-cmb__note gfs-r" style="--d:340ms">{{ NOTA }}</p>
  <div class="gfs-cta-wrap"><button class="gfs-cta" type="button" data-cod><span>{{ BTN }}</span></button></div>
</section>
