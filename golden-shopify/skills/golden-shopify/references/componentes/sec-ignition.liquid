{% assign IGN_TITLE = "⚡ PRODUCTO DEMO ⚡" %}
{% assign IGN_SUBTITLE = "LO QUE ESTABAS BUSCANDO" %}
{% assign IGN_COLOR = "var(--brand-primary)" %}
{% assign IGN_BRIGHT = "var(--brand-bright)" %}

<div class="gfs-ignition" aria-hidden="true">
  <div class="gfs-ignition__core"></div>
  <div class="gfs-ignition__rays"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
  <div class="gfs-ignition__content">
    <div class="gfs-ignition__title">{{ IGN_TITLE }}</div>
    <div class="gfs-ignition__subtitle">{{ IGN_SUBTITLE }}</div>
  </div>
</div>
<style>
/* === IGNITION OVERLAY === */
.gfs-ignition{position:fixed;inset:0;z-index:99999;pointer-events:none;overflow:hidden;display:flex;align-items:center;justify-content:center;background:radial-gradient(ellipse at center,#1a0808 0%,#000 70%);animation:gfsIgnitionFade 2.4s .1s cubic-bezier(.65,0,.35,1) forwards;}
.gfs-ignition__core{position:absolute;top:50%;left:50%;width:80px;height:80px;border-radius:50%;background:radial-gradient(circle,#fff 0%,#ffeaa7 18%,{{ IGN_BRIGHT }} 40%,{{ IGN_COLOR }} 65%,transparent 85%);transform:translate(-50%,-50%) scale(0);filter:blur(2px);box-shadow:0 0 100px {{ IGN_BRIGHT }},0 0 200px {{ IGN_COLOR }};animation:gfsCoreExplode 1.9s cubic-bezier(.22,1,.36,1) forwards;}
.gfs-ignition__rays{position:absolute;top:50%;left:50%;width:0;height:0;}
.gfs-ignition__rays span{position:absolute;top:0;left:0;width:3px;height:120vh;margin-left:-1.5px;margin-top:-120vh;background:linear-gradient(to bottom,transparent 0%,{{ IGN_BRIGHT }} 40%,#fff 50%,{{ IGN_BRIGHT }} 60%,transparent 100%);transform-origin:50% 100%;opacity:0;box-shadow:0 0 20px {{ IGN_BRIGHT }};animation:gfsRayBurst 1.7s .25s cubic-bezier(.16,1,.3,1) forwards;}
.gfs-ignition__rays span:nth-child(1){transform:rotate(0deg);}
.gfs-ignition__rays span:nth-child(2){transform:rotate(45deg);animation-delay:.30s;}
.gfs-ignition__rays span:nth-child(3){transform:rotate(90deg);animation-delay:.28s;}
.gfs-ignition__rays span:nth-child(4){transform:rotate(135deg);animation-delay:.33s;}
.gfs-ignition__rays span:nth-child(5){transform:rotate(180deg);animation-delay:.26s;}
.gfs-ignition__rays span:nth-child(6){transform:rotate(225deg);animation-delay:.31s;}
.gfs-ignition__rays span:nth-child(7){transform:rotate(270deg);animation-delay:.27s;}
.gfs-ignition__rays span:nth-child(8){transform:rotate(315deg);animation-delay:.32s;}
.gfs-ignition__content{position:relative;z-index:5;text-align:center;}
.gfs-ignition__title{font-family:'Arial Black','Helvetica Neue',sans-serif;font-size:clamp(38px,8vw,96px);font-weight:900;color:#fff;letter-spacing:6px;line-height:1;text-shadow:0 0 30px {{ IGN_BRIGHT }},0 0 60px {{ IGN_COLOR }},0 0 100px {{ IGN_COLOR }};animation:gfsTitleEntrance 1.4s .4s cubic-bezier(.34,1.56,.64,1) backwards;}
.gfs-ignition__subtitle{margin-top:14px;font-family:'Montserrat','Arial',sans-serif;font-size:clamp(11px,1.5vw,16px);font-weight:700;color:{{ IGN_BRIGHT }};letter-spacing:6px;text-transform:uppercase;animation:gfsSubtitleEntrance 1.2s .8s cubic-bezier(.16,1,.3,1) backwards;}

@keyframes gfsIgnitionFade{0%,65%{opacity:1;}100%{opacity:0;visibility:hidden;transform:scale(1.08);}}
@keyframes gfsCoreExplode{0%{opacity:0;transform:translate(-50%,-50%) scale(0);}15%{opacity:1;transform:translate(-50%,-50%) scale(1);}55%{opacity:1;transform:translate(-50%,-50%) scale(6);filter:blur(8px);}100%{opacity:0;transform:translate(-50%,-50%) scale(28);filter:blur(20px);}}
@keyframes gfsRayBurst{0%{opacity:0;height:0;}25%{opacity:1;}70%{opacity:1;height:120vh;}100%{opacity:0;}}
@keyframes gfsTitleEntrance{0%{opacity:0;transform:scale(.3) rotate(-4deg);filter:blur(20px);letter-spacing:40px;}55%{opacity:1;transform:scale(1.18) rotate(1deg);filter:blur(0);letter-spacing:4px;}100%{opacity:1;transform:scale(1) rotate(0);letter-spacing:6px;}}
@keyframes gfsSubtitleEntrance{0%{opacity:0;letter-spacing:36px;}100%{opacity:1;letter-spacing:6px;}}

/* === EFECTOS PERMANENTES SOBRE EL HEADER (despues que la ignicion termina) === */
.shopify-section-group-header-group{position:relative !important;}
.shopify-section-group-header-group::before{content:"";position:absolute;inset:0;background:radial-gradient(2px 2px at 10% 80%,{{ IGN_BRIGHT }},transparent 70%),radial-gradient(1.5px 1.5px at 25% 90%,{{ IGN_COLOR }},transparent 70%),radial-gradient(2px 2px at 50% 75%,#ff8c50,transparent 70%),radial-gradient(2.5px 2.5px at 70% 85%,{{ IGN_COLOR }},transparent 70%),radial-gradient(1.5px 1.5px at 85% 90%,{{ IGN_BRIGHT }},transparent 70%);animation:gfsHdrEmbers 4s 2.4s ease-out infinite backwards;pointer-events:none;z-index:1;}

@keyframes gfsHdrEmbers{0%{opacity:0;transform:translateY(0);}20%{opacity:.9;}100%{opacity:0;transform:translateY(-80%);}}

/* Logo con "respiracion" permanente (glow palpitante) */


/* Hover dramatico del logo */
.header__heading:hover img,.header__heading-link:hover img{transform:scale(1.06);transition:transform .3s ease;}
</style>
<style>/* === G3.15: reduced-motion => el intro NO se muestra (el JS tambien lo remueve) === */
@media (prefers-reduced-motion: reduce){
  .gfs-ignition{display:none !important;}
}
/* === Mobile: mas tiempo visible para que de tiempo a leer === */
@media (max-width:749px){
  .gfs-ignition{animation-duration:3.4s !important;}
  .gfs-ignition__title{font-size:42px !important;letter-spacing:3px !important;}
  .gfs-ignition__subtitle{font-size:11px !important;letter-spacing:4px !important;}
}
</style>
<script>
(function(){
  var g=document.querySelector('.gfs-ignition');if(!g)return;
  /* G3.16 RE-PARENT: si el bloque vive dentro del main (Dawn anima contenedores con transform), position:fixed queda atrapado como un CUADRITO local. Colgarlo del body lo hace pantalla completa SIEMPRE. */
  if(g.parentNode!==document.body){document.body.appendChild(g);}
  var gone=false;
  function kill(){if(gone||!g)return;gone=true;g.style.transition='opacity .5s ease';g.style.opacity='0';setTimeout(function(){if(g&&g.parentNode){g.parentNode.removeChild(g);}g=null;},550);}
  function killNow(){if(gone||!g)return;gone=true;if(g.parentNode){g.parentNode.removeChild(g);}g=null;}
  try{if(sessionStorage.getItem('gfs_ign_seen')){killNow();return;}sessionStorage.setItem('gfs_ign_seen','1');}catch(e){}
  if(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches){killNow();return;}
  ['pointerdown','touchstart','wheel','keydown','scroll'].forEach(function(ev){window.addEventListener(ev,kill,{once:true,passive:true});});
  var life=(window.innerWidth<750)?3400:2500;
  if(document.visibilityState==='hidden'){document.addEventListener('visibilitychange',function h(){if(document.visibilityState==='visible'){document.removeEventListener('visibilitychange',h);setTimeout(kill,life);}});}
  else{setTimeout(kill,life);}
  setTimeout(killNow,7000);
  window.addEventListener('pagehide',killNow);
})();
</script>
