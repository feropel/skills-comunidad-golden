{% assign TITLE    = "El Viaje de tu Fragancia" %}
{% assign SUBTITLE = "Tres capítulos de una misma historia" %}
{% assign LEVEL1_LABEL = "El Primer Encuentro" %}
{% assign LEVEL1_NOTES = "Almendra · Café · Bergamota" %}
{% assign LEVEL1_ICON  = "🍃" %}
{% assign LEVEL2_LABEL = "Tu Esencia" %}
{% assign LEVEL2_NOTES = "Tuberosa · Jazmín · Rosa" %}
{% assign LEVEL2_ICON  = "🌸" %}
{% assign LEVEL3_LABEL = "La Huella que Queda" %}
