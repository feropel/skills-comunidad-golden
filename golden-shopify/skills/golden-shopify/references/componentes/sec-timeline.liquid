{% assign TITLE = "Qué esperar, paso a paso" %}
{% assign SUB = "Resultados realistas. Varían según la persona y el caso." %}
{% assign S1_T = "Días 1 a 3" %}{% assign S1_X = "Empiezas a usarlo según las instrucciones. Actúa sobre la zona desde la primera aplicación." %}
{% assign S2_T = "Días 3 a 7" %}{% assign S2_X = "Notas los primeros cambios visibles con el uso constante." %}
{% assign S3_T = "Semana 2" %}{% assign S3_X = "El avance se hace más evidente; mantén la constancia." %}
{% assign S4_T = "Resultado" %}{% assign S4_X = "Mejor aspecto y más confianza. La clave es no abandonar el uso." %}

{% comment %} ═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══ {% endcomment %}
<style>
.gfs-tl{max-width:600px;margin:8px auto;padding:0 18px;box-sizing:border-box;}
.gfs-tl__title{text-align:center;font-size:24px;font-weight:800;color:#1a1a1a;margin:0 0 4px;}
.gfs-tl__sub{text-align:center;font-size:14px;color:#777;margin:0 0 22px;font-style:italic;}
.gfs-tl__steps{position:relative;}
.gfs-tl__steps::before{content:"";position:absolute;left:21px;top:8px;bottom:8px;width:3px;background:linear-gradient(180deg,var(--brand-bright,#ff5247),var(--brand-dark,#8e1c19));border-radius:3px;}
.gfs-tl__step{position:relative;display:flex;gap:16px;margin-bottom:16px;}
.gfs-tl__num{position:relative;z-index:2;flex:0 0 44px;width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--brand-bright,#ff5247),var(--brand-primary,#b82622));color:#fff;font-weight:900;font-size:16px;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(var(--brand-primary-rgb),.3);border:3px solid #fff;}
.gfs-tl__body{padding-top:3px;text-align:left;}
.gfs-tl__t{font-size:15.5px;font-weight:800;color:var(--brand-dark,#8e1c19);margin:0 0 3px;}
.gfs-tl__x{font-size:14px;color:#555;line-height:1.5;margin:0;}
@media(min-width:990px){.gfs-tl{max-width:840px;}.gfs-tl__title{font-size:30px;}.gfs-tl__steps{display:grid;grid-template-columns:1fr 1fr;gap:8px 36px;}.gfs-tl__steps::before{display:none;}.gfs-tl__step{margin-bottom:8px;}}
</style>
<div class="gfs-tl">
  <p class="gfs-tl__title">{{ TITLE }}</p>
  <p class="gfs-tl__sub">{{ SUB }}</p>
  <div class="gfs-tl__steps">
    <div class="gfs-tl__step"><div class="gfs-tl__num" aria-hidden="true">1</div><div class="gfs-tl__body"><p class="gfs-tl__t">{{ S1_T }}</p><p class="gfs-tl__x">{{ S1_X }}</p></div></div>
    <div class="gfs-tl__step"><div class="gfs-tl__num" aria-hidden="true">2</div><div class="gfs-tl__body"><p class="gfs-tl__t">{{ S2_T }}</p><p class="gfs-tl__x">{{ S2_X }}</p></div></div>
    <div class="gfs-tl__step"><div class="gfs-tl__num" aria-hidden="true">3</div><div class="gfs-tl__body"><p class="gfs-tl__t">{{ S3_T }}</p><p class="gfs-tl__x">{{ S3_X }}</p></div></div>
    <div class="gfs-tl__step"><div class="gfs-tl__num" aria-hidden="true">4</div><div class="gfs-tl__body"><p class="gfs-tl__t">{{ S4_T }}</p><p class="gfs-tl__x">{{ S4_X }}</p></div></div>
  </div>
</div>
