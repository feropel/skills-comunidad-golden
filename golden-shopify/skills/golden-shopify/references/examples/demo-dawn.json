    "seccion_faq": {
      "type": "custom-liquid",
      "name": "PREGUNTAS FRECUENTES",
      "settings": {
        "visibility": "always-display",
        "custom_liquid": "{%- comment -%}\n═══════════════════════════════════════════════════\n  📝 EDITAR AQUI — PREGUNTAS FRECUENTES — glassmorphism premium\n═══════════════════════════════════════════════════\n{%- endcomment -%}\n\n{% assign TITLE = \"Preguntas Frecuentes\" %}\n\n{% assign Q1 = \"Cómo viene presentado el perfume?\" %}\n{% assign A1 = \"Llega en su empaque <strong>sellado y en perfecto estado</strong>, presentación elegante lista para estrenar o regalar.\" %}\n\n{% assign Q2 = \"Cuánto dura en la piel?\" %}\n{% assign A2 = \"Es una fragancia de <strong>larga duración y alta fijación</strong>: te acompaña por muchas horas y deja una estela que se nota.\" %}\n\n{% assign Q3 = \"Cómo y cuándo pago?\" %}\n{% assign A3 = \"<strong>Pago contra entrega:</strong> pagas en efectivo cuando el transportador te entrega el pedido en la puerta de tu casa. Sin transferencias ni adelantos.\" %}\n\n{% assign Q4 = \"Cuánto demora el envío?\" %}\n{% assign A4 = \"El envío es <strong>gratis a todo el país</strong> y llega normalmente entre <strong>3 y 7 días hábiles</strong>.\" %}\n\n{% assign Q5 = \"Y si tengo algún problema con mi pedido?\" %}\n{% assign A5 = \"Escríbenos por WhatsApp y nuestro equipo te ayuda. Queremos que tu compra sea una experiencia tranquila y segura.\" %}\n\n{% assign ACCENT_COLOR = \"#0F6F5C\" %}\n\n{%- comment -%}\n═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══\n{%- endcomment -%}\n\n<style>\n.pe-faq{max-width:560px;margin:8px auto;box-sizing:border-box;padding:0 14px;}\n.pe-faq__title{text-align:center;font-size:23px;font-weight:800;color:#1a1a1a;letter-spacing:.4px;margin:0 0 18px;font-family:'Cormorant Garamond',Georgia,serif;}\n.pe-faq__item{background:rgba(255,255,255,.65);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid rgba(15,111,92,.15);border-radius:14px;margin-bottom:10px;overflow:hidden;box-shadow:0 4px 14px rgba(0,0,0,.04),inset 0 1px 0 rgba(255,255,255,.6);position:relative;}\n.pe-faq__item::before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:0;background:linear-gradient(180deg,{{ ACCENT_COLOR }},#0B5345);border-radius:14px 0 0 14px;transition:width .35s cubic-bezier(.16,1,.3,1);}\n.pe-faq__item.pe-open::before{width:4px;}\n.pe-faq__q{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 16px;cursor:pointer;font-size:14.5px;font-weight:700;color:#1a1a1a;text-align:left;position:relative;}\n.pe-faq__q::after{content:\"+\";font-size:22px;font-weight:700;color:{{ ACCENT_COLOR }};flex:0 0 auto;transition:transform .35s cubic-bezier(.16,1,.3,1);}\n.pe-faq__item.pe-open .pe-faq__q::after{transform:rotate(45deg);}\n.pe-faq__a{max-height:0;overflow:hidden;transition:max-height .4s cubic-bezier(.16,1,.3,1);}\n.pe-faq__a p{padding:0 16px 14px;margin:0;font-size:14px;color:#555;line-height:1.6;text-align:left;}\n@media(min-width:990px){.pe-faq{max-width:720px;}.pe-faq__title{font-size:30px;}}\n</style>\n<div class=\"pe-faq\">\n  <p class=\"pe-faq__title\">{{ TITLE }}</p>\n  <div class=\"pe-faq__item\"><div class=\"pe-faq__q\">{{ Q1 }}</div><div class=\"pe-faq__a\"><p>{{ A1 }}</p></div></div>\n  <div class=\"pe-faq__item\"><div class=\"pe-faq__q\">{{ Q2 }}</div><div class=\"pe-faq__a\"><p>{{ A2 }}</p></div></div>\n  <div class=\"pe-faq__item\"><div class=\"pe-faq__q\">{{ Q3 }}</div><div class=\"pe-faq__a\"><p>{{ A3 }}</p></div></div>\n  <div class=\"pe-faq__item\"><div class=\"pe-faq__q\">{{ Q4 }}</div><div class=\"pe-faq__a\"><p>{{ A4 }}</p></div></div>\n  <div class=\"pe-faq__item\"><div class=\"pe-faq__q\">{{ Q5 }}</div><div class=\"pe-faq__a\"><p>{{ A5 }}</p></div></div>\n</div>\n<script>\n(function(){var items=document.querySelectorAll('.pe-faq__item');items.forEach(function(it){var q=it.querySelector('.pe-faq__q');var a=it.querySelector('.pe-faq__a');q.addEventListener('click',function(){var open=it.classList.contains('pe-open');items.forEach(function(o){o.classList.remove('pe-open');o.querySelector('.pe-faq__a').style.maxHeight='0';});if(!open){it.classList.add('pe-open');a.style.maxHeight=a.scrollHeight+'px';}});});})();\n</script>",
