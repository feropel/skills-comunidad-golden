        "custom_liquid_countdown": {
          "type": "custom_liquid",
          "name": "4 OFERTA TERMINA EN (ocultable)",
          "settings": {
            "custom_liquid": "{%- comment -%}\n═══════════════════════════════════════════════════\n  📝 EDITAR AQUI — OFERTA TERMINA EN (contador 15 minutos)\n═══════════════════════════════════════════════════\n{%- endcomment -%}\n\n{% assign LABEL_TEXT       = \"⏰ La oferta termina en\" %}\n{% assign DURATION_MINUTES = 15 %}\n\n{% assign ACCENT_COLOR = \"#0F6F5C\" %}\n{% assign BG_COLOR     = \"#EEF6F3\" %}\n\n{%- comment -%}\n═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══\n{%- endcomment -%}\n\n<style>\n.gg-countdown{display:flex;align-items:center;justify-content:center;gap:8px;max-width:520px;margin:10px auto 0;padding:8px 14px;background:{{ BG_COLOR }};border:1px dashed {{ ACCENT_COLOR }};border-radius:10px;box-sizing:border-box;}\n.gg-cd-label{font-size:14px;font-weight:600;color:#1a1a1a;}\n.gg-cd-time{font-size:18px;font-weight:800;color:#ffffff;background:{{ ACCENT_COLOR }};padding:3px 10px;border-radius:6px;letter-spacing:.5px;}\n</style>\n<div class=\"gg-countdown\">\n  <span class=\"gg-cd-label\">{{ LABEL_TEXT }}</span>\n  <span class=\"gg-cd-time\" id=\"gg-cd-time\">{{ DURATION_MINUTES }}:00</span>\n</div>\n<script>\n(function(){\n  var DURATION={{ DURATION_MINUTES }}*60*1000;var KEY='gg_cd_end';\n  var el=document.getElementById('gg-cd-time');if(!el)return;\n  var end=parseInt(localStorage.getItem(KEY)||'0',10);\n  if(!end||end<Date.now()){end=Date.now()+DURATION;localStorage.setItem(KEY,end);}\n  function tick(){var diff=end-Date.now();if(diff<=0){end=Date.now()+DURATION;localStorage.setItem(KEY,end);diff=DURATION;}var m=Math.floor(diff/60000);var s=Math.floor((diff%60000)/1000);el.textContent=(m<10?'0':'')+m+':'+(s<10?'0':'')+s;}\n  tick();setInterval(tick,1000);\n})();\n</script>"
          }
        }
