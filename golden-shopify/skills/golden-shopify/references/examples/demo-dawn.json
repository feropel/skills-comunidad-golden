      "settings": {
        "visibility": "always-display",
        "custom_liquid": "{%- comment -%}\n═══════════════════════════════════════════════════\n  📝 EDITAR AQUI — RESENAS DE CLIENTAS — glassmorphism + tilt\n═══════════════════════════════════════════════════\n{%- endcomment -%}\n\n{% assign TITLE       = \"Lo que dicen quienes ya la usan\" %}\n{% assign COUNT_TEXT  = \"Basado en compras verificadas\" %}\n\n{% assign ACCENT_COLOR = \"#0F6F5C\" %}\n{% assign BG_TAG       = \"#EEF6F3\" %}\n\n{%- comment -%}\n═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══\n{%- endcomment -%}\n\n<style>\n.pe-reviews{max-width:560px;margin:8px auto;box-sizing:border-box;padding:0 14px;}\n.pe-reviews__head{text-align:center;margin-bottom:18px;}\n.pe-reviews__title{font-size:23px;font-weight:800;color:#1a1a1a;letter-spacing:.4px;margin:0 0 4px;font-family:'Cormorant Garamond',Georgia,serif;}\n.pe-reviews__stars{font-size:16px;color:#f6c701;letter-spacing:2px;}\n.pe-reviews__count{font-size:13px;color:#6b6b6b;margin-top:2px;font-style:italic;}\n.pe-reviews__list{display:flex;flex-direction:column;gap:12px;perspective:1100px;}\n.pe-review{background:rgba(255,255,255,.7);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(0,0,0,.06);border-radius:16px;padding:16px 18px;box-shadow:0 8px 28px rgba(0,0,0,.08),inset 0 1px 0 rgba(255,255,255,.7);transform-style:preserve-3d;}\n.pe-review__top{display:flex;align-items:center;gap:12px;margin-bottom:8px;}\n.pe-review__avatar{flex:0 0 44px;width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,{{ ACCENT_COLOR }},#0B5345);color:#fff;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700;background-size:cover;background-position:center;box-shadow:0 4px 12px rgba(15,111,92,.35);}\n.pe-review__id{flex:1 1 auto;text-align:left;}\n.pe-review__name{font-size:15px;font-weight:700;color:#1a1a1a;margin:0;display:flex;align-items:center;gap:6px;flex-wrap:wrap;}\n.pe-review__verified{font-size:11px;font-weight:700;color:{{ ACCENT_COLOR }};background:{{ BG_TAG }};padding:2px 7px;border-radius:20px;}\n.pe-review__city{font-size:12px;color:#888;margin:2px 0 0;}\n.pe-review__stars{color:#f6c701;font-size:14px;letter-spacing:1px;}\n.pe-review__text{font-size:14px;color:#444;line-height:1.55;margin:0;text-align:left;}\n@media(min-width:990px){.pe-reviews{max-width:1000px;}.pe-reviews__title{font-size:30px;}.pe-reviews__list{flex-direction:row;align-items:stretch;}.pe-reviews__list .pe-review{flex:1 1 0;}}\n</style>\n<div class=\"pe-reviews\">\n  <div class=\"pe-reviews__head\">\n    <p class=\"pe-reviews__title\">{{ TITLE }}</p>\n    <div class=\"pe-reviews__stars\">★★★★★</div>\n    <p class=\"pe-reviews__count\">{{ COUNT_TEXT }}</p>\n  </div>\n  <div id=\"pe-reviews-list\" class=\"pe-reviews__list\"></div>\n</div>\n<script>\n/* ═══ EDITAR LAS RESEÑAS AQUI ↓  (image:\"\" muestra inicial. image:\"URL\" muestra foto) ═══ */\nwindow.GFS_REVIEWS = [\n  {name:\"Valentina G.\", city:\"Bogotá\",  stars:5, image:\"\", text:\"Lo uso desde hace 3 semanas y la gente literalmente me para por la calle a preguntar qué perfume es. Es mi nueva firma.\"},\n  {name:\"Daniela M.\",   city:\"Medellín\", stars:5, image:\"\", text:\"Llegó sellado, en perfecto estado, y pagué cuando me lo entregaron. La estela que deja… no exagero, es adictiva.\"},\n  {name:\"Carolina R.\",  city:\"Cali\",    stars:5, image:\"\", text:\"Yo ya soy cliente fija. Lo huelo en la mañana y me da seguridad todo el día. Vale cada peso.\"}\n];\n/* ═══ NO TOCAR ABAJO ═══ */\n(function(){var list=document.getElementById('pe-reviews-list');if(!list)return;var data=window.GFS_REVIEWS||[];data.forEach(function(r){var initials=r.name.trim().charAt(0).toUpperCase();var full=Math.max(0,Math.min(5,r.stars||0));var stars='★★★★★'.slice(0,full)+'☆☆☆☆☆'.slice(0,5-full);var avatarStyle=r.image?('background-image:url('+r.image+')'):'';var avatarText=r.image?'':initials;var el=document.createElement('div');el.className='pe-review';el.innerHTML='<div class=\"pe-review__top\"><div class=\"pe-review__avatar\" style=\"'+avatarStyle+'\">'+avatarText+'</div><div class=\"pe-review__id\"><p class=\"pe-review__name\">'+r.name+' <span class=\"pe-review__verified\">✓ Verificada</span></p><p class=\"pe-review__city\">'+r.city+'</p><div class=\"pe-review__stars\">'+stars+'</div></div></div><p class=\"pe-review__text\">'+r.text+'</p>';list.appendChild(el);});})();\n</script>",
        "color_scheme": "scheme-1",
        "padding_top": 20,
        "padding_bottom": 20
      }
