 fill=\"{{ STAR_EMPTY_COLOR }}\" d=\"M10 15l-5.878 3.09 1.123-6.545L.49 6.91l6.561-.954L10 0l2.949 5.956 6.561.954-4.755 4.635 1.123 6.545z\"/></svg>{%- endfor -%}\n  </div>\n  <div class=\"rating-number\"><span class=\"pe-counter\" data-target=\"{{ RATING_VALUE }}\">0.0</span>/5 {{ RATING_TEXT }} <img src=\"{{ GOOGLE_LOGO_URL }}\" alt=\"Google\" style=\"height:50px;\"></div>\n</div>\n<style>\n.product-rating{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:-10px;margin-bottom:-10px;}\n.product-rating .stars svg{display:inline-block;}\n.product-rating .rating-number{font-size:14px;color:{{ TEXT_COLOR }};display:flex;align-items:center;gap:8px;font-weight:500;}\n.pe-counter{display:inline-block;min-width:28px;font-variant-numeric:tabular-nums;font-weight:700;color:#1a1a1a;}\n</style>"
