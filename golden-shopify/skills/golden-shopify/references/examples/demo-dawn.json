        "custom_liquid": "{%- comment -%}\n═══════════════════════════════════════════════════\n  📝 EDITAR AQUI — TICKER TOP (texto desplazandose arriba)\n═══════════════════════════════════════════════════\n{%- endcomment -%}\n\n{% assign TEXT_1 = \"ENVÍO GRATIS A TODO EL PAÍS 🚚\" %}\n{% assign TEXT_2 = \"PAGA AL RECIBIR · CONTRA ENTREGA 💳\" %}\n{% assign TEXT_3 = \"FRAGANCIA DE LARGA DURACIÓN ✨\" %}\n\n{% assign BG_COLOR       = \"#ffffff\" %}\n{% assign TEXT_COLOR     = \"#121212\" %}\n{% assign SPEED_SECONDS  = 22 %}\n\n{%- comment -%}\n═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══\n{%- endcomment -%}\n\n<style>\n.pe-mq{overflow:hidden;background:{{ BG_COLOR }};border-top:1px solid #ececec;border-bottom:1px solid #ececec;}\n.pe-mq__track{display:flex;width:max-content;animation:peMqTop {{ SPEED_SECONDS }}s linear infinite;}\n.pe-mq__track span{padding:13px 34px;font-size:13.5px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:{{ TEXT_COLOR }};white-space:nowrap;}\n@keyframes peMqTop{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}\n</style>\n<div class=\"pe-mq\" aria-hidden=\"true\">\n  <div class=\"pe-mq__track\">\n    <span>{{ TEXT_1 }}</span><span>{{ TEXT_2 }}</span><span>{{ TEXT_3 }}</span>\n    <span>{{ TEXT_1 }}</span><span>{{ TEXT_2 }}</span><span>{{ TEXT_3 }}</span>\n  </div>\n</div>",
