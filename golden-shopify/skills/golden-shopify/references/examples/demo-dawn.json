        "custom_liquid": "{%- comment -%}\n═══════════════════════════════════════════════════\n  📝 EDITAR AQUI — POR QUE COMPRAR EN MARCA DEMO (4 beneficios)\n═══════════════════════════════════════════════════\n{%- endcomment -%}\n\n{% assign TITLE_TEXT = \"POR QUÉ COMPRAR EN MARCA DEMO?\" %}\n\n{% assign ITEM1_TITLE = \"CALIDAD GARANTIZADA\" %}\n{% assign ITEM1_DESC  = \"Productos premium seleccionados para resultados reales.\" %}\n\n{% assign ITEM2_TITLE = \"ATENCIÓN PERSONALIZADA\" %}\n{% assign ITEM2_DESC  = \"Te acompañamos antes, durante y después de tu compra.\" %}\n\n{% assign ITEM3_TITLE = \"PRECIOS COMPETITIVOS\" %}\n{% assign ITEM3_DESC  = \"Obtén el mejor valor sin pagar de más.\" %}\n\n{% assign ITEM4_TITLE = \"COMPRA SEGURA\" %}\n{% assign ITEM4_DESC  = \"Garantía y respaldo en cada pedido.\" %}\n\n{% assign BORDER_COLOR = \"#0F6F5C\" %}\n{% assign CHECK_BG     = \"#22c55e\" %}\n\n{%- comment -%}\n═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══\n{%- endcomment -%}\n\n<div class=\"gg-wrapper\">\n  <div class=\"gg-benefits\">\n    <h2 class=\"gg-title\">{{ TITLE_TEXT }}</h2>\n    <div class=\"gg-grid\">\n      <div class=\"gg-item\"><div class=\"gg-icon gg-check\">✔</div><h3>{{ ITEM1_TITLE }}</h3><p>{{ ITEM1_DESC }}</p></div>\n      <div class=\"gg-item\"><div class=\"gg-icon\">💬</div><h3>{{ ITEM2_TITLE }}</h3><p>{{ ITEM2_DESC }}</p></div>\n      <div class=\"gg-item\"><div class=\"gg-icon\">🏷</div><h3>{{ ITEM3_TITLE }}</h3><p>{{ ITEM3_DESC }}</p></div>\n      <div class=\"gg-item\"><div class=\"gg-icon\">🛡</div><h3>{{ ITEM4_TITLE }}</h3><p>{{ ITEM4_DESC }}</p></div>\n    </div>\n  </div>\n</div>\n<style>\n.gg-wrapper{display:flex;justify-content:center;padding:20px;}\n.gg-benefits{max-width:700px;width:100%;background:linear-gradient(180deg,#0d0f12 0%, #111418 100%);padding:30px 20px;border-radius:16px;text-align:center;box-shadow:0 10px 30px rgba(0,0,0,0.25);}\n.gg-title{font-size:28px;font-weight:800;margin-bottom:20px;color:#ffffff;}\n.gg-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;}\n.gg-item{background:rgba(255,255,255,0.04);border:2px solid {{ BORDER_COLOR }};padding:18px;border-radius:12px;}\n.gg-icon{font-size:60px;margin-bottom:12px;}\n.gg-check{display:inline-flex;align-items:center;justify-content:center;width:60px;height:60px;background:{{ CHECK_BG }};color:#ffffff;border-radius:50%;font-size:28px;box-shadow:0 4px 12px rgba(34,197,94,0.4);}\n.gg-item h3{font-size:18px;font-weight:700;margin-bottom:6px;color:#ffffff;}\n.gg-item p{font-size:14px;line-height:1.4;color:#BFBFBF;}\n@media(max-width:600px){.gg-grid{grid-template-columns:1fr;}.gg-benefits{max-width:95%;}}\n</style>",
