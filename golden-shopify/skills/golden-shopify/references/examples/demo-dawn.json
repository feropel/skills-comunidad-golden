            "custom_liquid": "{%- comment -%}\n═══════════════════════════════════════════════════\n  📝 EDITAR AQUI — STICKY (barra fija inferior con boton)\n═══════════════════════════════════════════════════\n{%- endcomment -%}\n\n{% assign BTN_TEXT          = \"PEDIR AHORA  ✨\" %}\n{% assign ACCENT_COLOR      = \"#0F6F5C\" %}\n{% assign BTN_HEIGHT        = \"50px\" %}\n{% assign SHOW_AFTER_SCROLL = 500 %}\n\n{%- comment -%}\n═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══\n{%- endcomment -%}\n\n<style>\n#gg-sticky-bar{position:fixed;left:0;right:0;bottom:0;z-index:9998;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 14px;background:#ffffff;border-top:1px solid #DCEAE5;box-shadow:0 -6px 24px rgba(0,0,0,.14);transform:translateY(115%);transition:transform .35s ease;box-sizing:border-box;}\n#gg-sticky-bar.gg-visible{transform:translateY(0);}\n.gg-sticky-price{display:flex;flex-direction:column;line-height:1.1;flex:0 0 auto;}\n.gg-sticky-price .gg-now{font-size:19px;font-weight:800;color:#1a1a1a;}\n.gg-sticky-price .gg-was{font-size:13px;color:#9a9a9a;text-decoration:line-through;}\n#gg-sticky-btn{flex:1 1 auto;max-width:380px;height:{{ BTN_HEIGHT }};border:none;border-radius:14px;background:{{ ACCENT_COLOR }};color:#ffffff;font-size:16px;font-weight:800;letter-spacing:.3px;cursor:pointer;box-shadow:0 6px 16px rgba(15,111,92,.45);animation:ggStickyPulse 1.8s infinite;}\n#gg-sticky-btn:active{transform:scale(.98);}\n@keyframes ggStickyPulse{0%{transform:scale(1)}50%{transform:scale(1.03)}100%{transform:scale(1)}}\n@media(max-width:749px){#gg-sticky-bar{padding:8px 12px}.gg-sticky-price .gg-now{font-size:17px}#gg-sticky-btn{height:48px;font-size:15px}}\n</style>\n<div id=\"gg-sticky-bar\" aria-hidden=\"true\">\n  <div class=\"gg-sticky-price\">\n    <span class=\"gg-now\">{{ product.selected_or_first_available_variant.price | money }}</span>\n    {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}\n      <span class=\"gg-was\">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>\n    {% endif %}\n  </div>\n  <button id=\"gg-sticky-btn\" type=\"button\">{{ BTN_TEXT }}</button>\n</div>\n<script>\n(function(){var bar=document.getElementById('gg-sticky-bar');var btn=document.getElementById('gg-sticky-btn');if(!bar||!btn)return;document.body.style.paddingBottom='80px';function onScroll(){if(window.scrollY>{{ SHOW_AFTER_SCROLL }}){bar.classList.add('gg-visible');}else{bar.classList.remove('gg-visible');}}window.addEventListener('scroll',onScroll,{passive:true});onScroll();btn.addEventListener('click',function(){var main=document.getElementById('custom-releasit-btn');if(main){main.click();}});})();\n</script>"
          }
