    "seccion_manifiesto": {
      "type": "custom-liquid",
      "name": "MANIFIESTO",
      "settings": {
        "visibility": "always-display",
        "custom_liquid": "{%- comment -%}\n═══════════════════════════════════════════════════\n  📝 EDITAR AQUI — MANIFIESTO CINEMATOGRAFICO (seccion nueva con particulas)\n═══════════════════════════════════════════════════\n{%- endcomment -%}\n\n{% assign LINE_1 = \"Hay mujeres que pasan.\" %}\n{% assign LINE_2 = \"Hay mujeres que se notan.\" %}\n{% assign LINE_3 = \"Y hay mujeres\" %}\n{% assign LINE_4 = \"que dejan huella.\" %}\n{% assign CLOSING = \"Este perfume es para las terceras.\" %}\n\n{% assign BG_FROM      = \"#0d0f12\" %}\n{% assign BG_TO        = \"#0F6F5C\" %}\n{% assign TEXT_COLOR   = \"#ffffff\" %}\n{% assign ACCENT_COLOR = \"#E8F5F1\" %}\n\n{%- comment -%}\n═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══\n{%- endcomment -%}\n\n<style>\n.pe-manifesto{position:relative;background:linear-gradient(135deg,{{ BG_FROM }} 0%,{{ BG_TO }} 100%);padding:70px 24px;overflow:hidden;text-align:center;color:{{ TEXT_COLOR }};box-sizing:border-box;}\n.pe-manifesto__particles{position:absolute;inset:0;pointer-events:none;}\n.pe-manifesto__particles span{position:absolute;width:5px;height:5px;border-radius:50%;background:{{ ACCENT_COLOR }};opacity:.45;animation:peFloat 14s linear infinite;bottom:-10px;box-shadow:0 0 6px {{ ACCENT_COLOR }};}\n.pe-manifesto__particles span:nth-child(1){left:6%;animation-delay:0s;animation-duration:11s;}\n.pe-manifesto__particles span:nth-child(2){left:14%;animation-delay:2s;animation-duration:13s;}\n.pe-manifesto__particles span:nth-child(3){left:22%;animation-delay:4s;animation-duration:10s;}\n.pe-manifesto__particles span:nth-child(4){left:32%;animation-delay:1s;animation-duration:15s;}\n.pe-manifesto__particles span:nth-child(5){left:42%;animation-delay:3s;animation-duration:12s;}\n.pe-manifesto__particles span:nth-child(6){left:52%;animation-delay:5s;animation-duration:11s;}\n.pe-manifesto__particles span:nth-child(7){left:62%;animation-delay:0s;animation-duration:14s;}\n.pe-manifesto__particles span:nth-child(8){left:72%;animation-delay:2s;animation-duration:13s;}\n.pe-manifesto__particles span:nth-child(9){left:82%;animation-delay:4s;animation-duration:10s;}\n.pe-manifesto__particles span:nth-child(10){left:92%;animation-delay:6s;animation-duration:12s;}\n.pe-manifesto__particles span:nth-child(11){left:18%;animation-delay:7s;animation-duration:14s;width:3px;height:3px;}\n.pe-manifesto__particles span:nth-child(12){left:38%;animation-delay:8s;animation-duration:11s;width:3px;height:3px;}\n.pe-manifesto__particles span:nth-child(13){left:58%;animation-delay:9s;animation-duration:13s;width:3px;height:3px;}\n.pe-manifesto__particles span:nth-child(14){left:78%;animation-delay:10s;animation-duration:12s;width:3px;height:3px;}\n.pe-manifesto__particles span:nth-child(15){left:48%;animation-delay:11s;animation-duration:15s;width:7px;height:7px;opacity:.3;}\n@keyframes peFloat{0%{transform:translateY(0) translateX(0);opacity:0;}10%{opacity:.55;}90%{opacity:.4;}100%{transform:translateY(-120vh) translateX(30px);opacity:0;}}\n.pe-manifesto__content{position:relative;max-width:680px;margin:0 auto;}\n.pe-manifesto__line{font-size:22px;line-height:1.4;margin:0 0 6px;font-weight:300;letter-spacing:.3px;color:{{ TEXT_COLOR }};opacity:0;transform:translateY(20px);transition:opacity 1s cubic-bezier(.16,1,.3,1),transform 1s cubic-bezier(.16,1,.3,1);font-family:'Cormorant Garamond',Georgia,serif;}\n.pe-manifesto__line.pe-shown{opacity:1;transform:translateY(0);}\n.pe-manifesto__line strong{color:{{ ACCENT_COLOR }};font-weight:700;}\n.pe-manifesto__closing{margin-top:34px;font-size:12px;text-transform:uppercase;letter-spacing:3px;color:{{ ACCENT_COLOR }};opacity:0;transition:opacity 1.2s ease 1.7s;}\n.pe-manifesto.pe-show .pe-manifesto__closing{opacity:.9;}\n@media(min-width:990px){.pe-manifesto{padding:110px 24px;}.pe-manifesto__line{font-size:34px;}}\n</style>\n<section class=\"pe-manifesto\">\n  <div class=\"pe-manifesto__particles\">\n    <span></span><span></span><span></span><span></span><span></span>\n    <span></span><span></span><span></span><span></span><span></span>\n    <span></span><span></span><span></span><span></span><span></span>\n  </div>\n  <div class=\"pe-manifesto__content\">\n    <p class=\"pe-manifesto__line\" data-delay=\"0\">{{ LINE_1 }}</p>\n    <p class=\"pe-manifesto__line\" data-delay=\"350\">{{ LINE_2 }}</p>\n    <p class=\"pe-manifesto__line\" data-delay=\"700\">{{ LINE_3 }}</p>\n    <p class=\"pe-manifesto__line\" data-delay=\"1050\"><strong>{{ LINE_4 }}</strong></p>\n    <p class=\"pe-manifesto__closing\">{{ CLOSING }}</p>\n  </div>\n</section>\n<script>\n(function(){\n  var section=document.querySelector('.pe-manifesto');if(!section)return;\n  var lines=section.querySelectorAll('.pe-manifesto__line');\n  var io=new IntersectionObserver(function(entries){\n    entries.forEach(function(e){\n      if(e.isIntersecting){\n        section.classList.add('pe-show');\n        lines.forEach(function(l){var d=parseInt(l.dataset.delay||0,10);setTimeout(function(){l.classList.add('pe-shown');},d);});\n        io.unobserve(section);\n      }\n    });\n  },{threshold:0.25});\n  io.observe(section);\n})();\n</script>",
