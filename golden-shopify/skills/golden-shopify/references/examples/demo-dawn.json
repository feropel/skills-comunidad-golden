  <div class=\"logistics-line\"></div>\n  <div class=\"logistics-step\">\n    <div class=\"logistics-icon\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\"><path d=\"M3 7h12v10H3zM15 10h4l2 3v4h-6zM7 20a2 2 0 1 1 0-4m10 4a2 2 0 1 1 0-4\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div>\n    <div class=\"logistics-text-wrap\"><div class=\"logistics-title\">{{ STEP2_TITLE }}</div><div class=\"logistics-text\">{{ STEP2_TEXT }}</div></div>\n  </div>\n  <div class=\"logistics-line\"></div>\n  <div class=\"logistics-step\">\n    <div class=\"logistics-icon\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\"><path d=\"M20 7H4v14h16V7zM4 7h16M12 7v14M7 7s-2-1-2-3 3-2 5 1c0 0-1 2-3 2Zm10 0s2-1 2-3-3-2-5 1c0 0 1 2 3 2Z\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div>\n    <div class=\"logistics-text-wrap\"><div class=\"logistics-title\">{{ STEP3_TITLE }}</div><div class=\"logistics-text\">{{ STEP3_TEXT }}</div></div>\n  </div>\n</div>"
