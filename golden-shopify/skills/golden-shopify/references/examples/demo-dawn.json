          "settings": {
            "custom_liquid": "{%- comment -%}\n═══════════════════════════════════════════════════\n  📝 EDITAR AQUI — PROPUESTA DE VALOR — re-copy emocional\n═══════════════════════════════════════════════════\n{%- endcomment -%}\n\n{% assign BADGE_TEXT = \"DEJA TU HUELLA\" %}\n{% assign SUBTITLE_TEXT = \"Para la mujer que no pasa desapercibida\" %}\n\n{% assign ACCENT_COLOR = \"#0F6F5C\" %}\n{% assign DARK_ACCENT  = \"#0B5345\" %}\n{% assign BADGE_SIZE   = \"14px\" %}\n\n{%- comment -%}\n═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══\n{%- endcomment -%}\n\n<style>\n@keyframes ggPulseHighlight{0%{transform:scale(1);box-shadow:0 0 0 {{ ACCENT_COLOR }};}50%{transform:scale(1.05);box-shadow:0 0 10px {{ ACCENT_COLOR }};}100%{transform:scale(1);box-shadow:0 0 0 {{ ACCENT_COLOR }};}}\n.gg-formula-header{display:flex;flex-direction:column;align-items:center;}\n.gg-formula-badge{background:{{ ACCENT_COLOR }};color:#FFFFFF;padding:3px 14px;font-size:{{ BADGE_SIZE }};font-weight:700;border-radius:4px;text-transform:uppercase;text-align:center;letter-spacing:.6px;animation:ggPulseHighlight 2s infinite ease-in-out;box-shadow:0 4px 12px rgba(15,111,92,.3);}\n.gg-formula-subtitle{color:{{ DARK_ACCENT }};font-size:17px;margin-top:4px;font-style:italic;letter-spacing:.2px;}\n\n/* ═══ MOTOR DE ANIMACIONES GLOBALES ═══ */\n.gg-guarantee,.pe-pyramid,.pe-reviews,.pe-faq,.pe-manifesto,.logistics-bar,.gg-benefits{opacity:0;transform:translateY(28px);transition:opacity .85s cubic-bezier(.16,1,.3,1),transform .85s cubic-bezier(.16,1,.3,1);}\n.pe-revealed{opacity:1 !important;transform:translateY(0) !important;}\n.pe-review,.pe-note,.pe-faq__item{transition:transform .35s cubic-bezier(.16,1,.3,1),box-shadow .35s ease;transform-style:preserve-3d;will-change:transform;}\n</style>\n<div class=\"gg-formula-header\">\n  <span class=\"gg-formula-badge\">{{ BADGE_TEXT }}</span>\n  <span class=\"gg-formula-subtitle\">{{ SUBTITLE_TEXT }}</span>\n</div>\n\n<script>\ndocument.addEventListener('DOMContentLoaded',function(){\n  // REVEAL ON SCROLL (con fix anti-flash para arriba del fold)\n  var sel='.gg-guarantee,.pe-pyramid,.pe-reviews,.pe-faq,.pe-manifesto,.logistics-bar,.gg-benefits';\n  function inView(el){var r=el.getBoundingClientRect();return r.top<window.innerHeight*0.95 && r.bottom>0;}\n  var io=new IntersectionObserver(function(entries){\n    entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('pe-revealed');io.unobserve(e.target);}});\n  },{threshold:0.12,rootMargin:'0px 0px -40px 0px'});\n  document.querySelectorAll(sel).forEach(function(el){\n    if(inView(el)) el.classList.add('pe-revealed');\n    else io.observe(el);\n  });\n\n  // TILT 3D (tarjetas que se inclinan con el mouse)\n  document.querySelectorAll('.pe-review,.pe-note,.pe-faq__item').forEach(function(card){\n    card.addEventListener('mousemove',function(e){\n      var r=card.getBoundingClientRect();\n      var rx=((e.clientY-r.top-r.height/2)/(r.height/2))*-5;\n      var ry=((e.clientX-r.left-r.width/2)/(r.width/2))*5;\n      card.style.transform='perspective(900px) rotateX('+rx+'deg) rotateY('+ry+'deg) translateZ(8px)';\n    });\n    card.addEventListener('mouseleave',function(){\n      card.style.transform='perspective(900px) rotateX(0) rotateY(0) translateZ(0)';\n    });\n  });\n\n  // CONTADOR ANIMADO (4.9/5 sube de 0)\n  var cIO=new IntersectionObserver(function(entries){\n    entries.forEach(function(e){\n      if(e.isIntersecting){\n        var el=e.target;var t=parseFloat(el.dataset.target);\n        var d=(el.dataset.target.indexOf('.')>=0)?1:0;\n        var dur=1400;var start=performance.now();\n        function tick(now){\n          var p=Math.min((now-start)/dur,1);var eased=1-Math.pow(1-p,3);\n          el.textContent=(t*eased).toFixed(d);\n          if(p<1)requestAnimationFrame(tick);\n        }\n        requestAnimationFrame(tick);cIO.unobserve(el);\n      }\n    });\n  },{threshold:0.4});\n  document.querySelectorAll('.pe-counter').forEach(function(c){cIO.ob