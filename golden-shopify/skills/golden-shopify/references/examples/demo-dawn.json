            "custom_liquid": "{%- comment -%}\n═══════════════════════════════════════════════════\n  📝 EDITAR AQUI — TITULO DEL PRODUCTO (el texto viene del producto)\n═══════════════════════════════════════════════════\n{%- endcomment -%}\n\n{% assign TITLE_COLOR        = \"#1a1a1a\" %}\n{% assign ACCENT_LINE_COLOR  = \"#0F6F5C\" %}\n{% assign TITLE_SIZE_MOBILE  = \"25px\" %}\n{% assign TITLE_SIZE_DESKTOP = \"33px\" %}\n{% assign LINE_WIDTH         = \"54px\" %}\n{% assign MARGIN_TOP         = \"10px\" %}\n{% assign MARGIN_BOTTOM      = \"4px\" %}\n\n{%- comment -%}\n═══ ↓ NO TOCAR DE AQUI HACIA ABAJO ↓ ═══\n{%- endcomment -%}\n\n<style>\n.pe-ptitle{text-align:center;max-width:560px;margin:{{ MARGIN_TOP }} auto {{ MARGIN_BOTTOM }};padding:0 14px;box-sizing:border-box;}\n.pe-ptitle h1{margin:0;font-size:{{ TITLE_SIZE_MOBILE }};line-height:1.3;font-weight:800;color:{{ TITLE_COLOR }};letter-spacing:-.2px;}\n.pe-ptitle__line{width:{{ LINE_WIDTH }};height:3px;background:{{ ACCENT_LINE_COLOR }};border-radius:3px;margin:12px auto 0;}\n@media(min-width:990px){.pe-ptitle h1{font-size:{{ TITLE_SIZE_DESKTOP }};}}\n</style>\n<div class=\"pe-ptitle\">\n  <h1>{{ product.title }}</h1>\n  <div class=\"pe-ptitle__line\"></div>\n</div>"
          }
