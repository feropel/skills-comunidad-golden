a(0,0,0,.15);}\n#custom-releasit-btn:active{transform:translateY(3px);box-shadow:0 3px 0 {{ BTN_BG_DARK }},0 5px 10px rgba(15,111,92,.35),inset 0 1px 0 rgba(255,255,255,.2),inset 0 -1px 0 rgba(0,0,0,.15);}\n#custom-releasit-btn span{position:relative;z-index:2;text-align:center;line-height:1.25;width:100%;}\n@keyframes ggBtnShine{0%{left:-100%;}40%{left:140%;}100%{left:140%;}}\n</style>\n<button id=\"custom-releasit-btn\" type=\"button\"><span>{{ BTN_TEXT }}</span></button>\n<script>\n(function(){var b=document.getElementById(\"custom-releasit-btn\");if(!b)return;b.addEventListener(\"click\",function(){var r=document.querySelector(\"#_rsi-buy-now-button-overwrite, ._rsi-buy-now-button\");if(r)r.click();});})();\n</script>"
