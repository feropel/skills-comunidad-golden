{% comment %}
  === BLOQUE HORIZON NATIVO (starter Golden) — "Garantía / Compra segura" ===
  Cómo usarlo: en un tema Horizon, guarda este archivo como /blocks/_golden-trust.liquid.
  Aparecerá en el editor como bloque agregable dentro de secciones que acepten @theme.
  Es el equivalente nativo del componente custom_liquid `09-garantia.liquid`, pero como
  theme block de nueva generación: schema propio, textos por settings, {{ block.shopify_attributes }},
  hereda la Paleta (var(--brand-*)) y cumple los estándares (BEM prefijado, accesible, rápido).
  Ver references/horizon-bloques.md (arquitectura) y references/estandares-liquid.md (código sano).
{% endcomment %}
<div class="gt-trust" {{ block.shopify_attributes }}>
  <div class="gt-trust__seal" aria-hidden="true">{{ block.settings.emoji }}</div>
  <div class="gt-trust__body">
    <p class="gt-trust__title">{{ block.settings.title }}</p>
    <p class="gt-trust__text">{{ block.settings.text }}</p>
  </div>
</div>
<style>
  .gt-trust{max-width:480px;margin:14px auto;display:flex;align-items:center;gap:12px;box-sizing:border-box;
    background:var(--brand-light,#fef4e4);border:1px solid rgba(var(--brand-primary-rgb),.30);border-radius:16px;
    padding:14px 16px;box-shadow:0 8px 28px rgba(var(--brand-primary-rgb),.10);}
  .gt-trust__seal{flex:0 0 44px;width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;
    font-size:22px;background:linear-gradient(135deg,var(--brand-primary,#f7a540),var(--brand-dark,#c97a12));
    box-shadow:0 4px 12px rgba(var(--brand-primary-rgb),.40);}
  .gt-trust__title{font-size:14px;font-weight:800;color:#1a1a1a;margin:0 0 2px;text-transform:uppercase;letter-spacing:.3px;}
  .gt-trust__text{font-size:13px;color:#444;line-height:1.4;margin:0;}
</style>
{% schema %}
{
  "name": "t:names.golden_trust",
  "settings": [
    { "type": "text", "id": "emoji", "label": "t:settings.emoji", "default": "🛡️" },
    { "type": "text", "id": "title", "label": "t:settings.title", "default": "Compra 100% Segura" },
    { "type": "textarea", "id": "text", "label": "t:settings.text", "default": "Elige cómo pagar: contra entrega al recibir o pago anticipado seguro online. Producto sellado y original." }
  ],
  "presets": [ { "name": "t:names.golden_trust" } ]
}
{% endschema %}
